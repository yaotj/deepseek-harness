{
  "id": "if8a-04-requestExcessFare",
  "name": "IF8A-04 请求自助补站",
  "protocol": "HTTP",
  "method": "POST",
  "path": "/ci/app/requestExcessFare",
  "status": "design",
  "description": "IF8A-04 请求自助补站。包含补进站、补出站、前置校验及反向用例。",
  "request": {
    "method": "POST",
    "path": "/ci/app/requestExcessFare",
    "body": {
      "mode": "form",
      "form": [
        {
          "key": "providerId",
          "value": "01",
          "type": "text",
          "enabled": true
        },
        {
          "key": "charset",
          "value": "UTF-8",
          "type": "text",
          "enabled": true
        },
        {
          "key": "format",
          "value": "json",
          "type": "text",
          "enabled": true
        },
        {
          "key": "timestamp",
          "value": "20260626120000",
          "type": "text",
          "enabled": true
        },
        {
          "key": "deviceId",
          "value": "APP",
          "type": "text",
          "enabled": true
        },
        {
          "key": "signType",
          "value": "00",
          "type": "text",
          "enabled": true
        },
        {
          "key": "sign",
          "value": "",
          "type": "text",
          "enabled": true
        },
        {
          "key": "bizData",
          "value": "{\"thirdUserId\":\"1001\",\"cardId\":\"9900000000000001\",\"cardType\":\"0441\",\"upgradeAreaType\":\"01\",\"upgradeStationCode\":\"0101\",\"upgradeDateTime\":\"20260626120000\"}",
          "type": "text",
          "enabled": true
        }
      ]
    }
  },
  "response": [
    {
      "id": "res-entrySuccess",
      "name": "补进站成功",
      "code": 200,
      "body": {
        "retCode": "0000",
        "retMsg": "成功"
      }
    },
    {
      "id": "res-exitSuccess",
      "name": "补出站成功",
      "code": 200,
      "body": {
        "retCode": "0000",
        "retMsg": "成功"
      }
    },
    {
      "id": "res-completedOnlyEntry",
      "name": "已完成交易，只能补进站",
      "code": 200,
      "body": {
        "retCode": "8001",
        "retMsg": "当前已完成交易，只能补进站"
      }
    },
    {
      "id": "res-inEntryOnlyExit",
      "name": "已进站，只能补出站",
      "code": 200,
      "body": {
        "retCode": "8001",
        "retMsg": "当前已进站，只能补出站"
      }
    },
    {
      "id": "res-exitWithoutEntry",
      "name": "补出站但无进站记录",
      "code": 200,
      "body": {
        "retCode": "8304",
        "retMsg": "没有进站记录，无法补出站"
      }
    },
    {
      "id": "res-invalidParam",
      "name": "必填参数缺失",
      "code": 400,
      "body": {
        "retCode": "8001",
        "retMsg": "cardId/upgradeAreaType/upgradeStationCode不能为空"
      }
    },
    {
      "id": "res-systemError",
