<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinasofti.huateng.collectpay.mapper.TvmOrderPreMapper">
    <resultMap id="BaseResultMap" type="com.chinasofti.huateng.collectpay.entity.TvmPayPreOrder">
        <result column="ORDER_NO" jdbcType="VARCHAR" property="orderNo"/>
        <result column="TRANS_TYPE" jdbcType="VARCHAR" property="transType"/>
        <result column="TRANS_AMOUNT" jdbcType="VARCHAR" property="transAmount"/>
        <result column="DEVICE_ID" jdbcType="VARCHAR" property="deviceId"/>
        <result column="CREATE_TIME" jdbcType="VARCHAR" property="createTime"/>
        <result column="UPDATE_TIME" jdbcType="VARCHAR" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        ORDER_NO,TRANS_TYPE,TRANS_AMOUNT,DEVICE_ID,CREATE_TIME,UPDATE_TIME
    </sql>

    <select id="selectByOrderNo" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from TBL_TVM_ORDER_PAY_PRE
        where ORDER_NO = #{orderNo,jdbcType=VARCHAR}
    </select>

    <insert id="insert" parameterType="java.util.Map">
        insert into TBL_TVM_ORDER_PAY_PRE (ORDER_NO,TRANS_TYPE,TRANS_AMOUNT,DEVICE_ID,CREATE_TIME
        ) values (
            #{orderNo,jdbcType=VARCHAR},
            #{transType,jdbcType=VARCHAR},
            #{transAmount,jdbcType=VARCHAR},
            #{deviceId,jdbcType=VARCHAR},
            #{createTime,jdbcType=VARCHAR}
        )
    </insert>

</mapper>
