package com.chinasofti.huateng.fep.app.controller;

import com.chinasofti.huateng.common.response.CommonResult;
import com.chinasofti.huateng.fep.app.service.TicketAppService;
import com.chinasofti.huateng.model.app.ReceiveBlackListFromItpReqDTO;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

/**
 * IF8B-03 接收黑名单结果通知接口。
 *
 * <p>该接口接收 ITP 推送的黑名单处理结果，入口层只负责记录和转发，
 * 具体的票务领域处理由 {@link TicketAppService} 承担。</p>
 */
@RestController
@RequestMapping("/app")
public class AppNotifyController {

    private static final Logger log = LoggerFactory.getLogger(AppNotifyController.class);

    private final TicketAppService ticketAppService;

    public AppNotifyController(TicketAppService ticketAppService) {
        this.ticketAppService = ticketAppService;
    }

    /**
     * 黑名单状态变更通知。
     *
     * @param request ITP 推送的黑名单结果通知参数
     * @return 通用接收确认响应
     */
    @PostMapping("/receiveBlackListFromItp")
    public CommonResult receiveBlackListFromItp(@RequestBody ReceiveBlackListFromItpReqDTO request) {
        log.info("IF8B-03 接收黑名单结果通知, request={}", request);
        return ticketAppService.receiveBlackListFromItp(request);
    }
}
