server.port=9110
spring.application.name=fep-acc-server
other.web.unSafeUrlChars=null
other.web.enableLogRequestInFilter=true
other.web.enableBodyCacheFilter=true
other.web.enableLogTakeTimesInInterceptor=true
knife4j.production=false

# account-server RPC 地址
service.account.url=http://127.0.0.1:9098
service.account.openLogger=true
