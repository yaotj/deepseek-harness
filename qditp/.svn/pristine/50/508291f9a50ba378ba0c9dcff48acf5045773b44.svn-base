-- ============================================
-- online-server 表结构 (Oracle)
-- ============================================

-- 互联网业务订单主表
CREATE TABLE ONLINE_ORDER (
    ORDER_NO VARCHAR2(64) NOT NULL,
    ORDER_TYPE VARCHAR2(32) NOT NULL,
    DEVICE_ID VARCHAR2(32),
    ENTRY_STATION_CODE VARCHAR2(16),
    EXIT_STATION_CODE VARCHAR2(16),
    TICKET_PRICE INT,
    TICKET_NUM INT,
    SINGLE_TICKET_TYPE VARCHAR2(8),
    TRANS_TYPE VARCHAR2(8),
    ADMIN_TRANS_TYPE VARCHAR2(8),
    OPERATOR_ID VARCHAR2(32),
    SHIFT_ID VARCHAR2(32),
    BOM_OPT_SEQ VARCHAR2(64),
    CARD_ID VARCHAR2(64),
    TICKET_LOGIC_NUM VARCHAR2(64),
    TICKET_PHYSICS_NUM VARCHAR2(64),
    BEFORE_AMOUNT INT,
    TRANS_AMOUNT INT,
    AFTER_AMOUNT INT,
    PAY_CHANNEL_CODE VARCHAR2(16),
    PAYMENT_VENDOR VARCHAR2(128),
    PAY_RESULT VARCHAR2(16),
    PAY_RESULT_DESC VARCHAR2(256),
    ORDER_STATUS VARCHAR2(32),
    ORDER_STATUS_DESC VARCHAR2(256),
    QRCODE_GEN_DATE DATE,
    RANDOM_FACT VARCHAR2(64),
    ACTUAL_TAKE_TICKET_NUM INT,
    TAKE_TICKET_DATE DATE,
    TOPUP_STATUS VARCHAR2(8),
    BUSINESS_RESULT VARCHAR2(16),
    BUSINESS_RESULT_DESC VARCHAR2(256),
    FAULT_OCCUR_DATE DATE,
    FAULT_SLIP_SEQ VARCHAR2(64),
    ERROR_CODE VARCHAR2(32),
    ERROR_MESSAGE VARCHAR2(256),
    CREATE_TMS DATE NOT NULL,
    UPDATE_TMS DATE NOT NULL,
    CONSTRAINT PK_ONLINE_ORDER PRIMARY KEY (ORDER_NO)
);

-- 互联网业务订单票卡明细表
CREATE TABLE ONLINE_ORDER_TICKET (
    ID NUMBER(18) NOT NULL,
    ORDER_NO VARCHAR2(64) NOT NULL,
    TICKET_LOGIC_NUM VARCHAR2(64),
    TICKET_PHYSICS_NUM VARCHAR2(64),
    TRANS_DATE DATE,
    TRANS_AMOUNT INT,
    CREATE_TMS DATE NOT NULL,
    CONSTRAINT PK_ONLINE_ORDER_TICKET PRIMARY KEY (ID)
);

-- 创建序列
CREATE SEQUENCE SEQ_ONLINE_ORDER_TICKET_ID
    START WITH 1
    INCREMENT BY 1
    NOCACHE
    NOCYCLE;

-- 创建触发器实现自增
CREATE OR REPLACE TRIGGER TRG_ONLINE_ORDER_TICKET_ID
    BEFORE INSERT ON ONLINE_ORDER_TICKET
    FOR EACH ROW
BEGIN
    IF :NEW.ID IS NULL THEN
        SELECT SEQ_ONLINE_ORDER_TICKET_ID.NEXTVAL INTO :NEW.ID FROM DUAL;
    END IF;
END;
/

-- 二维码票卡状态表
CREATE TABLE QR_CODE_STATUS (
    CARD_ID VARCHAR2(64) NOT NULL,
    ITP_USER_ID VARCHAR2(32) NOT NULL,
    ITP_USER_ID_SUFFIX VARCHAR2(2),
    PROVIDER_ID VARCHAR2(16),
    MSISDN VARCHAR2(32),
    CARD_TYPE VARCHAR2(16),
    CARD_STATUS VARCHAR2(16),
    ISSUE_CHANNEL_CODE VARCHAR2(16),
    SIGN_CHANNEL_CODE VARCHAR2(16),
    LAST_LINE_CODE VARCHAR2(16),
    LAST_STATION_CODE VARCHAR2(16),
    LAST_HANDLE_DATE_TIME DATE,
    LAST_TRANS_AMOUNT INT,
    LAST_TICKET_TRANS_SEQ VARCHAR2(32),
    INDUSTRY_DATA VARCHAR2(512),
    HCE_DATA VARCHAR2(1024),
    QUERY_LOCKED_YN VARCHAR2(1),
    LAST_DEVICE_ID VARCHAR2(32),
    CREATE_TMS DATE NOT NULL,
    UPDATE_TMS DATE NOT NULL,
    CONSTRAINT PK_QR_CODE_STATUS PRIMARY KEY (CARD_ID, ITP_USER_ID, ITP_USER_ID_SUFFIX)
);

-- 互联网业务设备心跳表
CREATE TABLE ONLINE_DEVICE_HEARTBEAT (
    PROVIDER_ID VARCHAR2(16) NOT NULL,
    DEVICE_ID VARCHAR2(32) NOT NULL,
    LAST_HEARTBEAT_TMS DATE NOT NULL,
    STATUS VARCHAR2(16),
    UPDATE_TMS DATE NOT NULL,
    CONSTRAINT PK_ONLINE_DEVICE_HEARTBEAT PRIMARY KEY (PROVIDER_ID, DEVICE_ID)
);

-- ============================================
-- 索引
-- ============================================

CREATE INDEX IDX_ONLINE_ORDER_CARD ON ONLINE_ORDER (CARD_ID);
CREATE INDEX IDX_ONLINE_ORDER_DEVICE ON ONLINE_ORDER (DEVICE_ID);
CREATE INDEX IDX_ONLINE_ORDER_TICKET_ORDER ON ONLINE_ORDER_TICKET (ORDER_NO);
CREATE INDEX IDX_QR_CODE_STATUS_ITP_USER_ID ON QR_CODE_STATUS (ITP_USER_ID, ITP_USER_ID_SUFFIX);

-- ============================================
-- 表注释
-- ============================================

COMMENT ON TABLE ONLINE_ORDER IS '互联网业务订单主表';
COMMENT ON TABLE ONLINE_ORDER_TICKET IS '互联网业务订单票卡明细表';
COMMENT ON TABLE QR_CODE_STATUS IS '二维码票卡状态表';
COMMENT ON TABLE ONLINE_DEVICE_HEARTBEAT IS '互联网业务设备心跳表';
