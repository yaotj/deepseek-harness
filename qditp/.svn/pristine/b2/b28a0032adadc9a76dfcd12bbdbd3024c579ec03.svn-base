package com.chinasofti.huateng.model.para;

import java.io.Serializable;
import java.util.List;

public class StlParaSynDTO implements Serializable {
    private String lineCode;

    private String stationCode;

    private String devType;

    private String devNode;

    private List<String> paraType;

    private String optType;

    public String getLineCode() {
        return lineCode;
    }

    public void setLineCode(String lineCode) {
        this.lineCode = lineCode;
    }

    public String getStationCode() {
        return stationCode;
    }

    public void setStationCode(String stationCode) {
        this.stationCode = stationCode;
    }

    public String getDevType() {
        return devType;
    }

    public void setDevType(String devType) {
        this.devType = devType;
    }

    public String getDevNode() {
        return devNode;
    }

    public void setDevNode(String devNode) {
        this.devNode = devNode;
    }

    public List<String> getParaType() {
        return paraType;
    }

    public void setParaType(List<String> paraType) {
        this.paraType = paraType;
    }

    public String getOptType() {
        return optType;
    }

    public void setOptType(String optType) {
        this.optType = optType;
    }
}
