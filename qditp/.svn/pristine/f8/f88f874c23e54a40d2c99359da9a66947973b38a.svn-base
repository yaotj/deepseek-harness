package com.chinasofti.huateng.model.para;

import java.io.Serializable;

public class StlStationInfoDO implements Serializable {
    private Integer paraVerNo;
    private String stationCode;
    private String ownerLineId;
    private String ownerIncomeId;
    private String stationType;
    private String stationNm;
    private String stationENm;

    public Integer getParaVerNo() {
        return paraVerNo;
    }

    public void setParaVerNo(Integer paraVerNo) {
        this.paraVerNo = paraVerNo;
    }

    public String getStationCode() {
        return stationCode;
    }

    public void setStationCode(String stationCode) {
        this.stationCode = stationCode;
    }

    public String getOwnerLineId() {
        return ownerLineId;
    }

    public void setOwnerLineId(String ownerLineId) {
        this.ownerLineId = ownerLineId;
    }

    public String getOwnerIncomeId() {
        return ownerIncomeId;
    }

    public void setOwnerIncomeId(String ownerIncomeId) {
        this.ownerIncomeId = ownerIncomeId;
    }

    public String getStationType() {
        return stationType;
    }

    public void setStationType(String stationType) {
        this.stationType = stationType;
    }

    public String getStationNm() {
        return stationNm;
    }

    public void setStationNm(String stationNm) {
        this.stationNm = stationNm;
    }

    public String getStationENm() {
        return stationENm;
    }

    public void setStationENm(String stationENm) {
        this.stationENm = stationENm;
    }
}