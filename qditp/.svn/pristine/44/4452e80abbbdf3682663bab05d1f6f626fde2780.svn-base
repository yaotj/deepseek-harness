package com.chinasofti.huateng.model.app.dailyticket;

/**
 * IF8A-64 日票退款响应参数。
 */
public class DailyTicketRefundResult extends DailyTicketBaseResult {
    /**
     * 退款类型，00表示直接退款，01表示激活后核验退款。
     */
    private String refundType;

    /**
     * 退款订单号或原日票订单号。
     */
    private String orderNo;

    /**
     * 退款结果描述。
     */
    private String refundResultDesc;

    /**
     * 退款结果，SUCCESS表示成功。
     */
    private String refundResult;

    /**
     * 退款时间。
     */
    private String refundDate;

    /**
     * 退款金额，单位分。
     */
    private String refundAmount;

    public String getRefundType() {
        return refundType;
    }

    public void setRefundType(String refundType) {
        this.refundType = refundType;
    }

    public String getOrderNo() {
        return orderNo;
    }

    public void setOrderNo(String orderNo) {
        this.orderNo = orderNo;
    }

    public String getRefundResultDesc() {
        return refundResultDesc;
    }

    public void setRefundResultDesc(String refundResultDesc) {
        this.refundResultDesc = refundResultDesc;
    }

    public String getRefundResult() {
        return refundResult;
    }

    public void setRefundResult(String refundResult) {
        this.refundResult = refundResult;
    }

    public String getRefundDate() {
        return refundDate;
    }

    public void setRefundDate(String refundDate) {
        this.refundDate = refundDate;
    }

    public String getRefundAmount() {
        return refundAmount;
    }

    public void setRefundAmount(String refundAmount) {
        this.refundAmount = refundAmount;
    }
}
