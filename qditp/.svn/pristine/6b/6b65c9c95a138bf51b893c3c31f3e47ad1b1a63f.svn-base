<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinasofti.huateng.collectpay.mapper.TvmTakeTicketOrderMapper">
    <resultMap id="BaseResultMap" type="com.chinasofti.huateng.collectpay.entity.TvmTakeTicketOrder">
        <id column="ID" jdbcType="BIGINT" property="id"/>
        <result column="ORDER_NO" jdbcType="VARCHAR" property="orderNo"/>
        <result column="DEVICE_ID" jdbcType="VARCHAR" property="deviceId"/>
        <result column="QRCODE_GEN_DATE" jdbcType="VARCHAR" property="qrcodeGenDate"/>
        <result column="RANDOM_FACT" jdbcType="VARCHAR" property="randomFact"/>
        <result column="ACTIVE_STATUS" jdbcType="INTEGER" property="activeStatus"/>
        <result column="ACTIVE_TIME" jdbcType="VARCHAR" property="activeTime"/>
        <result column="CREATE_TIME" jdbcType="VARCHAR" property="createTime"/>
        <result column="UPDATE_TIME" jdbcType="VARCHAR" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        ID, ORDER_NO, DEVICE_ID, QRCODE_GEN_DATE, RANDOM_FACT,
        ACTIVE_STATUS, ACTIVE_TIME, CREATE_TIME, UPDATE_TIME
    </sql>

    <select id="selectByOrderNoAndDevice" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from TBL_TVM_TAKE_TICKET_ORDER
        where ORDER_NO = #{orderNo,jdbcType=VARCHAR}
          and DEVICE_ID = #{deviceId,jdbcType=VARCHAR}
    </select>

    <select id="selectByDeviceAndQrcode" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from TBL_TVM_TAKE_TICKET_ORDER
        where DEVICE_ID = #{deviceId,jdbcType=VARCHAR}
          and QRCODE_GEN_DATE = #{qrcodeGenDate,jdbcType=VARCHAR}
          and RANDOM_FACT = #{randomFact,jdbcType=VARCHAR}
    </select>

    <insert id="insert" parameterType="com.chinasofti.huateng.collectpay.entity.TvmTakeTicketOrder">
        insert into TBL_TVM_TAKE_TICKET_ORDER (
            ORDER_NO, DEVICE_ID, QRCODE_GEN_DATE, RANDOM_FACT,
            ACTIVE_STATUS, ACTIVE_TIME, CREATE_TIME, UPDATE_TIME
        ) values (
            #{orderNo,jdbcType=VARCHAR},
            #{deviceId,jdbcType=VARCHAR},
            #{qrcodeGenDate,jdbcType=VARCHAR},
            #{randomFact,jdbcType=VARCHAR},
            #{activeStatus,jdbcType=INTEGER},
            #{activeTime,jdbcType=VARCHAR},
            #{createTime,jdbcType=VARCHAR},
            #{updateTime,jdbcType=VARCHAR}
        )
    </insert>

    <update id="updateActiveStatusByOrderNoAndDevice" parameterType="java.util.Map">
        update TBL_TVM_TAKE_TICKET_ORDER
        set ACTIVE_STATUS = #{activeStatus,jdbcType=INTEGER},
            ACTIVE_TIME = #{activeTime,jdbcType=VARCHAR},
            UPDATE_TIME = #{updateTime,jdbcType=VARCHAR}
        where ORDER_NO = #{orderNo,jdbcType=VARCHAR}
          and DEVICE_ID = #{deviceId,jdbcType=VARCHAR}
    </update>
</mapper>
