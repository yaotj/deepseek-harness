<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinasofti.huateng.para.mapper.network.SectInfoMapper">
    <delete id="deleteByParaVerNo">
        DELETE FROM TBL_SECT_INFO WHERE PARA_VER_NO = #{paraVerNo,jdbcType=NUMERIC}
    </delete>

    <insert id="insertBatch">
        INSERT ALL
        <foreach collection="list" item="item">
            INTO TBL_SECT_INFO (PARA_VER_NO, SECT_NO, SECT_NAME, SECT_E_NAME, STAT_CODE1, STAT_CODE2)
            VALUES (#{item.paraVerNo,jdbcType=NUMERIC}, #{item.sectNo,jdbcType=NUMERIC},
                    #{item.sectName,jdbcType=VARCHAR}, #{item.sectEName,jdbcType=VARCHAR},
                    #{item.statCode1,jdbcType=VARCHAR}, #{item.statCode2,jdbcType=VARCHAR})
        </foreach>
        SELECT 1 FROM DUAL
    </insert>
</mapper>
