package com.chinasofti.huateng.model.frs.vo;

public class OdPathVO {
    private String begStatCode;
    private String endStatCode;
    private Integer pathIdx;
    private String passList;
    private String percent;

    public String getBegStatCode() {
        return begStatCode;
    }

    public void setBegStatCode(String begStatCode) {
        this.begStatCode = begStatCode;
    }

    public String getEndStatCode() {
        return endStatCode;
    }

    public void setEndStatCode(String endStatCode) {
        this.endStatCode = endStatCode;
    }

    public Integer getPathIdx() {
        return pathIdx;
    }

    public void setPathIdx(Integer pathIdx) {
        this.pathIdx = pathIdx;
    }

    public String getPassList() {
        return passList;
    }

    public void setPassList(String passList) {
        this.passList = passList;
    }

    public String getPercent() {
        return percent;
    }

    public void setPercent(String percent) {
        this.percent = percent;
    }

    @Override
    public String toString() {
        return "OdPathVO{" +
                "begStatCode='" + begStatCode + '\'' +
                ", endStatCode='" + endStatCode + '\'' +
                ", pathIdx=" + pathIdx +
                ", passList='" + passList + '\'' +
                ", percent='" + percent + '\'' +
                '}';
    }
}
