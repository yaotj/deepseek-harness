<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinasofti.huateng.collectpay.mapper.TvmOrderMapper">
    <resultMap id="BaseResultMap" type="com.chinasofti.huateng.collectpay.entity.TvmPayOrder">
        <id column="ORDER_NO" jdbcType="VARCHAR" property="orderNo"/>
        <result column="IN_STATION_CODE" jdbcType="VARCHAR" property="inStationCode"/>
        <result column="OUT_STATION_CODE" jdbcType="VARCHAR" property="outStationCode"/>
        <result column="TICKET_PRICE" jdbcType="VARCHAR" property="ticketPrice"/>
        <result column="TICKET_NUM" jdbcType="INTEGER" property="ticketNum"/>
        <result column="TICKET_TYPE" jdbcType="VARCHAR" property="ticketType"/>
        <result column="STATUS" jdbcType="VARCHAR" property="status"/>
        <result column="MSG" jdbcType="VARCHAR" property="msg"/>
        <result column="PAY_TYPE" jdbcType="VARCHAR" property="payType"/>
        <result column="CHANNEL" jdbcType="VARCHAR" property="channel"/>
        <result column="PAYCENTER_ORDERNO" jdbcType="VARCHAR" property="payCenterOrderNo"/>
        <result column="PAYCENTER_CHANNELORDERNO" jdbcType="VARCHAR" property="payCenterChannelOrderNo"/>
        <result column="URL" jdbcType="VARCHAR" property="url"/>
        <result column="CREATE_TIME" jdbcType="VARCHAR" property="createTime"/>
        <result column="UPDATE_TIME" jdbcType="VARCHAR" property="updateTime"/>
        <result column="DEVICE_ID" jdbcType="VARCHAR" property="deviceId"/>
        <result column="RSV1" jdbcType="VARCHAR" property="rsv1"/>
        <result column="RSV2" jdbcType="VARCHAR" property="rsv2"/>
        <result column="TOTAL_PRICE" jdbcType="VARCHAR" property="totalPrice"/>
    </resultMap>

    <sql id="Base_Column_List">
        ORDER_NO, IN_STATION_CODE, OUT_STATION_CODE, TICKET_PRICE, TICKET_NUM,
        TICKET_TYPE, STATUS, MSG,PAY_TYPE,CHANNEL,PAYCENTER_ORDERNO,PAYCENTER_CHANNELORDERNO, URL, CREATE_TIME,
        UPDATE_TIME, DEVICE_ID, RSV1, RSV2, TOTAL_PRICE
    </sql>

    <select id="selectByOrderNo" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from TBL_TVM_ORDER_PAY
        where ORDER_NO = #{orderNo,jdbcType=VARCHAR}
    </select>

    <select id="selectByPayCenterOrderNo" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from TBL_TVM_ORDER_PAY
        where PAYCENTER_ORDERNO = #{payCenterOrderNo,jdbcType=VARCHAR}
    </select>

    <resultMap id="FacePayOrderPageResultMap" type="com.chinasofti.huateng.collectpay.model.page.FacePayOrderPageView">
        <id column="ORDER_NO" property="orderNo"/>
        <result column="PAYCENTER_ORDERNO" property="payCenterOrderNo"/>
        <result column="PAYCENTER_CHANNELORDERNO" property="payCenterChannelOrderNo"/>
        <result column="STATUS" property="status"/>
        <result column="MSG" property="msg"/>
        <result column="CHANNEL" property="channel"/>
        <result column="PAY_TYPE" property="payType"/>
        <result column="IN_STATION_CODE" property="inStationCode"/>
        <result column="OUT_STATION_CODE" property="outStationCode"/>
        <result column="TICKET_PRICE" property="ticketPrice"/>
        <result column="TICKET_NUM" property="ticketNum"/>
        <result column="TOTAL_PRICE" property="totalPrice"/>
        <result column="TICKET_TYPE" property="ticketType"/>
        <result column="DEVICE_ID" property="deviceId"/>
        <result column="RSV2" property="refundNo"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_TIME" property="updateTime"/>
    </resultMap>

    <sql id="FacePayOrderWhere">
        WHERE 1 = 1
        <if test="orderNo != null and orderNo != ''">
            AND ORDER_NO = #{orderNo,jdbcType=VARCHAR}
        </if>
        <if test="payCenterOrderNo != null and payCenterOrderNo != ''">
            AND PAYCENTER_ORDERNO = #{payCenterOrderNo,jdbcType=VARCHAR}
        </if>
        <if test="payCenterChannelOrderNo != null and payCenterChannelOrderNo != ''">
            AND PAYCENTER_CHANNELORDERNO = #{payCenterChannelOrderNo,jdbcType=VARCHAR}
        </if>
        <if test="deviceId != null and deviceId != ''">
            AND DEVICE_ID = #{deviceId,jdbcType=VARCHAR}
        </if>
        <if test="channel != null and channel != ''">
            AND CHANNEL = #{channel,jdbcType=VARCHAR}
        </if>
        <if test="status != null and status != ''">
            AND STATUS = #{status,jdbcType=VARCHAR}
        </if>
        <if test="ticketType != null and ticketType != ''">
            AND TICKET_TYPE = #{ticketType,jdbcType=VARCHAR}
        </if>
        <if test="beginTime != null and beginTime != ''">
            AND CREATE_TIME &gt;= #{beginTime,jdbcType=VARCHAR}
        </if>
        <if test="endTime != null and endTime != ''">
            AND CREATE_TIME &lt;= #{endTime,jdbcType=VARCHAR}
        </if>
    </sql>

    <select id="selectFacePayOrderPage" resultMap="FacePayOrderPageResultMap">
        <bind name="offsetEnd" value="offset + limit" />
        SELECT *
        FROM (
            SELECT
                ORDER_NO, PAYCENTER_ORDERNO, PAYCENTER_CHANNELORDERNO, STATUS, MSG, CHANNEL, PAY_TYPE,
                IN_STATION_CODE, OUT_STATION_CODE, TICKET_PRICE, TICKET_NUM, TOTAL_PRICE, TICKET_TYPE,
                DEVICE_ID, RSV2, CREATE_TIME, UPDATE_TIME,
                ROW_NUMBER() OVER (ORDER BY CREATE_TIME DESC, ORDER_NO DESC) AS rn
            FROM TBL_TVM_ORDER_PAY
            <include refid="FacePayOrderWhere"/>
        )
        WHERE rn &gt; #{offset} AND rn &lt;= #{offsetEnd}
    </select>

    <select id="countFacePayOrderPage" resultType="java.lang.Integer">
        SELECT COUNT(1)
        FROM TBL_TVM_ORDER_PAY
        <include refid="FacePayOrderWhere"/>
    </select>

    <insert id="insert" parameterType="com.chinasofti.huateng.collectpay.entity.TvmPayOrder">
        insert into TBL_TVM_ORDER_PAY (
            ORDER_NO, IN_STATION_CODE, OUT_STATION_CODE, TICKET_PRICE, TICKET_NUM,
            TICKET_TYPE, STATUS, MSG,PAY_TYPE,CHANNEL, URL, CREATE_TIME,
            UPDATE_TIME, DEVICE_ID, RSV1, RSV2, TOTAL_PRICE
        ) values (
            #{orderNo,jdbcType=VARCHAR},
            #{inStationCode,jdbcType=VARCHAR},
            #{outStationCode,jdbcType=VARCHAR},
            #{ticketPrice,jdbcType=VARCHAR},
            #{ticketNum,jdbcType=INTEGER},
            #{ticketType,jdbcType=VARCHAR},
            #{status,jdbcType=VARCHAR},
            #{msg,jdbcType=VARCHAR},
            #{payType,jdbcType=VARCHAR},
            #{channel,jdbcType=VARCHAR},
            #{url,jdbcType=VARCHAR},
            #{createTime,jdbcType=VARCHAR},
            #{updateTime,jdbcType=VARCHAR},
            #{deviceId,jdbcType=VARCHAR},
            #{rsv1,jdbcType=VARCHAR},
            #{rsv2,jdbcType=VARCHAR},
            #{totalPrice,jdbcType=VARCHAR}
        )
    </insert>

    <update id="updateByOrderNo" parameterType="java.util.Map">
        update TBL_TVM_ORDER_PAY
        <set>
            <if test="status != null">STATUS = #{status,jdbcType=VARCHAR},</if>
            <if test="msg != null">MSG = #{msg,jdbcType=VARCHAR},</if>
            <if test="channel != null">CHANNEL = #{channel,jdbcType=VARCHAR},</if>
            <if test="payCenterOrderNo != null">PAYCENTER_ORDERNO = #{payCenterOrderNo,jdbcType=VARCHAR},</if>
            <if test="payCenterChannelOrderNo != null">PAYCENTER_channelOrderNo = #{payCenterChannelOrderNo,jdbcType=VARCHAR},</if>
            <if test="url != null">URL = #{url,jdbcType=VARCHAR},</if>
            <if test="updateTime != null">UPDATE_TIME = #{updateTime,jdbcType=VARCHAR},</if>
            <if test="rsv1 != null">RSV1 = #{rsv1,jdbcType=VARCHAR},</if>
            <if test="rsv2 != null">RSV2 = #{rsv2,jdbcType=VARCHAR},</if>
        </set>
        where ORDER_NO = #{orderNo,jdbcType=VARCHAR}
    </update>
</mapper>
