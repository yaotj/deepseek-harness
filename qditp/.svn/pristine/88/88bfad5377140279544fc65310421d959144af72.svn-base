    @Override
    public AlipayTripReceiveCardDataRespDTO receiveCardDataFromItp(AlipayTripReceiveCardDataReqDTO request) {
        log.info("支付宝出行-行业数据推送,请求参数：{}", JSON.toJSONString(request));
        AlipayTripReceiveCardDataRespDTO response = new AlipayTripReceiveCardDataRespDTO();
        try {
            RequestBody requestBody = new MultipartBody.Builder()
                    .setType(MultipartBody.FORM)
                    .addFormDataPart("bizData", JSON.toJSONString(request))
                    .build();

            Request httpRequest = new Request.Builder()
                    .url(alipayCardDataUrl)
                    .post(requestBody)
                    .build();

            try (Response httpResponse = okHttpClient.newCall(httpRequest).execute()) {
                String responseBody = httpResponse.body() != null ? httpResponse.body().string() : null;
                log.info("支付宝出行-行业数据推送,支付宝返回：code={}, body={}",
                        httpResponse.code(), responseBody);

                if (!httpResponse.isSuccessful()) {
                    log.error("支付宝出行-行业数据推送失败, url={}, code={}",
                            alipayCardDataUrl, httpResponse.code());
                    response.setRetCode(FepAppErrorCodeEnum.FAIL.getCode());
                    response.setRetMsg("调用支付宝接口失败，HTTP状态码：" + httpResponse.code());
                    return response;
                }

                if (responseBody != null && !responseBody.isEmpty()) {
                    AlipayTripReceiveCardDataRespDTO alipayResponse = JSON.parseObject(responseBody, AlipayTripReceiveCardDataRespDTO.class);
                    if (alipayResponse != null) {
                        response.setRetCode(alipayResponse.getRetCode());
                        response.setRetMsg(alipayResponse.getRetMsg());
                    } else {
                        response.setRetCode(FepAppErrorCodeEnum.SUCCESS.getCode());
                        response.setRetMsg(FepAppErrorCodeEnum.SUCCESS.getMsg());
                    }
                } else {
                    response.setRetCode(FepAppErrorCodeEnum.SUCCESS.getCode());
                    response.setRetMsg(FepAppErrorCodeEnum.SUCCESS.getMsg());
                }
            }
        } catch (Exception e) {
            log.error("支付宝出行-行业数据推送 异常", e);
            response.setRetCode(FepAppErrorCodeEnum.FAIL.getCode());
            response.setRetMsg("推送失败：" + e.getMessage());
        }
        log.info("支付宝出行-行业数据推送,响应结果：{}", JSON.toJSONString(response));
        return response;
    }

    @Override
    public AlipayTripReceiveBlackListRespDTO receiveBlackListFromItp(AlipayTripReceiveBlackListReqDTO request) {
        log.info("支付宝出行-黑名单状态变更通知,请求参数：{}", JSON.toJSONString(request));
        AlipayTripReceiveBlackListRespDTO response = new AlipayTripReceiveBlackListRespDTO();
        try {
            RequestBody requestBody = new MultipartBody.Builder()
                    .setType(MultipartBody.FORM)
                    .addFormDataPart("bizData", JSON.toJSONString(request))
                    .build();

            Request httpRequest = new Request.Builder()
                    .url(alipayBlacklistUrl)
                    .post(requestBody)
                    .build();

            try (Response httpResponse = okHttpClient.newCall(httpRequest).execute()) {
                String responseBody = httpResponse.body() != null ? httpResponse.body().string() : null;
                log.info("支付宝出行-黑名单状态变更通知,支付宝返回：code={}, body={}",
                        httpResponse.code(), responseBody);

                if (!httpResponse.isSuccessful()) {
                    log.error("支付宝出行-黑名单状态变更通知失败, url={}, code={}",
                            alipayBlacklistUrl, httpResponse.code());
                    response.setRetCode(FepAppErrorCodeEnum.FAIL.getCode());
                    response.setRetMsg("调用支付宝接口失败，HTTP状态码：" + httpResponse.code());
                    return response;
                }

                if (responseBody != null && !responseBody.isEmpty()) {
                    AlipayTripReceiveBlackListRespDTO alipayResponse = JSON.parseObject(responseBody, AlipayTripReceiveBlackListRespDTO.class);
                    if (alipayResponse != null) {
                        response.setRetCode(alipayResponse.getRetCode());
                        response.setRetMsg(alipayResponse.getRetMsg());
                    } else {
                        response.setRetCode(FepAppErrorCodeEnum.SUCCESS.getCode());
                        response.setRetMsg(FepAppErrorCodeEnum.SUCCESS.getMsg());
                    }
                } else {
                    response.setRetCode(FepAppErrorCodeEnum.SUCCESS.getCode());
                    response.setRetMsg(FepAppErrorCodeEnum.SUCCESS.getMsg());
                }
            }
        } catch (Exception e) {
            log.error("支付宝出行-黑名单状态变更通知 异常", e);
            response.setRetCode(FepAppErrorCodeEnum.FAIL.getCode());
            response.setRetMsg("通知失败：" + e.getMessage());
        }
        log.info("支付宝出行-黑名单状态变更通知,响应结果：{}", JSON.toJSONString(response));
        return response;
    }
