    @Override
    public AlipayTripPushTransDataRespDTO pushTransData(AlipayTripPushTransDataReqDTO request) {
        log.info("支付宝出行-行程数据推送,请求参数：{}", JSON.toJSONString(request));
        AlipayTripPushTransDataRespDTO response = new AlipayTripPushTransDataRespDTO();
        try {
            // 构建 FormData 请求体（与 APP 通知格式一致）
            RequestBody requestBody = new MultipartBody.Builder()
                    .setType(MultipartBody.FORM)
                    .addFormDataPart("bizData", JSON.toJSONString(request))
                    .build();

            Request httpRequest = new Request.Builder()
                    .url(alipayPushTransDataUrl)
                    .post(requestBody)
                    .build();

            try (Response httpResponse = okHttpClient.newCall(httpRequest).execute()) {
                String responseBody = httpResponse.body() != null ? httpResponse.body().string() : null;
                log.info("支付宝出行-行程数据推送,支付宝返回：code={}, body={}", 
                        httpResponse.code(), responseBody);

                if (!httpResponse.isSuccessful()) {
                    log.error("支付宝出行-行程数据推送失败, url={}, code={}", 
                            alipayPushTransDataUrl, httpResponse.code());
                    response.setRetCode(FepAppErrorCodeEnum.FAIL.getCode());
                    response.setRetMsg("调用支付宝接口失败，HTTP状态码：" + httpResponse.code());
                    return response;
                }

                // 解析支付宝响应
                if (responseBody != null && !responseBody.isEmpty()) {
                    AlipayTripPushTransDataRespDTO alipayResponse = JSON.parseObject(responseBody, AlipayTripPushTransDataRespDTO.class);
                    if (alipayResponse != null) {
                        response.setRetCode(alipayResponse.getRetCode());
                        response.setRetMsg(alipayResponse.getRetMsg());
                    } else {
                        response.setRetCode(FepAppErrorCodeEnum.SUCCESS.getCode());
                        response.setRetMsg(FepAppErrorCodeEnum.SUCCESS.getMsg());
                    }
                } else {
                    response.setRetCode(FepAppErrorCodeEnum.SUCCESS.getCode());
                    response.setRetMsg(FepAppErrorCodeEnum.SUCCESS.getMsg());
                }
            }
        } catch (Exception e) {
            log.error("支付宝出行-行程数据推送 异常", e);
            response.setRetCode(FepAppErrorCodeEnum.FAIL.getCode());
            response.setRetMsg("推送失败：" + e.getMessage());
        }
        log.info("支付宝出行-行程数据推送,响应结果：{}", JSON.toJSONString(response));
        return response;
    }

