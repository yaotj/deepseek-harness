<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinasofti.huateng.para.mapper.ticket.SingleTicketPurchaseLimitMapper">
    <select id="selectCurrent" resultType="com.chinasofti.huateng.para.entity.ticket.SingleTicketPurchaseLimit">
        SELECT CONFIG_KEY configKey,
               MAX_PURCHASE_QUANTITY maxPurchaseQuantity,
               CREATE_TIME createTime,
               UPDATE_TIME updateTime,
               VERSION version
        FROM TBL_SINGLE_TICKET_PURCHASE_LIMIT
        WHERE CONFIG_KEY = 'SINGLE_TICKET'
    </select>

    <update id="update" parameterType="com.chinasofti.huateng.para.entity.ticket.SingleTicketPurchaseLimit">
        UPDATE TBL_SINGLE_TICKET_PURCHASE_LIMIT
        SET MAX_PURCHASE_QUANTITY = #{maxPurchaseQuantity,jdbcType=NUMERIC},
            UPDATE_TIME = SYSDATE,
            VERSION = VERSION + 1
        WHERE CONFIG_KEY = 'SINGLE_TICKET'
          AND VERSION = #{version,jdbcType=NUMERIC}
    </update>
</mapper>
