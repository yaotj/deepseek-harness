package com.chinasofti.huateng.model.acc;

import java.util.ArrayList;
import java.util.List;

public class SyncTaskResponse1 {

    /**
     * desc:任务目标节点
     **/
    private String toDevNodeId;
    private List<SyncTaskResponse2> toNodetaskList = new ArrayList<>();

    public String getToDevNodeId() {
        return toDevNodeId;
    }

    public void setToDevNodeId(String toDevNodeId) {
        this.toDevNodeId = toDevNodeId;
    }

    public List<SyncTaskResponse2> getToNodetaskList() {
        return toNodetaskList;
    }

    public void setToNodetaskList(List<SyncTaskResponse2> toNodetaskList) {
        this.toNodetaskList = toNodetaskList;
    }
}
