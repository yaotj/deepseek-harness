package com.chinasofti.huateng.web.controller.common;

import java.io.IOException;
import java.util.concurrent.TimeUnit;
import jakarta.annotation.Resource;
import jakarta.servlet.http.HttpServletResponse;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RestController;
import com.chinasofti.huateng.common.config.PointsConfig;
import com.chinasofti.huateng.common.constant.CacheConstants;
import com.chinasofti.huateng.common.constant.Constants;
import com.chinasofti.huateng.common.core.domain.AjaxResult;
import com.chinasofti.huateng.common.core.cache.LocalCache;
import com.chinasofti.huateng.common.utils.captcha.SvgCaptcha;
import com.chinasofti.huateng.common.utils.uuid.IdUtils;
import com.chinasofti.huateng.system.service.ISysConfigService;

/**
 * 验证码操作处理（自研 SVG 验证码 - 零 AWT 依赖）
 * 
 * @author zmzhang
 */
@RestController
public class CaptchaController
{
    @Autowired
    private LocalCache localCache;
    
    @Autowired
    private ISysConfigService configService;
    
    /**
     * 生成验证码
     */
    @GetMapping("/captchaImage")
    public AjaxResult getCode(HttpServletResponse response) throws IOException
    {
        AjaxResult ajax = AjaxResult.success();
        boolean captchaEnabled = configService.selectCaptchaEnabled();
        ajax.put("captchaEnabled", captchaEnabled);
        if (!captchaEnabled)
        {
            return ajax;
        }

        // 保存验证码信息
        String uuid = IdUtils.simpleUUID();
        String verifyKey = CacheConstants.CAPTCHA_CODE_KEY + uuid;

        // 生成验证码（自研 SVG，无 AWT）
        SvgCaptcha svgCaptcha = new SvgCaptcha(130, 48, 5);
        String code = svgCaptcha.text();
        String svgBase64 = svgCaptcha.toBase64Svg();

        localCache.setCacheObject(verifyKey, code, Constants.CAPTCHA_EXPIRATION, TimeUnit.MINUTES);
        ajax.put("uuid", uuid);
        // 返回纯 Base64，前端会拼接 data:image/gif;base64, 前缀
        ajax.put("img", svgBase64);
        return ajax;
    }
}
