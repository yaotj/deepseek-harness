server.port=8080
server.max-http-header-size=40960000
spring.mvc.throw-exception-if-no-handler-found=true
spring.resources.add-mappings=false
#
spring.threads.virtual.enabled=true
#
server.tomcat.accept-count=1000
server.tomcat.max-connections=8192
server.tomcat.mbeanregistry.enabled=true
server.tomcat.basedir=${other.out.path}
#knife4j
knife4j.enable=true
knife4j.production=true
knife4j.basic.enable=false
knife4j.basic.username=test
knife4j.basic.password=12313
knife4j.setting.enable-search=true
knife4j.setting.enable-footer-custom=true
knife4j.setting.footer-custom-content=Apache License 2.0 | Copyright https://doc.xiaominfo.com/docs/quick-start
knife4j.setting.enable-dynamic-parameter=true
knife4j.setting.enable-home-custom=true
knife4j.setting.home-custom-path=classpath:META-INF/md/webmvc.md
#
other.web.enableLogRequestInFilter=false
other.web.enableBodyCacheFilter=false
other.web.enableLogTakeTimesInInterceptor=false
other.web.skipCheckTokenUrls=/**
other.web.slowRequestOfMillis=2000
other.web.logResponseMaxSize=20000
other.web.logBodyCacheUrls=/**
other.web.forbiddenUrls=/,/favicon.ico
other.web.unSafeUrlChars=% @ ( ) + : ;
other.web.removeHeaders=origin
other.web.readInputStreamInMultipartReq=false
#other.web.tokenPublicKeyPath=classpath:public.pem
#other.web.tokenPrivateKeyPath=classpath:private.pem
#other.web.actuatorAllowIp=
#
logging.config=
other.out.path=/home/javaapp/app/logs
other.logging.level=INFO
other.logging.logPath=${other.out.path}
other.logging.logBakDays=30
other.logging.appName=${spring.application.name}
#
other.monitor.pushOfSeconds=30
other.monitor.resetAllMetersCron=0 0 2 * * ?
other.monitor.logAllMetersCron=0/30 * * * * ?
other.monitor.printToLogger=false
other.monitor.checkLogWriter=false
other.monitor.metric.open=true
#
management.endpoints.web.exposure.include=*
management.endpoint.health.show-details=ALWAYS
management.endpoint.shutdown.enabled=false
management.endpoint.heapdump.enabled=false
management.endpoint.threaddump.enabled=false
management.endpoint.beans.enabled=false
management.endpoint.caches.enabled=false
management.endpoint.conditions.enabled=false
management.endpoint.configprops.enabled=false
management.endpoint.env.enabled=false
management.endpoint.loggers.enabled=false
management.endpoint.metrics.enabled=false
management.endpoint.scheduledtasks.enabled=false
management.endpoint.mappings.enabled=false
#
management.metrics.enable.jvm.memory.max=false
management.metrics.enable.jvm.buffer=false
management.metrics.enable.tomcat.servlet.request=false
management.metrics.enable.tomcat.cache=false
management.metrics.enable.mapper=false
management.metrics.enable.sql=false
management.metrics.enable.service=false
management.metrics.enable.http.server.requests=false
#
management.tracing.enabled=false
management.tracing.propagation.type=W3C,B3,B3_MULTI
management.tracing.sampling.probability=1.0
management.otlp.tracing.endpoint=http://collector-istio-traces-service.opentelemetry:4318/v1/traces
management.tracing.otlp.tracing.batch.max-queue-size=20000
management.tracing.otlp.tracing.batch.max-export-batch-size=1024
management.tracing.otlp.tracing.batch.schedule-delay=3s
management.tracing.otlp.tracing.batch.exporter-timeout=10s
management.tracing.otlp.tracing.compression=gzip
management.tracing.otlp.tracing.connect-timeout=3s
#management.zipkin.tracing.endpoint=http://localhost:9411/api/v2/spans
#
resilience4j.circuitbreaker.configs.default.automaticTransitionFromOpenToHalfOpenEnabled=true
resilience4j.circuitbreaker.configs.default.registerHealthIndicator=true
resilience4j.circuitbreaker.configs.default.eventConsumerBufferSize=1000
resilience4j.circuitbreaker.configs.default.slidingWindowType=TIME_BASED
resilience4j.circuitbreaker.configs.default.slidingWindowSize=60
resilience4j.circuitbreaker.configs.default.failureRateThreshold=60
resilience4j.circuitbreaker.configs.default.slowCallDurationThreshold=5000ms
resilience4j.circuitbreaker.configs.default.minimumNumberOfCalls=100
resilience4j.circuitbreaker.configs.default.waitDurationInOpenState=30s
resilience4j.bulkhead.configs.default.registerHealthIndicator=true
resilience4j.bulkhead.configs.default.eventConsumerBufferSize=1000
resilience4j.bulkhead.configs.default.max-concurrent-calls=1000
resilience4j.bulkhead.configs.default.max-wait-duration=2s
resilience4j.ratelimiter.configs.default.registerHealthIndicator=true
resilience4j.ratelimiter.configs.default.eventConsumerBufferSize=1000
resilience4j.ratelimiter.configs.default.limitForPeriod=1000
resilience4j.ratelimiter.configs.default.limitRefreshPeriod=1s
resilience4j.ratelimiter.configs.default.timeoutDuration=5s