package com.chinasofti.huateng.common.message.model;

import java.io.Serializable;

public class MessageHead implements Serializable {
    private String verNo;
    private String bodyType;
    private String sendTms;
    private String srcNodeId;
    private String routeNodeId;
    private String destNodeId;
    private String encryType;

    public MessageHead() {
    }

    public MessageHead(String verNo, String bodyType, String sendTms, String srcNodeId,
                       String routeNodeId, String destNodeId, String encryType) {
        this.verNo = verNo;
        this.bodyType = bodyType;
        this.sendTms = sendTms;
        this.srcNodeId = srcNodeId;
        this.routeNodeId = routeNodeId;
        this.destNodeId = destNodeId;
        this.encryType = encryType;
    }

    public String getVerNo() {
        return verNo;
    }

    public void setVerNo(String verNo) {
        this.verNo = verNo;
    }

    public String getBodyType() {
        return bodyType;
    }

    public void setBodyType(String bodyType) {
        this.bodyType = bodyType;
    }

    public String getSendTms() {
        return sendTms;
    }

    public void setSendTms(String sendTms) {
        this.sendTms = sendTms;
    }

    public String getSrcNodeId() {
        return srcNodeId;
    }

    public void setSrcNodeId(String srcNodeId) {
        this.srcNodeId = srcNodeId;
    }

    public String getRouteNodeId() {
        return routeNodeId;
    }

    public void setRouteNodeId(String routeNodeId) {
        this.routeNodeId = routeNodeId;
    }

    public String getDestNodeId() {
        return destNodeId;
    }

    public void setDestNodeId(String destNodeId) {
        this.destNodeId = destNodeId;
    }

    public String getEncryType() {
        return encryType;
    }

    public void setEncryType(String encryType) {
        this.encryType = encryType;
    }
}
