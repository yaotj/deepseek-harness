-- 二维码过闸扣费订单表
-- Oracle 月分区表，TXN_DATE 使用字符串 YYYYMMDD 入库。
-- 本表只保存地铁侧过闸订单和扣费结果，支付渠道明细、优惠、回调报文放支付侧表。
-- 注意：本表按出站交易日期 TXN_DATE 手动维护月分区，P_MAX 仅作为兜底分区。

CREATE TABLE GATE_TXN_PAY (
    ID                  NUMBER(20) NOT NULL,

    ORDER_NO            VARCHAR2(64 CHAR) NOT NULL,
    DEBIT_STATUS        VARCHAR2(16 CHAR) DEFAULT 'INIT' NOT NULL,

    THIRD_USER_ID       VARCHAR2(64 CHAR),
    CARD_ID             VARCHAR2(32 CHAR) NOT NULL,
    CARD_TYPE           VARCHAR2(8 CHAR),
    DEVICE_ID           VARCHAR2(16 CHAR),
    TRX_TYPE            VARCHAR2(4 CHAR) NOT NULL,
    TICKET_TRANS_SEQ    VARCHAR2(64 CHAR),

    IN_STATION          VARCHAR2(16 CHAR),
    IN_TIME             VARCHAR2(14 CHAR),
    OUT_STATION         VARCHAR2(16 CHAR),
    OUT_TIME            VARCHAR2(14 CHAR) NOT NULL,
    TXN_DATE            VARCHAR2(8 CHAR) NOT NULL,

    TRX_AMOUNT          NUMBER(12) DEFAULT 0 NOT NULL,
    OVERTIME_AMOUNT     NUMBER(12) DEFAULT 0 NOT NULL,
    TOTAL_AMOUNT        NUMBER(12) DEFAULT 0 NOT NULL,

    ISSUE_CHANNEL_CODE  VARCHAR2(8 CHAR),
    SIGN_CHANNEL_CODE   VARCHAR2(8 CHAR),
    REMARK              VARCHAR2(512 CHAR),

    CREATE_TIME         TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL,
    UPDATE_TIME         TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL,

    CONSTRAINT PK_GATE_TXN_PAY PRIMARY KEY (ID)
)
PARTITION BY RANGE (TXN_DATE) (
    PARTITION P202606 VALUES LESS THAN ('20260701'),
    PARTITION P202607 VALUES LESS THAN ('20260801'),
    PARTITION P202608 VALUES LESS THAN ('20260901'),
    PARTITION P202609 VALUES LESS THAN ('20261001'),
    PARTITION P202610 VALUES LESS THAN ('20261101'),
    PARTITION P202611 VALUES LESS THAN ('20261201'),
    PARTITION P202612 VALUES LESS THAN ('20270101'),
    PARTITION P_MAX VALUES LESS THAN (MAXVALUE)
);

CREATE SEQUENCE SEQ_GATE_TXN_PAY
    START WITH 1
    INCREMENT BY 1
    CACHE 1000
    NOCYCLE;

-- 地铁侧订单号唯一索引。ORDER_NO 同时作为调用支付接口的 orderNo。
-- Oracle 本地唯一索引必须包含分区键，因此包含 TXN_DATE。
CREATE UNIQUE INDEX UK_GATE_TXN_PAY_ORDER_NO
ON GATE_TXN_PAY (
    ORDER_NO,
    TXN_DATE
)
LOCAL;

-- 过闸交易幂等唯一索引。
-- 同一笔出站/超时出站交易只允许生成一笔扣费订单。
CREATE UNIQUE INDEX UK_GATE_TXN_PAY_BIZ
ON GATE_TXN_PAY (
    CARD_ID,
    TRX_TYPE,
    OUT_TIME,
    TICKET_TRANS_SEQ,
    DEVICE_ID,
    TXN_DATE
)
LOCAL;

-- 按卡号查询过闸扣费订单，查询时应带 TXN_DATE 范围以触发分区裁剪。
CREATE INDEX IDX_GATE_TXN_PAY_CARD_DATE
ON GATE_TXN_PAY (
    CARD_ID,
    TXN_DATE,
    OUT_TIME
)
LOCAL;

-- 按用户查询过闸扣费订单。
CREATE INDEX IDX_GATE_TXN_PAY_USER_DATE
ON GATE_TXN_PAY (
    THIRD_USER_ID,
    TXN_DATE,
    OUT_TIME
)
LOCAL;

-- 按扣费状态查询待补扣、失败、处理中订单。
CREATE INDEX IDX_GATE_TXN_PAY_STATUS_DATE
ON GATE_TXN_PAY (
    DEBIT_STATUS,
    TXN_DATE,
    CREATE_TIME
)
LOCAL;

-- 按设备查询扣费订单或排查设备重复上送、漏传问题。
CREATE INDEX IDX_GATE_TXN_PAY_DEVICE_DATE
ON GATE_TXN_PAY (
    DEVICE_ID,
    TXN_DATE,
    OUT_TIME
)
LOCAL;

COMMENT ON TABLE GATE_TXN_PAY IS '二维码过闸扣费订单表';

COMMENT ON COLUMN GATE_TXN_PAY.ID IS '主键ID';
COMMENT ON COLUMN GATE_TXN_PAY.ORDER_NO IS '地铁侧扣费订单号，同时作为支付接口orderNo';
COMMENT ON COLUMN GATE_TXN_PAY.DEBIT_STATUS IS '扣费状态：INIT初始化，PROCESSING处理中，SUCCESS成功，FAIL失败，RETRY待补扣，CLOSED关闭';
COMMENT ON COLUMN GATE_TXN_PAY.THIRD_USER_ID IS '第三方用户ID，对应设备报文itpUserId转换后的用户标识';
COMMENT ON COLUMN GATE_TXN_PAY.CARD_ID IS '逻辑卡号';
COMMENT ON COLUMN GATE_TXN_PAY.CARD_TYPE IS '票卡类型';
COMMENT ON COLUMN GATE_TXN_PAY.DEVICE_ID IS '设备ID，公共请求参数';
COMMENT ON COLUMN GATE_TXN_PAY.TRX_TYPE IS '交易类型：02出站，03超时出站';
COMMENT ON COLUMN GATE_TXN_PAY.TICKET_TRANS_SEQ IS '二维码交易计数器，文档字段名为tikcetTransSeq';
COMMENT ON COLUMN GATE_TXN_PAY.IN_STATION IS '进站车站代码';
COMMENT ON COLUMN GATE_TXN_PAY.IN_TIME IS '进站时间，格式YYYYMMDDHH24MISS';
COMMENT ON COLUMN GATE_TXN_PAY.OUT_STATION IS '出站车站代码';
COMMENT ON COLUMN GATE_TXN_PAY.OUT_TIME IS '出站时间，格式YYYYMMDDHH24MISS';
COMMENT ON COLUMN GATE_TXN_PAY.TXN_DATE IS '出站交易日期，取OUT_TIME前8位，格式YYYYMMDD，用于月分区';
COMMENT ON COLUMN GATE_TXN_PAY.TRX_AMOUNT IS '闸机交易金额，单位分';
COMMENT ON COLUMN GATE_TXN_PAY.OVERTIME_AMOUNT IS '超时金额，单位分';
COMMENT ON COLUMN GATE_TXN_PAY.TOTAL_AMOUNT IS '应扣总金额，单位分';
COMMENT ON COLUMN GATE_TXN_PAY.ISSUE_CHANNEL_CODE IS '发行渠道代码';
COMMENT ON COLUMN GATE_TXN_PAY.SIGN_CHANNEL_CODE IS '签约通道代码';
COMMENT ON COLUMN GATE_TXN_PAY.REMARK IS '备注';
COMMENT ON COLUMN GATE_TXN_PAY.CREATE_TIME IS '创建时间';
COMMENT ON COLUMN GATE_TXN_PAY.UPDATE_TIME IS '更新时间';

-- 后续月分区维护示例：
--
-- 1. 新增 2027 年 1 月分区。
--    P202701 覆盖范围：20270101 <= TXN_DATE < 20270201
--
-- ALTER TABLE GATE_TXN_PAY
-- SPLIT PARTITION P_MAX
-- AT ('20270201')
-- INTO (
--     PARTITION P202701,
--     PARTITION P_MAX
-- );
--
-- 2. 新增 2027 年 2 月分区。
--    P202702 覆盖范围：20270201 <= TXN_DATE < 20270301
--
-- ALTER TABLE GATE_TXN_PAY
-- SPLIT PARTITION P_MAX
-- AT ('20270301')
-- INTO (
--     PARTITION P202702,
--     PARTITION P_MAX
-- );
--
-- 3. 查询分区情况。
--
-- SELECT TABLE_NAME, PARTITION_NAME, HIGH_VALUE
-- FROM USER_TAB_PARTITIONS
-- WHERE TABLE_NAME = 'GATE_TXN_PAY'
-- ORDER BY PARTITION_POSITION;
--
-- 4. 删除历史月份分区示例：删除 2026 年 6 月过闸扣费订单。
--    执行前务必确认历史数据已归档或无需保留。
--
-- ALTER TABLE GATE_TXN_PAY DROP PARTITION P202606 UPDATE INDEXES;
--
-- 5. 推荐查询写法：按卡号查询时同时带 TXN_DATE 范围，确保命中分区裁剪。
--
-- SELECT *
-- FROM GATE_TXN_PAY
-- WHERE CARD_ID = :cardId
--   AND TXN_DATE >= :beginDate
--   AND TXN_DATE <  :endDate
-- ORDER BY OUT_TIME DESC;
--
-- 6. 待补扣查询示例。
--
-- SELECT *
-- FROM GATE_TXN_PAY
-- WHERE DEBIT_STATUS IN ('FAIL', 'RETRY')
--   AND TXN_DATE >= :beginDate
--   AND TXN_DATE <  :endDate
-- ORDER BY CREATE_TIME;
