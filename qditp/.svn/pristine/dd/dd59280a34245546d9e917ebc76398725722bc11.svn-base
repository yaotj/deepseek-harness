package com.chinasofti.huateng.model.acc;

/**
 * desc:3002-模式通知-请求报文
 **/
public class ModeNoticeReqDTO {

    /**
     * desc:当前时间,YYYYMMDDhhmmss
     **/
    String currTime;

    /**
     * desc:设备节点编码,发生降级运营模式的车站,8位
     **/
    String modeDevNodeId;

    /**
     * desc:车站运行模式ID,2位
     **/
    String scRunModeId;

    /**
     * desc:模式发生时间,YYYYMMDDhhmmss
     **/
    String occurTime;

    public String getCurrTime() {
        return currTime;
    }

    public void setCurrTime(String currTime) {
        this.currTime = currTime;
    }

    public String getModeDevNodeId() {
        return modeDevNodeId;
    }

    public void setModeDevNodeId(String modeDevNodeId) {
        this.modeDevNodeId = modeDevNodeId;
    }

    public String getScRunModeId() {
        return scRunModeId;
    }

    public void setScRunModeId(String scRunModeId) {
        this.scRunModeId = scRunModeId;
    }

    public String getOccurTime() {
        return occurTime;
    }

    public void setOccurTime(String occurTime) {
        this.occurTime = occurTime;
    }
}