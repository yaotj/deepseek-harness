    @Override
    public AlipayTripReceiveBlackListRespDTO receiveBlackListFromItp(AlipayTripReceiveBlackListReqDTO request) {
        log.info("支付宝出行-黑名单状态变更通知,请求参数：{}", JSON.toJSONString(request));
        AlipayTripReceiveBlackListRespDTO response = new AlipayTripReceiveBlackListRespDTO();
        if (request == null || !StringUtils.hasText(request.getThirdUserId()) || !StringUtils.hasText(request.getCardId())) {
            response.setRetCode(FepAppErrorCodeEnum.INVALID_PARAM.getCode());
            response.setRetMsg("无效的参数");
            log.warn("支付宝出行-黑名单状态变更通知,参数校验失败");
            return response;
        }
        try {
            response = blacklistClient.alipayTripReceiveBlackList(request);
            if (response == null) {
                response = new AlipayTripReceiveBlackListRespDTO();
                response.setRetCode(FepAppErrorCodeEnum.FAIL.getCode());
                response.setRetMsg("系统内部错误");
                log.error("支付宝出行-黑名单状态变更通知,blacklist-server 返回空响应");
                return response;
            }
        } catch (Exception e) {
            log.error("支付宝出行-黑名单状态变更通知 异常", e);
            response.setRetCode(FepAppErrorCodeEnum.FAIL.getCode());
            response.setRetMsg("系统内部错误");
        }
        log.info("支付宝出行-黑名单状态变更通知,响应结果：{}", JSON.toJSONString(response));
        return response;
    }
