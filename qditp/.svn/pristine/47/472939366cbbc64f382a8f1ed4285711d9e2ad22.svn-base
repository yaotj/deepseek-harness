package com.chinasofti.huateng.acc.security.server.socket;

public class RawRequestContext {
    private final RawResponseSpec responseSpec;
    private final RawSocketResponseFuture future;

    public RawRequestContext(RawResponseSpec responseSpec, RawSocketResponseFuture future) {
        this.responseSpec = responseSpec;
        this.future = future;
    }

    public RawResponseSpec getResponseSpec() {
        return responseSpec;
    }

    public RawSocketResponseFuture getFuture() {
        return future;
    }
}
