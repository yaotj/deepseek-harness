server.port=9108
spring.application.name=daily-ticket-server

other.web.unSafeUrlChars=null
other.web.enableLogRequestInFilter=true
other.web.enableBodyCacheFilter=true
other.web.enableLogTakeTimesInInterceptor=true

knife4j.production=true

mybatis.mapper-locations=classpath*:mapper/*.xml



daily-ticket.pay.gateway-url=${DAILY_TICKET_PAY_GATEWAY_URL:http://dtcustomer.bestonepay.com/ngpayment-gateway}
daily-ticket.pay.merchant-no=${DAILY_TICKET_PAY_MERCHANT_NO:JOPJ490HLK9Z}
daily-ticket.pay.api-version=${DAILY_TICKET_PAY_API_VERSION:1.0}
daily-ticket.pay.sign-type=${DAILY_TICKET_PAY_SIGN_TYPE:RSA2}
daily-ticket.pay.charset=${DAILY_TICKET_PAY_CHARSET:UTF-8}
daily-ticket.pay.merchant-private-key=${DAILY_TICKET_PAY_MERCHANT_PRIVATE_KEY:}
daily-ticket.pay.request-pay-path=${DAILY_TICKET_PAY_REQUEST_PAY_PATH:/api/v1/payment/requestPay}
daily-ticket.pay.request-refund-path=${DAILY_TICKET_PAY_REQUEST_REFUND_PATH:/api/v1/refund/requestRefund}
daily-ticket.pay.notify-url=${DAILY_TICKET_PAY_NOTIFY_URL:http://58.56.166.170:48000/app/payment/receivePayResult}
daily-ticket.pay.return-url=${DAILY_TICKET_PAY_RETURN_URL:}
daily-ticket.pay.industry-type=1
daily-ticket.pay.subject=虚拟电子票
daily-ticket.pay.body=虚拟电子票

other.sql.host=${DB_HOST:172.20.222.3:1521}
other.sql.double-datasource=false
other.sql.type=oracle
other.sql.page.type=oracle
other.sql.database=${DB_NAME:AFCITPDB}
other.sql.username=${DB_USERNAME:qditp}
other.sql.password=${DB_PASSWORD:qditp}
