package com.chinasofti.huateng.alipay.paysign.controller;

import com.chinasofti.huateng.alipay.paysign.entity.AlipayPayLog;
import com.chinasofti.huateng.alipay.paysign.service.AlipayPaySignService;
import com.chinasofti.huateng.model.alipaytrip.AlipayPayLogDTO;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

/**
 * 支付宝出行订单 Controller。
 */
@RestController
@RequestMapping("/api/payment")
public class AlipayPayLogController {

    private final AlipayPaySignService alipayPaySignService;

    public AlipayPayLogController(AlipayPaySignService alipayPaySignService) {
        this.alipayPaySignService = alipayPaySignService;
    }

    /**
     * 查询支付宝出行订单列表。
     */
    @GetMapping("/payLog/list")
    public Map<String, Object> list(@RequestParam(required = false) String thirdUserId,
                                    @RequestParam(required = false) String startTime,
                                    @RequestParam(required = false) String endTime,
                                    @RequestParam(defaultValue = "1") int pageNum,
                                    @RequestParam(defaultValue = "10") int pageSize) {
        return buildResult(thirdUserId, startTime, endTime, pageNum, pageSize);
    }

    /**
     * 查询支付宝出行订单列表（POST，兼容客户端JSON请求）。
     */
    @PostMapping("/payLog/list")
    public Map<String, Object> listPost(@RequestBody java.util.Map<String, Object> params) {
        String thirdUserId = params.get("thirdUserId") != null ? params.get("thirdUserId").toString() : null;
        String startTime = params.get("startTime") != null ? params.get("startTime").toString() : null;
        String endTime = params.get("endTime") != null ? params.get("endTime").toString() : null;
        int pageNum = params.get("pageNum") != null ? Integer.parseInt(params.get("pageNum").toString()) : 1;
        int pageSize = params.get("pageSize") != null ? Integer.parseInt(params.get("pageSize").toString()) : 10;
        return buildResult(thirdUserId, startTime, endTime, pageNum, pageSize);
    }

    /**
     * 按订单号查询支付日志详情。
     */
    @GetMapping("/payLog/detail")
    public AlipayPayLogDTO detail(@RequestParam String orderNo) {
        return alipayPaySignService.selectByOrderNo(orderNo);
    }

    /**
     * 按进站交易ID查询支付流水。
     */
    @GetMapping("/payLog/entryId")
    public AlipayPayLogDTO entryId(@RequestParam String entryId) {
        return alipayPaySignService.selectByEntryId(entryId);
    }

    /**
     * 按出站交易ID查询支付流水。
     */
    @GetMapping("/payLog/exitId")
    public AlipayPayLogDTO exitId(@RequestParam String exitId) {
        return alipayPaySignService.selectByExitId(exitId);
    }

    /**
     * 按乘车记录查询支付流水。
     */
    @PostMapping("/payLog/queryByTravelRecord")
    public AlipayPayLogDTO queryByTravelRecord(@RequestBody Map<String, String> params) {
        String thirdUserId = params.get("thirdUserId");
        String entryDate = params.get("entryDate");
        String cardNum = params.get("cardNum");
        return alipayPaySignService.selectByTravelRecord(thirdUserId, entryDate, cardNum);
    }

    /**
     * 支付宝出行-查询乘车记录支付流水列表。
     */
    @GetMapping("/payLog/travelList")
    public Map<String, Object> travelList(@RequestParam String thirdUserId,
                                          @RequestParam(required = false) String startDate,
                                          @RequestParam(required = false) String endDate,
                                          @RequestParam(required = false) String debitRequestResult,
                                          @RequestParam(required = false) String invoice,
                                          @RequestParam(defaultValue = "0") int pageNum,
                                          @RequestParam(defaultValue = "10") int pageSize) {
        return buildTravelListResult(thirdUserId, startDate, endDate, pageNum, pageSize, debitRequestResult, invoice);
    }

    /**
     * 支付宝出行-查询乘车记录支付流水列表（POST）。
     */
    @PostMapping("/payLog/travelList")
    public Map<String, Object> travelListPost(@RequestBody Map<String, Object> params) {
        String thirdUserId = params.get("thirdUserId") != null ? params.get("thirdUserId").toString() : null;
        String startDate = params.get("startDate") != null ? params.get("startDate").toString() : null;
        String endDate = params.get("endDate") != null ? params.get("endDate").toString() : null;
        String debitRequestResult = params.get("debitRequestResult") != null ? params.get("debitRequestResult").toString() : null;
        String invoice = params.get("invoice") != null ? params.get("invoice").toString() : null;
        int pageNum = params.get("pageNum") != null ? Integer.parseInt(params.get("pageNum").toString()) : 0;
        int pageSize = params.get("pageSize") != null ? Integer.parseInt(params.get("pageSize").toString()) : 10;
        return buildTravelListResult(thirdUserId, startDate, endDate, pageNum, pageSize, debitRequestResult, invoice);
    }

    private Map<String, Object> buildTravelListResult(String thirdUserId, String startDate, String endDate, int pageNum, int pageSize,
                                                       String debitRequestResult, String invoice) {
        Map<String, Object> result = new HashMap<>();
        int offset = pageNum * pageSize;
        List<AlipayPayLog> list = alipayPaySignService.selectAlipayPayLogListForTravel(thirdUserId, startDate, endDate, offset, pageSize, debitRequestResult, invoice);
        int total = alipayPaySignService.countAlipayPayLogListForTravel(thirdUserId, startDate, endDate, debitRequestResult, invoice);
        int totalPage = (int) Math.ceil((double) total / pageSize);
        List<Map<String, Object>> records = new ArrayList<>();
        for (AlipayPayLog log : list) {
            Map<String, Object> item = new LinkedHashMap<>();
            item.put("orderNo", log.getOrderNo());
            item.put("channelOrderNo", log.getTradeNo());
            item.put("payStatus", log.getPayStatus());
            item.put("payAmount", log.getPayAmount());
            item.put("entryId", log.getEntryId());
            item.put("exitId", log.getExitId());
            item.put("cardId", log.getCardId());
            records.add(item);
        }
        result.put("list", records);
        result.put("total", total);
        result.put("pageNum", pageNum);
        result.put("pageSize", pageSize);
        result.put("totalPage", totalPage);
        return result;
    }

    private Map<String, Object> buildResult(String thirdUserId, String startTime, String endTime, int pageNum, int pageSize) {
        Map<String, Object> result = new HashMap<>();
        int offset = (pageNum - 1) * pageSize;
        List<AlipayPayLog> list = alipayPaySignService.selectAlipayPayLogList(thirdUserId, startTime, endTime, offset, pageSize, null, null);
        int total = alipayPaySignService.countAlipayPayLogList(thirdUserId, startTime, endTime, null, null);
        result.put("list", list);
        result.put("total", total);
        result.put("pageNum", pageNum);
        result.put("pageSize", pageSize);
        return result;
    }
}
