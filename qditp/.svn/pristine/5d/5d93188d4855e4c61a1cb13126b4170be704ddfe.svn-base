package com.chinasofti.huateng.model.app;

public class RequestUpdateChannelDefaultContractReqDTO {
    private String thirdUserId;
    private String channel;
    private String cardIssueCode;
    private String regSignSeq;

    public String getThirdUserId() {
        return thirdUserId;
    }

    public void setThirdUserId(String thirdUserId) {
        this.thirdUserId = thirdUserId;
    }

    public String getChannel() {
        return channel;
    }

    public void setChannel(String channel) {
        this.channel = channel;
    }

    public String getCardIssueCode() {
        return cardIssueCode;
    }

    public void setCardIssueCode(String cardIssueCode) {
        this.cardIssueCode = cardIssueCode;
    }

    public String getRegSignSeq() {
        return regSignSeq;
    }

    public void setRegSignSeq(String regSignSeq) {
        this.regSignSeq = regSignSeq;
    }
}
