            response.setRetCode("0000");
            response.setRetMsg("成功");
            response.setPageNumber(0);
            response.setPageSize(Integer.parseInt(request.getSize() != null ? request.getSize() : "10"));
            response.setTotalPage(0);
            response.setTotalCount(0);
            response.setTicketTransRecord(java.util.Collections.emptyList());
            log.info("支付宝出行-查询乘车记录 响应结果: {}", JSON.toJSONString(response));
            return response;
