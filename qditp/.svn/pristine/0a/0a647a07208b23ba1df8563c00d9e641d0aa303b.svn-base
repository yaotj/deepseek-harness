<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinasofti.huateng.alipay.paysign.mapper.AlipayPayLogMapper">
    <sql id="baseColumns">
        PAY_SEQ, THIRD_USER_ID, CARD_ID, ORDER_NO, TRADE_NO, TRANS_TIME,
        PAY_AMOUNT, PAY_STATUS, PAY_TYPE, SCENE, PAYMENT_VENDOR,
        INDUSTRY_TYPE, SUBJECT, BODY, REQUEST_SIGN_SEQ, ORDER_TIME_OUT,
        AUTH_CODE, NOTIFY_URL, RETURN_URL, IP_ADDRESS, INDUSTRY_DETAIL,
        ENTRY_ID, EXIT_ID,
        REQUEST_BODY, RESPONSE_BODY, RESULT_CODE, RESULT_MSG,
        REMARK,
        REFUND_AMOUNT, REFUND_STATUS,
        INVOICE
    </sql>

    <sql id="allColumns">
        PAY_SEQ AS paySeq,
        THIRD_USER_ID AS thirdUserId,
        CARD_ID AS cardId,
        ORDER_NO AS orderNo,
        TRADE_NO AS tradeNo,
        TRANS_TIME AS transTime,
        PAY_AMOUNT AS payAmount,
        PAY_STATUS AS payStatus,
        PAY_TYPE AS payType,
        SCENE AS scene,
        PAYMENT_VENDOR AS paymentVendor,
        INDUSTRY_TYPE AS industryType,
        SUBJECT AS subject,
        BODY AS body,
        REQUEST_SIGN_SEQ AS requestSignSeq,
        ORDER_TIME_OUT AS orderTimeOut,
        AUTH_CODE AS authCode,
        NOTIFY_URL AS notifyUrl,
        RETURN_URL AS returnUrl,
        IP_ADDRESS AS ipAddress,
        INDUSTRY_DETAIL AS industryDetail,
        ENTRY_ID AS entryId,
        EXIT_ID AS exitId,
        REQUEST_BODY AS requestBody,
        RESPONSE_BODY AS responseBody,
        RESULT_CODE AS resultCode,
        RESULT_MSG AS resultMsg,
        REMARK AS remark,
        REFUND_AMOUNT AS refundAmount,
        REFUND_STATUS AS refundStatus,
        INVOICE AS invoice
    </sql>

    <sql id="allColumnsRaw">
        PAY_SEQ, THIRD_USER_ID, CARD_ID, ORDER_NO, TRADE_NO, TRANS_TIME,
        PAY_AMOUNT, PAY_STATUS, PAY_TYPE, SCENE, PAYMENT_VENDOR,
        INDUSTRY_TYPE, SUBJECT, BODY, REQUEST_SIGN_SEQ, ORDER_TIME_OUT,
        AUTH_CODE, NOTIFY_URL, RETURN_URL, IP_ADDRESS, INDUSTRY_DETAIL,
        ENTRY_ID, EXIT_ID,
        REQUEST_BODY, RESPONSE_BODY, RESULT_CODE, RESULT_MSG,
        REMARK,
        REFUND_AMOUNT, REFUND_STATUS,
        INVOICE
    </sql>

    <select id="selectByOrderNo" resultType="com.chinasofti.huateng.alipay.paysign.entity.AlipayPayLog">
        SELECT
            <include refid="allColumns"/>
        FROM ALIPAY_PAY_LOG
        WHERE ORDER_NO = #{orderNo,jdbcType=VARCHAR}
    </select>

    <select id="selectByPaySeq" resultType="com.chinasofti.huateng.alipay.paysign.entity.AlipayPayLog">
        SELECT
            <include refid="allColumns"/>
        FROM ALIPAY_PAY_LOG
        WHERE PAY_SEQ = #{paySeq,jdbcType=VARCHAR}
    </select>

    <insert id="insert" parameterType="com.chinasofti.huateng.alipay.paysign.entity.AlipayPayLog" useGeneratedKeys="false">
        INSERT INTO ALIPAY_PAY_LOG (
            <include refid="baseColumns"/>
        ) VALUES (
            #{paySeq,jdbcType=VARCHAR}, #{thirdUserId,jdbcType=VARCHAR}, #{cardId,jdbcType=VARCHAR}, #{orderNo,jdbcType=VARCHAR}, #{tradeNo,jdbcType=VARCHAR}, #{transTime,jdbcType=VARCHAR},
            #{payAmount,jdbcType=VARCHAR}, #{payStatus,jdbcType=VARCHAR}, #{payType,jdbcType=VARCHAR}, #{scene,jdbcType=VARCHAR}, #{paymentVendor,jdbcType=VARCHAR},
            #{industryType,jdbcType=VARCHAR}, #{subject,jdbcType=VARCHAR}, #{body,jdbcType=VARCHAR}, #{requestSignSeq,jdbcType=VARCHAR}, #{orderTimeOut,jdbcType=VARCHAR},
            #{authCode,jdbcType=VARCHAR}, #{notifyUrl,jdbcType=VARCHAR}, #{returnUrl,jdbcType=VARCHAR}, #{ipAddress,jdbcType=VARCHAR}, #{industryDetail,jdbcType=VARCHAR},
            #{entryId,jdbcType=VARCHAR}, #{exitId,jdbcType=VARCHAR},
            #{requestBody,jdbcType=VARCHAR}, #{responseBody,jdbcType=VARCHAR}, #{resultCode,jdbcType=VARCHAR}, #{resultMsg,jdbcType=VARCHAR},
            #{remark,jdbcType=VARCHAR},
            #{refundAmount,jdbcType=VARCHAR}, #{refundStatus,jdbcType=VARCHAR},
            #{invoice,jdbcType=VARCHAR}
        )
    </insert>

    <update id="updatePayStatus">
        UPDATE ALIPAY_PAY_LOG
        SET PAY_STATUS = #{payStatus,jdbcType=VARCHAR}
        WHERE PAY_SEQ = #{paySeq,jdbcType=VARCHAR}
    </update>

    <update id="updatePayNotify">
        UPDATE ALIPAY_PAY_LOG
        SET PAY_STATUS = #{payStatus,jdbcType=VARCHAR},
            TRADE_NO = #{tradeNo,jdbcType=VARCHAR},
            TRANS_TIME = #{transTime,jdbcType=VARCHAR},
            PAY_AMOUNT = #{payAmount,jdbcType=VARCHAR},
            RESULT_CODE = #{resultCode,jdbcType=VARCHAR},
            RESULT_MSG = #{resultMsg,jdbcType=VARCHAR}
        WHERE ORDER_NO = #{orderNo,jdbcType=VARCHAR}
    </update>

    <update id="updateRefundSummary">
        UPDATE ALIPAY_PAY_LOG
        SET REFUND_AMOUNT = NVL(REFUND_AMOUNT, 0) + #{refundAmount,jdbcType=VARCHAR},
            REFUND_STATUS = #{refundStatus,jdbcType=VARCHAR}
        WHERE ORDER_NO = #{orderNo,jdbcType=VARCHAR}
    </update>

    <select id="selectAlipayPayLogList" resultType="com.chinasofti.huateng.alipay.paysign.entity.AlipayPayLog">
        SELECT *
        FROM (
            SELECT
                <include refid="allColumns"/>,
                ROW_NUMBER() OVER (ORDER BY PAY_SEQ DESC) AS rn
            FROM ALIPAY_PAY_LOG
            WHERE 1=1
              <if test="thirdUserId != null and thirdUserId != ''">
                  AND THIRD_USER_ID = #{thirdUserId}
              </if>
              <if test="debitRequestResult != null and debitRequestResult != ''">
                  <choose>
                      <when test="debitRequestResult == '0'">
                          AND PAY_STATUS = 'SUCCESS'
                      </when>
                      <when test="debitRequestResult == '1'">
                          AND PAY_STATUS != 'SUCCESS'
                      </when>
                  </choose>
              </if>
              <if test="invoice != null and invoice != ''">
                  AND INVOICE = #{invoice}
              </if>
              <if test="startTime != null and startTime != ''">
                  AND CREATE_TIME &gt;= TO_DATE(#{startTime}, 'YYYY-MM-DD HH24:MI:SS')
              </if>
              <if test="endTime != null and endTime != ''">
                  AND CREATE_TIME &lt;= TO_DATE(#{endTime}, 'YYYY-MM-DD HH24:MI:SS')
              </if>
        )
        WHERE rn &gt; #{offset} AND rn &lt;= #{limit}
    </select>

    <select id="countAlipayPayLogList" resultType="java.lang.Integer">
        SELECT COUNT(1)
        FROM ALIPAY_PAY_LOG
        WHERE 1=1
          <if test="thirdUserId != null and thirdUserId != ''">
              AND THIRD_USER_ID = #{thirdUserId}
          </if>
          <if test="debitRequestResult != null and debitRequestResult != ''">
              <choose>
                  <when test="debitRequestResult == '0'">
                      AND PAY_STATUS = 'SUCCESS'
                  </when>
                  <when test="debitRequestResult == '1'">
                      AND PAY_STATUS != 'SUCCESS'
                  </when>
              </choose>
          </if>
          <if test="invoice != null and invoice != ''">
              AND INVOICE = #{invoice}
          </if>
          <if test="startTime != null and startTime != ''">
              AND CREATE_TIME &gt;= TO_DATE(#{startTime}, 'YYYY-MM-DD HH24:MI:SS')
          </if>
          <if test="endTime != null and endTime != ''">
              AND CREATE_TIME &lt;= TO_DATE(#{endTime}, 'YYYY-MM-DD HH24:MI:SS')
          </if>
    </select>

    <select id="selectByEntryId" resultType="com.chinasofti.huateng.model.alipaytrip.AlipayPayLogDTO">
        SELECT ORDER_NO AS orderNo, PAY_STATUS AS payStatus, TRADE_NO AS channelOrderNo
        FROM ALIPAY_PAY_LOG
        WHERE ENTRY_ID = #{entryId,jdbcType=VARCHAR}
        FETCH FIRST 1 ROWS ONLY
    </select>

    <select id="selectByExitId" resultType="com.chinasofti.huateng.model.alipaytrip.AlipayPayLogDTO">
        SELECT ORDER_NO AS orderNo, PAY_STATUS AS payStatus, TRADE_NO AS channelOrderNo
        FROM ALIPAY_PAY_LOG
        WHERE EXIT_ID = #{exitId,jdbcType=VARCHAR}
        FETCH FIRST 1 ROWS ONLY
    </select>
</mapper>
