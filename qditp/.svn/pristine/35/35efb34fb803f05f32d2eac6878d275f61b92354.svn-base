                    + (StringUtils.hasText(entryDate) ? entryDate.replaceAll("[^0-9]", "") : "") + "01";
            if (!StringUtils.hasText(entryId)) {
                return null;
            }
            return alipayPayLogMapper.selectByEntryId(entryId);
        } catch (Exception e) {
            log.error("按乘车记录查询支付流水异常, thirdUserId={}, entryDate={}, cardNum={}", thirdUserId, entryDate, cardNum, e);
            return null;
        }
    }

    @Override
    public com.chinasofti.huateng.common.response.AlipayCommonResponse notifyBlackListChange(com.chinasofti.huateng.model.alipaytrip.AlipayBlackListNotifyReqDTO request) {
        com.chinasofti.huateng.common.response.AlipayCommonResponse response = new com.chinasofti.huateng.common.response.AlipayCommonResponse();
        try {
            if (request == null || !StringUtils.hasText(request.getCardId())) {
                response.setRetCode(FepAppErrorCodeEnum.INVALID_PARAM.getCode());
                response.setRetMsg("卡号不能为空");
                return response;
            }
            log.info("接收到支付宝出行-黑名单状态变更通知: cardId={}, blackListType={}, reason={}",
                    request.getCardId(), request.getBlackListType(), request.getReason());

            // 组装黑名单通知 bizData（明文 JSON，不 Base64 编码）
            Map<String, Object> bizDataMap = new java.util.LinkedHashMap<>();
            bizDataMap.put("cardId", request.getCardId());
            bizDataMap.put("thirdUserId", request.getThirdUserId());
            bizDataMap.put("cardType", request.getCardType());
            bizDataMap.put("blackListType", request.getBlackListType());
            bizDataMap.put("optionDate", request.getOptionDate());
            bizDataMap.put("expireTime", request.getExpireTime());
            bizDataMap.put("reason", request.getReason());

            // 调用支付中心黑名单变更通知接口
            com.chinasofti.huateng.alipay.paysign.model.response.PayCenterResponse payCenterResponse = payCenterClient.blacklistNotify(bizDataMap);

            if (payCenterResponse != null && Boolean.TRUE.equals(payCenterResponse.getSuccess())) {
                response.setRetCode(FepAppErrorCodeEnum.SUCCESS.getCode());
                response.setRetMsg("黑名单变更通知成功");
            } else if (payCenterResponse != null) {
                response.setRetCode(FepAppErrorCodeEnum.FAIL.getCode());
                response.setRetMsg(payCenterResponse.getMsg() != null ? payCenterResponse.getMsg() : "黑名单变更通知失败");
            } else {
                response.setRetCode(FepAppErrorCodeEnum.SYSTEM_ERROR.getCode());
                response.setRetMsg("调用支付中心黑名单通知接口失败");
            }
            log.info("支付宝出行-黑名单状态变更通知完成, cardId={}, retCode={}", request.getCardId(), response.getRetCode());
            return response;
        } catch (Exception e) {
            log.error("支付宝出行-黑名单状态变更通知异常, cardId={}", request != null ? request.getCardId() : null, e);
            response.setRetCode(FepAppErrorCodeEnum.SYSTEM_ERROR.getCode());
            response.setRetMsg("系统内部错误");
            return response;
        }
    }

    // ==================== 私有方法 ====================

    private boolean isValidAddContractRequest(AlipayTripAddContractReqDTO request) {
        return request.getThirdUserId() != null && !request.getThirdUserId().trim().isEmpty()
                && request.getChannel() != null && !request.getChannel().trim().isEmpty()
                && request.getAgreementCode() != null && !request.getAgreementCode().trim().isEmpty()
                && request.getChannelUserAccount() != null && !request.getChannelUserAccount().trim().isEmpty();
    }

    private boolean isValidTerminateContractRequest(AlipayTripTerminateContractReqDTO request) {
        return request.getAgreementCode() != null && !request.getAgreementCode().trim().isEmpty();
    }

    private boolean isValidPayRequest(AlipayTripRequestPayReqDTO request) {
        return request.getOrderNo() != null && !request.getOrderNo().trim().isEmpty()
                && request.getAmount() != null
                && request.getIndustryType() != null && !request.getIndustryType().trim().isEmpty()
                && request.getSubject() != null && !request.getSubject().trim().isEmpty()
                && request.getBody() != null && !request.getBody().trim().isEmpty()
                && request.getIndustryDetail() != null && !request.getIndustryDetail().trim().isEmpty();
    }

    private boolean isValidRefundRequest(AlipayTripRequestRefundReqDTO request) {
        return request != null && StringUtils.hasText(request.getOrderNo());
    }

    private long parseAmount(String amount) {
        if (amount == null || amount.trim().isEmpty()) {
            return 0;
        }
        try {
            return Long.parseLong(amount.trim());
        } catch (NumberFormatException e) {
            log.error("退款金额格式异常, amount={}", amount, e);
            throw new RuntimeException("退款金额格式异常: " + amount);
        }
    }
}
