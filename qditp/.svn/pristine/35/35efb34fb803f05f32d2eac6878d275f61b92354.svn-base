            response.setPayChannelCode(CHANNEL_ALIPAY);
            response.setTradeOrderNo(payLog.getTradeNo());
            response.setTotalAmount(payLog.getPayAmount());
            response.setDebitRequestResult(payLog.getResultMsg());
            return response;
        } catch (Exception e) {
            log.error("查询乘车记录详情异常", e);
            response.setRetCode(FepAppErrorCodeEnum.SYSTEM_ERROR.getCode());
            response.setRetMsg("系统内部错误");
            return response;
        }
