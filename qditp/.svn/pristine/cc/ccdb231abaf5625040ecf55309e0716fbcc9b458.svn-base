package com.chinasofti.huateng.fep.alipay.controller;

import com.alibaba.fastjson2.JSON;
import com.chinasofti.huateng.model.alipaytrip.AlipayTripBlackListNotifyReqDTO;
import com.chinasofti.huateng.model.alipaytrip.AlipayTripReceiveBlackListRespDTO;
import com.chinasofti.huateng.fep.alipay.service.AlipayTripService;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

/**
 * 支付宝出行黑名单结果通知控制器。
 * <p>
 * 符合支付宝规范 3.28 黑名单结果通知接口。
 * </p>
 */
@RestController
@RequestMapping("/app")
public class AlipayBlackListNotifyController {
    private static final Logger log = LoggerFactory.getLogger(AlipayBlackListNotifyController.class);

    private final AlipayTripService alipayTripService;

    public AlipayBlackListNotifyController(AlipayTripService alipayTripService) {
        this.alipayTripService = alipayTripService;
    }

    /**
     * 3.28 支付宝出行-黑名单结果通知。
     */
    @PostMapping("/receiveBlackListFromItp")
    public AlipayTripReceiveBlackListRespDTO receiveBlackListFromItp(@RequestBody AlipayTripBlackListNotifyReqDTO request) {
        log.info("接收到支付宝出行-黑名单结果通知: {}", JSON.toJSONString(request));
        AlipayTripReceiveBlackListRespDTO response = alipayTripService.receiveBlackListFromItp(request);
        log.info("支付宝出行-黑名单结果通知,响应结果：{}", JSON.toJSONString(response));
        return response;
    }
}
