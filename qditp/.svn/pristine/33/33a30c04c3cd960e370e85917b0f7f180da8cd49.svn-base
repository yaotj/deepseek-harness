package com.chinasofti.huateng.fep.app.controller;

import com.alibaba.fastjson2.JSON;
import com.alibaba.fastjson2.JSONObject;
import com.chinasofti.huateng.common.constant.FepAppErrorCodeEnum;
import com.chinasofti.huateng.fep.app.model.CommonFormRequest;
import com.chinasofti.huateng.fep.app.service.PaySignAppService;
import com.chinasofti.huateng.model.app.PayCenterCommonRequest;
import com.chinasofti.huateng.model.app.PaySignCallbackResult;
import com.chinasofti.huateng.model.app.ReceivePayResultReqDTO;
import com.chinasofti.huateng.model.app.ReceiveSignResultReqDTO;
import com.chinasofti.huateng.model.app.ReceiveTerminationResultReqDTO;
import com.chinasofti.huateng.model.app.RequestSignInfoReqDTO;
import com.chinasofti.huateng.model.app.RequestSignInfoResult;
import com.chinasofti.huateng.model.app.RequestTerminationReqDTO;
import com.chinasofti.huateng.model.app.RequestTerminationResult;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.web.bind.annotation.ModelAttribute;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import java.nio.charset.StandardCharsets;
import java.util.Base64;

/**
 * APP 签约、解约及支付中心回调接口入口。
 *
 * <p>请求接口使用 APP FormData 协议；支付中心回调兼容业务字段直接位于根节点、
 * {@code bizData} 为 JSON 对象或 Base64 字符串三种报文形态。业务状态维护和 APP 通知由 pay-sign-server 负责。</p>
 */
@RestController
@RequestMapping("/ci/app")
public class AppPaySignController extends BaseAppController {
    private static final Logger log = LoggerFactory.getLogger(AppPaySignController.class);

    private final PaySignAppService paySignAppService;

    public AppPaySignController(PaySignAppService paySignAppService) {
        this.paySignAppService = paySignAppService;
    }

    /**
     * IF8A-16 请求签约信息。
     *
     * @param request APP 公共 FormData 请求，bizData 为 {@link RequestSignInfoReqDTO} JSON
     * @return 签约信息结果
     */
    @PostMapping("/requestSignInfo")
    public RequestSignInfoResult requestSignInfo(@ModelAttribute CommonFormRequest request) {
        log.info("IF8A-16 请求签约信息,请求参数：{}", request);
        return paySignAppService.requestSignInfo(parseBizData(request, RequestSignInfoReqDTO.class));
    }

    /**
     * IF8A-06 请求解约。
     *
     * <p>本接口仅转发解约受理请求；最终解约状态以后续支付中心回调为准。</p>
     *
     * @param request APP 公共 FormData 请求，bizData 为 {@link RequestTerminationReqDTO} JSON
     * @return 解约受理结果
     */
    @PostMapping("/requestTermination")
    public RequestTerminationResult requestTermination(@ModelAttribute CommonFormRequest request) {
        log.info("IF8A-06 请求解约,请求参数: {}", request);
        return paySignAppService.requestTermination(parseBizData(request, RequestTerminationReqDTO.class));
    }

    /**
     * IPD02 接收签约结果通知。
     *
     * @param request 支付中心公共报文，bizData 为 Base64 编码的 {@link ReceiveSignResultReqDTO}
     * @return 支付中心回调确认结果
     */
    @PostMapping("/receiveSignResult")
    public PaySignCallbackResult receiveSignResult(@RequestBody PayCenterCommonRequest request) {
        log.info("IF8A-06 签约结果回调,请求参数: {}", request);
        if (request == null || request.getBizData() == null) {
            return invalidCallback();
        }
        ReceiveSignResultReqDTO bizData = parseEncodedBizData(request.getBizData(), ReceiveSignResultReqDTO.class);
        return bizData == null ? invalidCallback() : paySignAppService.receiveSignResult(bizData);
    }

    /**
     * 支付 API 5.3 解约回调入口。
     *
     * @param requestBody 支付中心原始回调报文
     * @return 回调接收处理结果
     */
    @PostMapping("/receiveTerminationResult")
    public PaySignCallbackResult receiveTerminationResult(@RequestBody String requestBody) {
        ReceiveTerminationResultReqDTO bizData = parseCallbackBody(requestBody, ReceiveTerminationResultReqDTO.class);
        return bizData == null ? invalidCallback() : paySignAppService.receiveTerminationResult(bizData);
    }

    /**
     * 支付 API 5.1 支付回调入口。
     *
     * @param requestBody 支付中心原始回调报文
     * @return 回调接收处理结果
     */
    @PostMapping("/receivePayResult")
    public PaySignCallbackResult receivePayResult(@RequestBody String requestBody) {
        ReceivePayResultReqDTO bizData = parseCallbackBody(requestBody, ReceivePayResultReqDTO.class);
        return bizData == null ? invalidCallback() : paySignAppService.receivePayResult(bizData);
    }

    /**
     * 构造支付中心无法解析回调报文时的统一响应。
     */
    private PaySignCallbackResult invalidCallback() {
        PaySignCallbackResult result = new PaySignCallbackResult();
        result.setRetCode(FepAppErrorCodeEnum.INVALID_PARAM.getCode());
        result.setRetMsg("无效的参数");
        return result;
    }

    /**
     * 从支付中心回调中提取业务 DTO，兼容通用包装报文与根节点业务报文。
     */
    private <T> T parseCallbackBody(String requestBody, Class<T> targetType) {
        try {
            JSONObject root = JSON.parseObject(requestBody);
            Object bizData = root.get("bizData");
            if (bizData instanceof JSONObject) {
                return ((JSONObject) bizData).toJavaObject(targetType);
            }
            if (bizData instanceof String && !((String) bizData).trim().isEmpty()) {
                return parseEncodedBizData((String) bizData, targetType);
            }
            return root.toJavaObject(targetType);
        } catch (Exception exception) {
            log.error("解析支付回调失败", exception);
            return null;
        }
    }

    /**
     * 解析支付中心 Base64 编码或明文 JSON 形式的业务数据。
     */
    private <T> T parseEncodedBizData(String bizData, Class<T> targetType) {
        try {
            return JSON.parseObject(decodeBizData(bizData), targetType);
        } catch (Exception exception) {
            log.error("解析支付回调业务数据失败", exception);
            return null;
        }
    }

    private String decodeBizData(String bizData) {
        try {
            return new String(Base64.getDecoder().decode(bizData), StandardCharsets.UTF_8);
        } catch (IllegalArgumentException exception) {
            return bizData;
        }
    }
}
