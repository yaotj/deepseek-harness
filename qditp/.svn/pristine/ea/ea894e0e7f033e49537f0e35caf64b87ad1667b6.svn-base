package com.chinasofti.huateng.model.para;

import java.io.Serializable;
import java.util.Date;

public class TblStlTicketSet implements Serializable {
    private Integer ticketType;

    private String ticketName;

    private String issueId;

    private String cycleStlmtFlg;

    private String cardType;

    private String priceType;

    private String type1;

    private String type2;

    private String type3;

    private String type4;

    private String type5;

    private String useFlg;

    private String lastUpdId;

    private Date lastUpdTms;

    private static final long serialVersionUID = 1L;

    public Integer getTicketType() {
        return ticketType;
    }

    public void setTicketType(Integer ticketType) {
        this.ticketType = ticketType;
    }

    public String getTicketName() {
        return ticketName;
    }

    public void setTicketName(String ticketName) {
        this.ticketName = ticketName;
    }

    public String getIssueId() {
        return issueId;
    }

    public void setIssueId(String issueId) {
        this.issueId = issueId;
    }

    public String getCycleStlmtFlg() {
        return cycleStlmtFlg;
    }

    public void setCycleStlmtFlg(String cycleStlmtFlg) {
        this.cycleStlmtFlg = cycleStlmtFlg;
    }

    public String getCardType() {
        return cardType;
    }

    public void setCardType(String cardType) {
        this.cardType = cardType;
    }

    public String getPriceType() {
        return priceType;
    }

    public void setPriceType(String priceType) {
        this.priceType = priceType;
    }

    public String getType1() {
        return type1;
    }

    public void setType1(String type1) {
        this.type1 = type1;
    }

    public String getType2() {
        return type2;
    }

    public void setType2(String type2) {
        this.type2 = type2;
    }

    public String getType3() {
        return type3;
    }

    public void setType3(String type3) {
        this.type3 = type3;
    }

    public String getType4() {
        return type4;
    }

    public void setType4(String type4) {
        this.type4 = type4;
    }

    public String getType5() {
        return type5;
    }

    public void setType5(String type5) {
        this.type5 = type5;
    }

    public String getUseFlg() {
        return useFlg;
    }

    public void setUseFlg(String useFlg) {
        this.useFlg = useFlg;
    }

    public String getLastUpdId() {
        return lastUpdId;
    }

    public void setLastUpdId(String lastUpdId) {
        this.lastUpdId = lastUpdId;
    }

    public Date getLastUpdTms() {
        return lastUpdTms;
    }

    public void setLastUpdTms(Date lastUpdTms) {
        this.lastUpdTms = lastUpdTms;
    }
}