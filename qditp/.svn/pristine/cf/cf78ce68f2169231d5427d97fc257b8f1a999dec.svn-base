<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinasofti.huateng.alipay.paysign.mapper.AlipayTerminationRequestMapper">
    <resultMap id="AlipayTerminationRequestResultMap" type="com.chinasofti.huateng.alipay.paysign.entity.AlipayTerminationRequest">
        <id property="terminationSeq" column="TERMINATION_SEQ"/>
        <result property="agreementCode" column="AGREEMENT_CODE"/>
        <result property="thirdUserId" column="THIRD_USER_ID"/>
        <result property="cardId" column="CARD_ID"/>
        <result property="cardType" column="CARD_TYPE"/>
        <result property="channel" column="CHANNEL"/>
        <result property="merchantNo" column="MERCHANT_NO"/>
        <result property="operationType" column="OPERATION_TYPE"/>
        <result property="status" column="STATUS"/>
        <result property="terminationResult" column="TERMINATION_RESULT"/>
        <result property="terminationTime" column="TERMINATION_TIME"/>
        <result property="deleteFlag" column="DELETE_FLAG"/>
        <result property="version" column="VERSION"/>
        <result property="createTime" column="CREATE_TIME"/>
        <result property="updateTime" column="UPDATE_TIME"/>
    </resultMap>

    <select id="selectByAgreementCode" resultMap="AlipayTerminationRequestResultMap">
        SELECT * FROM ALIPAY_TERMINATION_REQUEST WHERE AGREEMENT_CODE = #{agreementCode,jdbcType=VARCHAR} AND DELETE_FLAG = '0'
    </select>

    <insert id="insert" parameterType="com.chinasofti.huateng.model.alipaytrip.AlipayTerminationRequest" useGeneratedKeys="false">
        INSERT INTO ALIPAY_TERMINATION_REQUEST (
            TERMINATION_SEQ, AGREEMENT_CODE, THIRD_USER_ID, CARD_ID, CARD_TYPE, CHANNEL,
            OPERATION_TYPE, STATUS, TERMINATION_RESULT, TERMINATION_TIME,
            DELETE_FLAG, VERSION, CREATE_TIME, UPDATE_TIME, MERCHANT_NO
        ) VALUES (
            #{terminationSeq,jdbcType=VARCHAR}, #{agreementCode,jdbcType=VARCHAR}, #{thirdUserId,jdbcType=VARCHAR}, #{cardId,jdbcType=VARCHAR}, #{cardType,jdbcType=VARCHAR}, #{channel,jdbcType=VARCHAR},
            #{operationType,jdbcType=VARCHAR}, #{status,jdbcType=VARCHAR}, #{terminationResult,jdbcType=VARCHAR}, #{terminationTime,jdbcType=TIMESTAMP},
            #{deleteFlag,jdbcType=VARCHAR}, #{version,jdbcType=VARCHAR}, #{createTime,jdbcType=TIMESTAMP}, #{updateTime,jdbcType=TIMESTAMP}, #{merchantNo,jdbcType=VARCHAR}
        )
    </insert>

    <update id="updateStatus">
        UPDATE ALIPAY_TERMINATION_REQUEST
        SET STATUS = #{status,jdbcType=VARCHAR}, UPDATE_TIME = #{updateTime,jdbcType=TIMESTAMP}
        WHERE AGREEMENT_CODE = #{agreementCode,jdbcType=VARCHAR} AND DELETE_FLAG = '0'
    </update>
</mapper>
