package com.chinasofti.huateng.acc.es.server.enumns;

public enum TaskAssignStat {
    UN_ASSIGNED("0","未分配"),ASSIGNED("1","已分配");

    private String code;
    private String label;

    private TaskAssignStat(String code,String label) {
        this.code = code;
        this.label = label;
    }

    public String code() {
        return this.code;
    }

    public String label() {
        return this.label;
    }
}
