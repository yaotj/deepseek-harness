server.port=9098
spring.application.name=collect-ticket

other.web.unSafeUrlChars=null
other.web.enableLogRequestInFilter=true
other.web.enableBodyCacheFilter=true
other.web.enableLogTakeTimesInInterceptor=true

knife4j.production=true

service.token.url=
service.token.openLogger=true

server.tomcat.basedir=/Users/zhoucong/logs
logging.file.path=/Users/zhoucong/logs

service.route.mapping.default=
collect.ticket.buy-single-ticket-max-num=10
collect.ticket.default-ticket-price=0
