package com.chinasofti.huateng.dailyticket.model;

import java.util.Date;

/**
 * 日票票实例内部模型。
 */
public class DailyTicketInstance {
    /**
     * 主键ID。
     */
    private String id;

    /**
     * 关联日票订单号。
     */
    private String orderNo;

    /**
     * 第三方用户编号。
     */
    private String thirdUserId;

    /**
     * 日票虚拟卡号。
     */
    private String cardNum;

    /**
     * 发卡机构代码。
     */
    private String cardIssue;

    /**
     * APP侧卡类型。
     */
    private String appCardType;

    /**
     * 码体车票类型，日票生码固定写0441。
     */
    private String codeTicketType;

    /**
     * APP侧票类型。
     */
    private String ticketType;

    /**
     * 展示票类型。
     */
    private String showType;

    /**
     * 车票编码。
     */
    private String ticketCode;

    /**
     * 车票名称。
     */
    private String ticketName;

    /**
     * 有效期天数。
     */
    private Integer period;

    /**
     * 实际可用次数，-99表示不限次。
     */
    private Integer actualTimes;

    /**
     * 交易序号。
     */
    private Integer transSeq;

    /**
     * 交易金额，单位分。
     */
    private Integer transAmount;

    /**
     * 优惠金额，单位分。
     */
    private Integer discountAmount;

    /**
     * 支付渠道。
     */
    private String payChannel;

    /**
     * 计次/计时开始时间，毫秒时间戳。
     */
    private Long countingStart;

    /**
     * 计次/计时结束时间，毫秒时间戳。
     */
    private Long countingEnd;

    /**
     * 票实例状态。
     */
    private String ticketStatus;

    /**
     * ACC通知状态。
     */
    private String accNoticeStatus;

    /**
     * 激活时间。
     */
    private Date activateTime;

    /**
     * 首次使用时间。
     */
    private Date firstUseTime;

    /**
     * ACC通知时间。
     */
    private Date accNoticeTime;

    /**
     * 创建时间。
     */
    private Date createTime;

    /**
     * 更新时间。
     */
    private Date updateTime;

    public String getId() {
        return id;
    }

    public void setId(String id) {
        this.id = id;
    }

    public String getOrderNo() {
        return orderNo;
    }

    public void setOrderNo(String orderNo) {
        this.orderNo = orderNo;
    }

    public String getThirdUserId() {
        return thirdUserId;
    }

    public void setThirdUserId(String thirdUserId) {
        this.thirdUserId = thirdUserId;
    }

    public String getCardNum() {
        return cardNum;
    }

    public void setCardNum(String cardNum) {
        this.cardNum = cardNum;
    }

    public String getCardIssue() {
        return cardIssue;
    }

    public void setCardIssue(String cardIssue) {
        this.cardIssue = cardIssue;
    }

    public String getAppCardType() {
        return appCardType;
    }

    public void setAppCardType(String appCardType) {
        this.appCardType = appCardType;
    }

    public String getCodeTicketType() {
        return codeTicketType;
    }

    public void setCodeTicketType(String codeTicketType) {
        this.codeTicketType = codeTicketType;
    }

    public String getTicketType() {
        return ticketType;
    }

    public void setTicketType(String ticketType) {
        this.ticketType = ticketType;
    }

    public String getShowType() {
        return showType;
    }

    public void setShowType(String showType) {
        this.showType = showType;
    }

    public String getTicketCode() {
        return ticketCode;
    }

    public void setTicketCode(String ticketCode) {
        this.ticketCode = ticketCode;
    }

    public String getTicketName() {
        return ticketName;
    }

    public void setTicketName(String ticketName) {
        this.ticketName = ticketName;
    }

    public Integer getPeriod() {
        return period;
    }

    public void setPeriod(Integer period) {
        this.period = period;
    }

    public Integer getActualTimes() {
        return actualTimes;
    }

    public void setActualTimes(Integer actualTimes) {
        this.actualTimes = actualTimes;
    }

    public Integer getTransSeq() {
        return transSeq;
    }

    public void setTransSeq(Integer transSeq) {
        this.transSeq = transSeq;
    }

    public Integer getTransAmount() {
        return transAmount;
    }

    public void setTransAmount(Integer transAmount) {
        this.transAmount = transAmount;
    }

    public Integer getDiscountAmount() {
        return discountAmount;
    }

    public void setDiscountAmount(Integer discountAmount) {
        this.discountAmount = discountAmount;
    }

    public String getPayChannel() {
        return payChannel;
    }

    public void setPayChannel(String payChannel) {
        this.payChannel = payChannel;
    }

    public Long getCountingStart() {
        return countingStart;
    }

    public void setCountingStart(Long countingStart) {
        this.countingStart = countingStart;
    }

    public Long getCountingEnd() {
        return countingEnd;
    }

    public void setCountingEnd(Long countingEnd) {
        this.countingEnd = countingEnd;
    }

    public String getTicketStatus() {
        return ticketStatus;
    }

    public void setTicketStatus(String ticketStatus) {
        this.ticketStatus = ticketStatus;
    }

    public String getAccNoticeStatus() {
        return accNoticeStatus;
    }

    public void setAccNoticeStatus(String accNoticeStatus) {
        this.accNoticeStatus = accNoticeStatus;
    }

    public Date getActivateTime() {
        return activateTime;
    }

    public void setActivateTime(Date activateTime) {
        this.activateTime = activateTime;
    }

    public Date getFirstUseTime() {
        return firstUseTime;
    }

    public void setFirstUseTime(Date firstUseTime) {
        this.firstUseTime = firstUseTime;
    }

    public Date getAccNoticeTime() {
        return accNoticeTime;
    }

    public void setAccNoticeTime(Date accNoticeTime) {
        this.accNoticeTime = accNoticeTime;
    }

    public Date getCreateTime() {
        return createTime;
    }

    public void setCreateTime(Date createTime) {
        this.createTime = createTime;
    }

    public Date getUpdateTime() {
        return updateTime;
    }

    public void setUpdateTime(Date updateTime) {
        this.updateTime = updateTime;
    }
}
