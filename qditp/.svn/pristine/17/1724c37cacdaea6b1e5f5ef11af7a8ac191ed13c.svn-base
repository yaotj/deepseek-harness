CREATE TABLE METRO_CA_KEYSTORE
(
    ID                 NUMBER(22) NOT NULL,
    KEY_IDX            VARCHAR2(8),
    KEY_PRIVATE        VARCHAR2(512),
    KEY_PUBLIC         VARCHAR2(512),
    KEY_EFFECTIVE_DATE VARCHAR2(40),
    KEY_STATUS         NUMBER(22),
    MANAGER_ID         VARCHAR2(40),
    RESERVE            VARCHAR2(200),
    REMARK             VARCHAR2(200),
    UPDATE_DATE        TIMESTAMP(6),
    REG_DATE           TIMESTAMP(6) NOT NULL,
    KEY_PAIR           VARCHAR2(2048),
    CONSTRAINT PK_METRO_CA_KEYSTORE PRIMARY KEY (ID)
);

COMMENT ON TABLE METRO_CA_KEYSTORE IS '地铁会CA密钥仓库';
COMMENT ON COLUMN METRO_CA_KEYSTORE.ID IS '主键';
COMMENT ON COLUMN METRO_CA_KEYSTORE.KEY_IDX IS 'ITP密钥索引';
COMMENT ON COLUMN METRO_CA_KEYSTORE.KEY_PRIVATE IS 'ITP私钥';
COMMENT ON COLUMN METRO_CA_KEYSTORE.KEY_PUBLIC IS 'ITP公钥';
COMMENT ON COLUMN METRO_CA_KEYSTORE.KEY_EFFECTIVE_DATE IS '有效期';
COMMENT ON COLUMN METRO_CA_KEYSTORE.KEY_STATUS IS '状态：0初始化，1使用，2暂停';
COMMENT ON COLUMN METRO_CA_KEYSTORE.MANAGER_ID IS '管理员编码';
COMMENT ON COLUMN METRO_CA_KEYSTORE.RESERVE IS '预留字段';
COMMENT ON COLUMN METRO_CA_KEYSTORE.REMARK IS '备注';
COMMENT ON COLUMN METRO_CA_KEYSTORE.UPDATE_DATE IS '修改日期';
COMMENT ON COLUMN METRO_CA_KEYSTORE.REG_DATE IS '注册日期';
COMMENT ON COLUMN METRO_CA_KEYSTORE.KEY_PAIR IS 'SM2密钥对';

CREATE INDEX IDX_METRO_CA_KEYSTORE_STATUS ON METRO_CA_KEYSTORE (KEY_STATUS);
CREATE INDEX IDX_METRO_CA_KEYSTORE_KEYIDX ON METRO_CA_KEYSTORE (KEY_IDX);

CREATE TABLE METRO_MEMBER_STATIC_KEY
(
    ID                    NUMBER(22) NOT NULL,
    METRO_MEMBER_CARD_NUM VARCHAR2(32) NOT NULL,
    KEY_WRAP_VALUE1       VARCHAR2(512) NOT NULL,
    KEY_STATUS            NUMBER(22) DEFAULT 1 NOT NULL,
    UPDATE_DATE           TIMESTAMP(6),
    REG_DATE              TIMESTAMP(6) NOT NULL,
    CONSTRAINT PK_METRO_MEMBER_STATIC_KEY PRIMARY KEY (ID),
    CONSTRAINT UK_METRO_MEMBER_STATIC_KEY_CARD UNIQUE (METRO_MEMBER_CARD_NUM)
);

CREATE SEQUENCE SEQ_METRO_MEMBER_STATIC_KEY START WITH 1 INCREMENT BY 1 NOCACHE;

COMMENT ON TABLE METRO_MEMBER_STATIC_KEY IS 'HCE会员卡静态密钥缓存';
COMMENT ON COLUMN METRO_MEMBER_STATIC_KEY.METRO_MEMBER_CARD_NUM IS 'HCE逻辑卡号';
COMMENT ON COLUMN METRO_MEMBER_STATIC_KEY.KEY_WRAP_VALUE1 IS 'ACC KEK加密的DPK';
COMMENT ON COLUMN METRO_MEMBER_STATIC_KEY.KEY_STATUS IS '状态：1启用，2停用';
COMMENT ON COLUMN METRO_MEMBER_STATIC_KEY.UPDATE_DATE IS '修改日期';
COMMENT ON COLUMN METRO_MEMBER_STATIC_KEY.REG_DATE IS '注册日期';
