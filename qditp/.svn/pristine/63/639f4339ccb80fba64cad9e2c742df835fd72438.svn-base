server.port=9098
spring.application.name=account

#?????? ???IP
#other.sql.host=172.20.222.3:1521
#?????? ???IP
other.sql.host=${DB_HOST:127.0.0.1:1521}
other.sql.double-datasource=false
other.sql.type=oracle
other.sql.page.type=oracle
other.sql.database=${DB_NAME:orcl}
other.sql.username=${DB_USERNAME:}
other.sql.password=${DB_PASSWORD:}

other.web.unSafeUrlChars=null
other.web.enableLogRequestInFilter=true
other.web.enableBodyCacheFilter=true
other.web.enableLogTakeTimesInInterceptor=true

knife4j.production=true


service.ticket.openLogger=true
service.ticket.url=http://127.0.0.1:9103


mybatis.mapper-locations=classpath*:mapper/*.xml

account.card-pool.threshold=10
account.card-pool.batch-size=20


account.card-pool.debug-manual-allocate=true
account.card-pool.debug-manual-card-id=9900000000000001

itp.providerId=01
itp.charset=UTF-8
itp.format=json
itp.signKey=bc4f7c96259acf9946094fa
