package com.chinasofti.huateng.para.entity.ticket;

import java.time.LocalDateTime;

public class TotalSalePart {
    private Long paraVerNo;
    private Integer ticketType;
    private Integer partSeqNo;
    private Integer beginTotalSale;
    private Integer endTotalSale;
    private Integer saleRatio;
    private String lastUpdUser;
    private LocalDateTime lastUpdTms;

    public Long getParaVerNo() { return paraVerNo; }
    public void setParaVerNo(Long paraVerNo) { this.paraVerNo = paraVerNo; }
    public Integer getTicketType() { return ticketType; }
    public void setTicketType(Integer ticketType) { this.ticketType = ticketType; }
    public Integer getPartSeqNo() { return partSeqNo; }
    public void setPartSeqNo(Integer partSeqNo) { this.partSeqNo = partSeqNo; }
    public Integer getBeginTotalSale() { return beginTotalSale; }
    public void setBeginTotalSale(Integer beginTotalSale) { this.beginTotalSale = beginTotalSale; }
    public Integer getEndTotalSale() { return endTotalSale; }
    public void setEndTotalSale(Integer endTotalSale) { this.endTotalSale = endTotalSale; }
    public Integer getSaleRatio() { return saleRatio; }
    public void setSaleRatio(Integer saleRatio) { this.saleRatio = saleRatio; }
    public String getLastUpdUser() { return lastUpdUser; }
    public void setLastUpdUser(String lastUpdUser) { this.lastUpdUser = lastUpdUser; }
    public LocalDateTime getLastUpdTms() { return lastUpdTms; }
    public void setLastUpdTms(LocalDateTime lastUpdTms) { this.lastUpdTms = lastUpdTms; }

    @Override
    public String toString() {
        return "TotalSalePart{" +
                "paraVerNo=" + paraVerNo +
                ", ticketType=" + ticketType +
                ", partSeqNo=" + partSeqNo +
                ", beginTotalSale=" + beginTotalSale +
                ", endTotalSale=" + endTotalSale +
                ", saleRatio=" + saleRatio +
                ", lastUpdUser='" + lastUpdUser + '\'' +
                ", lastUpdTms=" + lastUpdTms +
                '}';
    }
}
