<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinasofti.huateng.para.mapper.network.ZoneInfoMapper">
    <delete id="deleteByParaVerNo">
        DELETE FROM TBL_ZONE_INFO WHERE PARA_VER_NO = #{paraVerNo,jdbcType=NUMERIC}
    </delete>

    <insert id="insertBatch">
        INSERT ALL
        <foreach collection="list" item="item">
            INTO TBL_ZONE_INFO (PARA_VER_NO, ZONE_NO, ZONE_NAME, ZONE_E_NAME)
            VALUES (#{item.paraVerNo,jdbcType=NUMERIC}, #{item.zoneNo,jdbcType=NUMERIC},
                    #{item.zoneName,jdbcType=VARCHAR}, #{item.zoneEName,jdbcType=VARCHAR})
        </foreach>
        SELECT 1 FROM DUAL
    </insert>
</mapper>
