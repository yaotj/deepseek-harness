package com.chinasofti.huateng.fep.dev.model;

import com.chinasofti.huateng.model.agm.AgmKeyItemDTO;

import java.util.List;

/**
 * IF1A-02 密钥同步响应-密钥当前版本信息。
 */
public class KeyCurVerRespDTO {

    private String issueChannelCode;
    private String keyId;
    private String keyBathNumber;
    private String needUpdateYN;
    private List<AgmKeyItemDTO> keyList;

    public String getIssueChannelCode() {
        return issueChannelCode;
    }

    public void setIssueChannelCode(String issueChannelCode) {
        this.issueChannelCode = issueChannelCode;
    }

    public String getKeyId() {
        return keyId;
    }

    public void setKeyId(String keyId) {
        this.keyId = keyId;
    }

    public String getKeyBathNumber() {
        return keyBathNumber;
    }

    public void setKeyBathNumber(String keyBathNumber) {
        this.keyBathNumber = keyBathNumber;
    }

    public String getNeedUpdateYN() {
        return needUpdateYN;
    }

    public void setNeedUpdateYN(String needUpdateYN) {
        this.needUpdateYN = needUpdateYN;
    }

    public List<AgmKeyItemDTO> getKeyList() {
        return keyList;
    }

    public void setKeyList(List<AgmKeyItemDTO> keyList) {
        this.keyList = keyList;
    }
}
