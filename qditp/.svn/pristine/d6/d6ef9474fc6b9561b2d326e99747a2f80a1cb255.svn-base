package com.chinasofti.huateng.model.frs.vo;

import java.util.ArrayList;
import java.util.List;

public class VerNoRuntimeVO {
	Integer paraVerNo;
	List<String> runtimeInters = new ArrayList<String>();
	public Integer getParaVerNo() {
		return paraVerNo;
	}
	public void setParaVerNo(Integer paraVerNo) {
		this.paraVerNo = paraVerNo;
	}
	public List<String> getRuntimeInters() {
		return runtimeInters;
	}
	public void setRuntimeInters(List<String> runtimeInters) {
		this.runtimeInters = runtimeInters;
	}	
}
