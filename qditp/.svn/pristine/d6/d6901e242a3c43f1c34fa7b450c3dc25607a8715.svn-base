package com.chinasofti.huateng.model.frs.vo;

import com.chinasofti.huateng.model.frs.RulStationInfoDTO;

public class StationInfoVO {
	String preStationCode;
	
	RulStationInfoDTO stationInfo;

	public String getPreStationCode() {
		return preStationCode;
	}

	public void setPreStationCode(String preStationCode) {
		this.preStationCode = preStationCode;
	}

	public RulStationInfoDTO getStationInfo() {
		return stationInfo;
	}

	public void setStationInfo(RulStationInfoDTO stationInfo) {
		this.stationInfo = stationInfo;
	}

	
	
}
