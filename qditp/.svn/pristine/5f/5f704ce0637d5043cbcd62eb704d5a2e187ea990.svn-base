server.port=9011

spring.application.name=acc-es

#?????? ???IP
#other.sql.host=172.20.222.3:1521
#?????? ???IP
other.sql.host=${DB_HOST:127.0.0.1:1521}
other.sql.double-datasource=false
other.sql.type=oracle
other.sql.page.type=oracle
other.sql.database=${DB_NAME:orcl}
other.sql.username=${DB_USERNAME:}
other.sql.password=${DB_PASSWORD:}

logging.level.com.chinasofti.huateng.acc.es.manage.server.mapper=debug
logging.file.path=logs/acc-es

other.web.unSafeUrlChars=null
other.web.enableLogRequestInFilter=true
other.web.enableBodyCacheFilter=true
other.web.enableLogTakeTimesInInterceptor=true

knife4j.production=false


ftp.ip=${FTP_IP:127.0.0.1}
ftp.username=${FTP_USERNAME:}
ftp.password=${FTP_PASSWORD:}
ftp.port=21
ftp.report-target-dir=upload/
ftp.report-local-dir=d://
ftp.excel-dir=d://
ftp.custom-local-dir=d://
ftp.custom-target-dir=download/

mybatis.mapper-locations=classpath:mapper/*Mapper.xml
mybatis.configuration.log-impl=org.apache.ibatis.logging.stdout.StdOutImpl
mybatis.configuration.map-underscore-to-camel-case=true

pageConfig.defaultSize=10

pagehelper.helper-dialect=oracle
pagehelper.reasonable=true
pagehelper.params=count=countSql

netty.port=5000

excel-path=excels/


