package com.chinasofti.huateng.model.app;

/**
 * IF8A-29 用户行程信息对象。
 */
public class MemberItineraryDTO {
    private String payStatus;
    private String thisStationName;
    private String thisTransTime;
    private String thisStationCode;
    private String lastStationName;
    private String lastTransTime;
    private String lastStationCode;
    private String transSeq;
    private Integer transValue;
    private Integer overtimeTransValue;
    private String ticketStatus;
    private String payChannel;
    private Integer oriTicketAmt;
    private Integer debitAmt;
    private Integer orderExpType;
    private String discountInfo;
    private String orderNo;
    private Integer carbonDiscount;

    public String getPayStatus() {
        return payStatus;
    }

    public void setPayStatus(String payStatus) {
        this.payStatus = payStatus;
    }

    public String getThisStationName() {
        return thisStationName;
    }

    public void setThisStationName(String thisStationName) {
        this.thisStationName = thisStationName;
    }

    public String getThisTransTime() {
        return thisTransTime;
    }

    public void setThisTransTime(String thisTransTime) {
        this.thisTransTime = thisTransTime;
    }

    public String getThisStationCode() {
        return thisStationCode;
    }

    public void setThisStationCode(String thisStationCode) {
        this.thisStationCode = thisStationCode;
    }

    public String getLastStationName() {
        return lastStationName;
    }

    public void setLastStationName(String lastStationName) {
        this.lastStationName = lastStationName;
    }

    public String getLastTransTime() {
        return lastTransTime;
    }

    public void setLastTransTime(String lastTransTime) {
        this.lastTransTime = lastTransTime;
    }

    public String getLastStationCode() {
        return lastStationCode;
    }

    public void setLastStationCode(String lastStationCode) {
        this.lastStationCode = lastStationCode;
    }

    public String getTransSeq() {
        return transSeq;
    }

    public void setTransSeq(String transSeq) {
        this.transSeq = transSeq;
    }

    public Integer getTransValue() {
        return transValue;
    }

    public void setTransValue(Integer transValue) {
        this.transValue = transValue;
    }

    public Integer getOvertimeTransValue() {
        return overtimeTransValue;
    }

    public void setOvertimeTransValue(Integer overtimeTransValue) {
        this.overtimeTransValue = overtimeTransValue;
    }

    public String getTicketStatus() {
        return ticketStatus;
    }

    public void setTicketStatus(String ticketStatus) {
        this.ticketStatus = ticketStatus;
    }

    public String getPayChannel() {
        return payChannel;
    }

    public void setPayChannel(String payChannel) {
        this.payChannel = payChannel;
    }

    public Integer getOriTicketAmt() {
        return oriTicketAmt;
    }

    public void setOriTicketAmt(Integer oriTicketAmt) {
        this.oriTicketAmt = oriTicketAmt;
    }

    public Integer getDebitAmt() {
        return debitAmt;
    }

    public void setDebitAmt(Integer debitAmt) {
        this.debitAmt = debitAmt;
    }

    public Integer getOrderExpType() {
        return orderExpType;
    }

    public void setOrderExpType(Integer orderExpType) {
        this.orderExpType = orderExpType;
    }

    public String getDiscountInfo() {
        return discountInfo;
    }

    public void setDiscountInfo(String discountInfo) {
        this.discountInfo = discountInfo;
    }

    public String getOrderNo() {
        return orderNo;
    }

    public void setOrderNo(String orderNo) {
        this.orderNo = orderNo;
    }

    public Integer getCarbonDiscount() {
        return carbonDiscount;
    }

    public void setCarbonDiscount(Integer carbonDiscount) {
        this.carbonDiscount = carbonDiscount;
    }
}
