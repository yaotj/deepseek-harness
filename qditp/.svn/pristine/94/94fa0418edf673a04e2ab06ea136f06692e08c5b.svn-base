<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinasofti.huateng.para.mapper.network.LineInfoMapper">
    <delete id="deleteByParaVerNo">
        DELETE FROM TBL_LINE_INFO WHERE PARA_VER_NO = #{paraVerNo,jdbcType=NUMERIC}
    </delete>

    <insert id="insertBatch">
        INSERT ALL
        <foreach collection="list" item="item">
            INTO TBL_LINE_INFO (PARA_VER_NO, LINE_CODE, LINE_NM, LINE_E_NM)
            VALUES (#{item.paraVerNo,jdbcType=NUMERIC}, #{item.lineCode,jdbcType=VARCHAR},
                    #{item.lineNm,jdbcType=VARCHAR}, #{item.lineENm,jdbcType=VARCHAR})
        </foreach>
        SELECT 1 FROM DUAL
    </insert>

    <select id="selectByParaVerNo" resultType="com.chinasofti.huateng.para.entity.network.LineInfo">
        SELECT PARA_VER_NO paraVerNo,
               LINE_CODE lineCode,
               LINE_NM lineNm,
               LINE_E_NM lineENm
        FROM TBL_LINE_INFO
        WHERE PARA_VER_NO = #{paraVerNo,jdbcType=NUMERIC}
        ORDER BY LINE_CODE
    </select>
</mapper>
