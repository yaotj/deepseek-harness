<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinasofti.huateng.para.mapper.network.StationInfoMapper">
    <delete id="deleteByParaVerNo">
        DELETE FROM TBL_STATION_INFO WHERE PARA_VER_NO = #{paraVerNo,jdbcType=NUMERIC}
    </delete>

    <insert id="insertBatch">
        INSERT ALL
        <foreach collection="list" item="item">
            INTO TBL_STATION_INFO (
                PARA_VER_NO, STATION_CODE, OWNER_LINE_ID, OWNER_INCOME_ID,
                STATION_TYPE, STATION_NM, STATION_E_NM
            )
            VALUES (
                #{item.paraVerNo,jdbcType=NUMERIC}, #{item.stationCode,jdbcType=VARCHAR},
                #{item.ownerLineId,jdbcType=VARCHAR}, #{item.ownerIncomeId,jdbcType=VARCHAR},
                #{item.stationType,jdbcType=VARCHAR}, #{item.stationNm,jdbcType=VARCHAR},
                #{item.stationENm,jdbcType=VARCHAR}
            )
        </foreach>
        SELECT 1 FROM DUAL
    </insert>

    <select id="selectByParaVerNo" resultType="com.chinasofti.huateng.para.entity.network.StationInfo">
        SELECT s.PARA_VER_NO paraVerNo,
               s.STATION_CODE stationCode,
               s.OWNER_LINE_ID ownerLineId,
               s.OWNER_INCOME_ID ownerIncomeId,
               s.STATION_TYPE stationType,
               s.STATION_NM stationNm,
               s.STATION_E_NM stationENm,
               CASE WHEN EXISTS (
                   SELECT 1
                   FROM TBL_TSF_INFO t
                   WHERE t.PARA_VER_NO = s.PARA_VER_NO
                     AND (t.FROM_STAT_CODE = s.STATION_CODE OR t.TO_STAT_CODE = s.STATION_CODE)
               ) THEN 'Y' ELSE 'N' END transferYn
        FROM TBL_STATION_INFO s
        WHERE s.PARA_VER_NO = #{paraVerNo,jdbcType=NUMERIC}
        ORDER BY s.OWNER_LINE_ID, s.STATION_CODE
    </select>
</mapper>
