--
-- SELECT *
-- FROM PAY_TXN_DETAIL
-- WHERE PAY_STATUS IN ('FAIL', 'RETRY')
--   AND REQUEST_COUNT < :maxRequestCount
--   AND (NEXT_REQUEST_TIME IS NULL OR NEXT_REQUEST_TIME <= SYSTIMESTAMP)
-- ORDER BY NEXT_REQUEST_TIME NULLS FIRST, UPDATE_TIME;
