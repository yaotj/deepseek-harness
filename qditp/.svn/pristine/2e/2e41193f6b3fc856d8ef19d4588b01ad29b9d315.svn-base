<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.chinasofti.huateng.acc.es.server.mapper.TblTktTaskPlanMapper" >
    <resultMap id="BaseMap" type="com.chinasofti.huateng.acc.es.server.model.TblTktTaskPlan">
        <id column="PLAN_NO" property="planNo" jdbcType="NUMERIC"/>
        <result column="TASK_TYPE" property="taskType" jdbcType="VARCHAR"/>
        <result column="TICKET_MAIN_TYPE" property="ticketMainType" jdbcType="NUMERIC"/>
        <result column="TICKET_TYPE" property="ticketType" jdbcType="NUMERIC"/>
        <result column="TICKET_SUB_TYPE" property="ticketSubType" jdbcType="NUMERIC"/>
