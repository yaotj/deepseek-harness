            </if>
            <if test="initAmt != null">
                INIT_AMT = #{initAmt,jdbcType=DECIMAL},
            </if>
            <if test="planTms != null">
                PLAN_TMS = SYSDATE,
            </if>
            <if test="taskPlanStat != null">
                TASK_PLAN_STAT = #{taskPlanStat,jdbcType=VARCHAR},
            </if>
