            </if>
            <if test="lastUpdTms != null">
                LAST_UPD_TMS = SYSDATE,
            </if>
        </set>
        where PLAN_NO = #{planNo,jdbcType=VARCHAR}
    </update>
    <update id="updateByPrimaryKey" parameterType="com.chinasofti.huateng.acc.es.server.model.TblTktTaskPlan">
    update TBL_TKT_TASK_PLAN
    set TASK_TYPE = #{taskType,jdbcType=VARCHAR},
      TICKET_MAIN_TYPE = #{ticketMainType,jdbcType=DECIMAL},
      TICKET_TYPE = #{ticketType,jdbcType=DECIMAL},
      TICKET_SUB_TYPE = #{ticketSubType,jdbcType=DECIMAL},
      PLAN_NUM = #{planNum,jdbcType=DECIMAL},
      ACT_NUM = #{actNum,jdbcType=DECIMAL},
      ASSIGN_NUM = #{assignNum,jdbcType=DECIMAL},
      INIT_AMT = #{initAmt,jdbcType=DECIMAL},
      PLAN_TMS = SYSDATE,
      TASK_PLAN_STAT = '01',
      LAST_UPD_ID = #{lastUpdId,jdbcType=VARCHAR},
      LAST_UPD_TMS = SYSDATE,
