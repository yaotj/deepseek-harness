    PARTITION P_19 VALUES ('19'),
    PARTITION P_20 VALUES ('20'),
    PARTITION P_21 VALUES ('21'),
    PARTITION P_22 VALUES ('22'),
    PARTITION P_23 VALUES ('23'),
    PARTITION P_24 VALUES ('24'),
    PARTITION P_25 VALUES ('25'),
