    PARTITION P_99 VALUES ('99'),
    PARTITION P_OTHER VALUES (DEFAULT)
);

COMMENT ON TABLE QRCODE_STATUS IS '二维码状态表';

COMMENT ON COLUMN QRCODE_STATUS.CARD_ID IS '二维码卡号';
COMMENT ON COLUMN QRCODE_STATUS.USE_COUNT IS '使用次数';
COMMENT ON COLUMN QRCODE_STATUS.CHANNEL IS '渠道';
COMMENT ON COLUMN QRCODE_STATUS.CODE_STATUS IS '二维码状态';
COMMENT ON COLUMN QRCODE_STATUS.GATE_IN_TIME IS '进站时间，格式为yyyymmddhh24miss';
COMMENT ON COLUMN QRCODE_STATUS.GATE_IN_STATION IS '进站车站';
COMMENT ON COLUMN QRCODE_STATUS.LAST_TXN_TIME IS '最后交易时间，格式为yyyymmddhh24miss';
COMMENT ON COLUMN QRCODE_STATUS.LAST_TXN_STATION IS '最后交易车站';
COMMENT ON COLUMN QRCODE_STATUS.TXN_SEQ IS '交易流水号';
COMMENT ON COLUMN QRCODE_STATUS.CREATE_TIME IS '创建时间';
COMMENT ON COLUMN QRCODE_STATUS.UPDATE_TIME IS '更新时间';
COMMENT ON COLUMN QRCODE_STATUS.GATE_STATUS IS '进出站状态';
COMMENT ON COLUMN QRCODE_STATUS.CARD_ID_TAIL IS 'CARD_ID后两位，作为分区键的虚拟列';

CREATE UNIQUE INDEX UK_QR_CODE_STATUS_CARD
    ON QRCODE_STATUS (CARD_ID, CARD_ID_TAIL)
    LOCAL;
