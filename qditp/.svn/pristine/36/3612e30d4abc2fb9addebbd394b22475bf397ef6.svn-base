<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinasofti.huateng.collectpay.mapper.BomBusResultMapper">
    <resultMap id="BaseResultMap" type="com.chinasofti.huateng.collectpay.entity.BomBusResult">
        <id column="NOTIFY_ID" jdbcType="VARCHAR" property="notifyId"/>
        <result column="ORDER_NO" jdbcType="VARCHAR" property="orderNo"/>
        <result column="DEVICE_ID" jdbcType="VARCHAR" property="deviceId"/>
        <result column="OPT_RESULT" jdbcType="VARCHAR" property="optResult"/>
        <result column="REFUND_ORDER_NO" jdbcType="VARCHAR" property="refundOrderNo"/>
        <result column="CREATE_TIME" jdbcType="VARCHAR" property="createTime"/>
        <result column="UPDATE_TIME" jdbcType="VARCHAR" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        NOTIFY_ID, ORDER_NO, DEVICE_ID, OPT_RESULT,  REFUND_ORDER_NO,
        CREATE_TIME, UPDATE_TIME
    </sql>

    <select id="selectByNotifyId" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from TBL_BOM_BUS_RESULT
        where NOTIFY_ID = #{notifyId,jdbcType=VARCHAR}
    </select>

    <select id="selectByOrderNo" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from TBL_BOM_BUS_RESULT
        where ORDER_NO = #{orderNo,jdbcType=VARCHAR}
    </select>

    <insert id="insert" parameterType="com.chinasofti.huateng.collectpay.entity.BomBusResult">
        insert into TBL_BOM_BUS_RESULT (
            NOTIFY_ID, ORDER_NO, DEVICE_ID, OPT_RESULT,  REFUND_ORDER_NO,
            CREATE_TIME, UPDATE_TIME
        ) values (
            #{notifyId,jdbcType=VARCHAR},
            #{orderNo,jdbcType=VARCHAR},
            #{deviceId,jdbcType=VARCHAR},
            #{optResult,jdbcType=VARCHAR},
            #{refundOrderNo,jdbcType=VARCHAR},
            #{createTime,jdbcType=VARCHAR},
            #{updateTime,jdbcType=VARCHAR}
        )
    </insert>

    <update id="updateByNotifyId" parameterType="java.util.Map">
        update TBL_BOM_BUS_RESULT
        <set>
            <if test="optResult != null">OPT_RESULT = #{optResult,jdbcType=VARCHAR},</if>
            <if test="refundOrderNo != null">REFUND_ORDER_NO = #{refundOrderNo,jdbcType=VARCHAR},</if>
            <if test="updateTime != null">UPDATE_TIME = #{updateTime,jdbcType=VARCHAR},</if>
        </set>
        where NOTIFY_ID = #{notifyId,jdbcType=VARCHAR}
    </update>
</mapper>