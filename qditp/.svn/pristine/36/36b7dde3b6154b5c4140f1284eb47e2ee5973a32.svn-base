package com.chinasofti.huateng.model.autoclear;


import java.io.Serializable;

public class TblTxnInfo implements Serializable {
    private static final long serialVersionUID = -9015379094013368153L;

    private String tradeType;

    private String ticketMainType;

    private String ticketType;

    private String ticketId;

    private String txnTms;

    private Integer txnAmt;

    private String curStation;

    private String devNodeId;

    private Long devSeq;

    private Integer dtlStat;

    public String getTradeType() {
        return tradeType;
    }

    public void setTradeType(String tradeType) {
        this.tradeType = tradeType;
    }

    public String getTicketMainType() {
        return ticketMainType;
    }

    public void setTicketMainType(String ticketMainType) {
        this.ticketMainType = ticketMainType;
    }

    public String getTicketType() {
        return ticketType;
    }

    public void setTicketType(String ticketType) {
        this.ticketType = ticketType;
    }

    public String getTicketId() {
        return ticketId;
    }

    public void setTicketId(String ticketId) {
        this.ticketId = ticketId;
    }

    public String getTxnTms() {
        return txnTms;
    }

    public void setTxnTms(String txnTms) {
        this.txnTms = txnTms;
    }

    public Integer getTxnAmt() {
        return txnAmt;
    }

    public void setTxnAmt(Integer txnAmt) {
        this.txnAmt = txnAmt;
    }

    public String getCurStation() {
        return curStation;
    }

    public void setCurStation(String curStation) {
        this.curStation = curStation;
    }

    public String getDevNodeId() {
        return devNodeId;
    }

    public void setDevNodeId(String devNodeId) {
        this.devNodeId = devNodeId;
    }

    public Long getDevSeq() {
        return devSeq;
    }

    public void setDevSeq(Long devSeq) {
        this.devSeq = devSeq;
    }

    public Integer getDtlStat() {
        return dtlStat;
    }

    public void setDtlStat(Integer dtlStat) {
        this.dtlStat = dtlStat;
    }
}