package com.chinasofti.huateng.account.entity;

import java.time.LocalDateTime;

/**
 * User_ITP_Reg_log 用户注册日志表实体。
 */
public class UserItpRegLog {
    /**
     * 主键。
     */
    private Integer id;

    /**
     * 逻辑卡号。
     */
    private String cardId;

    /**
     * 卡类型。
     */
    private String cardType;

    /**
     * 第三方用户编码。
     */
    private String thirdUserId;

    /**
     * 手机号。
     */
    private String msisdn;

    /**
     * 操作时间。
     */
    private LocalDateTime operDateTime;

    /**
     * 操作类型。
     */
    private Integer operType;

    public Integer getId() {
        return id;
    }

    public void setId(Integer id) {
        this.id = id;
    }

    public String getCardId() {
        return cardId;
    }

    public void setCardId(String cardId) {
        this.cardId = cardId;
    }

    public String getCardType() {
        return cardType;
    }

    public void setCardType(String cardType) {
        this.cardType = cardType;
    }

    public String getThirdUserId() {
        return thirdUserId;
    }

    public void setThirdUserId(String thirdUserId) {
        this.thirdUserId = thirdUserId;
    }

    public String getMsisdn() {
        return msisdn;
    }

    public void setMsisdn(String msisdn) {
        this.msisdn = msisdn;
    }

    public LocalDateTime getOperDateTime() {
        return operDateTime;
    }

    public void setOperDateTime(LocalDateTime operDateTime) {
        this.operDateTime = operDateTime;
    }

    public Integer getOperType() {
        return operType;
    }

    public void setOperType(Integer operType) {
        this.operType = operType;
    }
}
