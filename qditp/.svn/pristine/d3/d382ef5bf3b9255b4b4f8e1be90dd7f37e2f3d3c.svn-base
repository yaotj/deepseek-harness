CREATE TABLE APP_PAY_SIGN_INFO (
    REQUEST_SIGN_SEQ VARCHAR2(64 CHAR) NOT NULL,
    THIRD_USER_ID VARCHAR2(64 CHAR) NOT NULL,
    SIGN_STATUS VARCHAR2(16 CHAR),
    PAYMENT_VENDOR VARCHAR2(16 CHAR),
    CARD_ID VARCHAR2(64 CHAR),
    CARD_TYPE VARCHAR2(32 CHAR),
    PAY_ACCOUNT_ID VARCHAR2(64 CHAR),
    PAY_AGREEMENT_NO VARCHAR2(128 CHAR),
    DISPLAY_ACCOUNT VARCHAR2(128 CHAR),
    SIGN_TIME TIMESTAMP,
    TERMINATION_TIME TIMESTAMP,
    CONSTRAINT UK_APP_PAY_SIGN_INFO_USER_VENDOR UNIQUE (THIRD_USER_ID, PAYMENT_VENDOR)
);

CREATE INDEX IDX_APP_PAY_SIGN_INFO_USER_ID
    ON APP_PAY_SIGN_INFO (THIRD_USER_ID);

COMMENT ON TABLE APP_PAY_SIGN_INFO IS '免密签约主表';
COMMENT ON COLUMN APP_PAY_SIGN_INFO.REQUEST_SIGN_SEQ IS '签约请求流水号，标识一次签约请求的唯一流水';
COMMENT ON COLUMN APP_PAY_SIGN_INFO.THIRD_USER_ID IS '第三方用户ID，对应APP侧用户唯一标识';
COMMENT ON COLUMN APP_PAY_SIGN_INFO.SIGN_STATUS IS '签约状态，NOT_SIGNED未签约、SIGNING签约中、SIGNED已签约、UNSIGNED已解约';
COMMENT ON COLUMN APP_PAY_SIGN_INFO.PAYMENT_VENDOR IS '支付类型/支付厂商编码，如03支付宝、04微信、06建行龙支付、07云闪付、0B钱包';
COMMENT ON COLUMN APP_PAY_SIGN_INFO.CARD_ID IS '地铁会员卡号/逻辑卡号，用于绑定免密支付通道';
COMMENT ON COLUMN APP_PAY_SIGN_INFO.CARD_TYPE IS '卡类型编码';
COMMENT ON COLUMN APP_PAY_SIGN_INFO.PAY_ACCOUNT_ID IS '支付账户ID，签约成功后由支付系统返回的支付用户编码';
COMMENT ON COLUMN APP_PAY_SIGN_INFO.PAY_AGREEMENT_NO IS '支付协议号，签约成功后由支付系统返回';
COMMENT ON COLUMN APP_PAY_SIGN_INFO.DISPLAY_ACCOUNT IS '签约展示账号，用于签约页面展示，如昵称、手机号、姓名';
COMMENT ON COLUMN APP_PAY_SIGN_INFO.SIGN_TIME IS '签约成功时间';
COMMENT ON COLUMN APP_PAY_SIGN_INFO.TERMINATION_TIME IS '解约成功时间';

CREATE TABLE APP_PAY_SIGN_LOG (
    REQUEST_SIGN_SEQ VARCHAR2(64 CHAR) NOT NULL,
    THIRD_USER_ID VARCHAR2(64 CHAR),
    PAYMENT_VENDOR VARCHAR2(16 CHAR),
    OPERATION_TYPE VARCHAR2(64 CHAR) NOT NULL,
    REQUEST_BODY VARCHAR2(4000 CHAR),
    RESPONSE_BODY VARCHAR2(4000 CHAR),
    RESULT_CODE VARCHAR2(32 CHAR),
    RESULT_MSG VARCHAR2(512 CHAR),
    CREATE_TMS TIMESTAMP NOT NULL,
    CONSTRAINT PK_APP_PAY_SIGN_LOG PRIMARY KEY (REQUEST_SIGN_SEQ)
);

CREATE INDEX IDX_APP_PAY_SIGN_LOG_USER_ID
    ON APP_PAY_SIGN_LOG (THIRD_USER_ID);

COMMENT ON TABLE APP_PAY_SIGN_LOG IS '免密签约流水日志表';
COMMENT ON COLUMN APP_PAY_SIGN_LOG.REQUEST_SIGN_SEQ IS '签约请求流水号';
COMMENT ON COLUMN APP_PAY_SIGN_LOG.THIRD_USER_ID IS '第三方用户ID';
COMMENT ON COLUMN APP_PAY_SIGN_LOG.PAYMENT_VENDOR IS '支付类型/支付厂商编码';
COMMENT ON COLUMN APP_PAY_SIGN_LOG.OPERATION_TYPE IS '操作类型，SIGN-签约，UNSIGN-解约';
COMMENT ON COLUMN APP_PAY_SIGN_LOG.REQUEST_BODY IS '请求报文JSON快照';
COMMENT ON COLUMN APP_PAY_SIGN_LOG.RESPONSE_BODY IS '响应报文JSON快照';
COMMENT ON COLUMN APP_PAY_SIGN_LOG.RESULT_CODE IS '业务处理结果码';
COMMENT ON COLUMN APP_PAY_SIGN_LOG.RESULT_MSG IS '业务处理结果描述';
COMMENT ON COLUMN APP_PAY_SIGN_LOG.CREATE_TMS IS '日志创建时间';

CREATE TABLE APP_PAY_SIGN_REQUEST (
    ID NUMBER(20) NOT NULL,
    REQUEST_SIGN_SEQ VARCHAR2(64 CHAR) NOT NULL,
    THIRD_USER_ID VARCHAR2(64 CHAR),
    PAYMENT_VENDOR VARCHAR2(16 CHAR),
    DISPLAY_ACCOUNT VARCHAR2(128 CHAR),
    OPERATION_TYPE VARCHAR2(64 CHAR) NOT NULL,
    REQUEST_BODY VARCHAR2(4000 CHAR),
    RESPONSE_BODY VARCHAR2(4000 CHAR),
    RESULT_CODE VARCHAR2(32 CHAR),
    RESULT_MSG VARCHAR2(512 CHAR),
    SIGN_STATUS VARCHAR2(16 CHAR),
    PAY_ACCOUNT_ID VARCHAR2(64 CHAR),
    PAY_AGREEMENT_NO VARCHAR2(128 CHAR),
    CARD_ID VARCHAR2(64 CHAR),
    CARD_TYPE VARCHAR2(32 CHAR),
    TERMINATION_TIME VARCHAR2(32 CHAR),
    CREATE_TMS TIMESTAMP NOT NULL,
    NOTIFY_STATUS VARCHAR2(16 CHAR),
    NOTIFY_RETRY_COUNT NUMBER(10),
    NOTIFY_TIME TIMESTAMP,
    NOTIFY_RESULT VARCHAR2(512 CHAR),
    CONSTRAINT PK_APP_PAY_SIGN_REQUEST PRIMARY KEY (ID)
);

CREATE SEQUENCE SEQ_APP_PAY_SIGN_REQUEST
    START WITH 1
    INCREMENT BY 1
    NOMAXVALUE;

CREATE INDEX IDX_APP_PAY_SIGN_REQUEST_REQUEST_SIGN_SEQ
    ON APP_PAY_SIGN_REQUEST (REQUEST_SIGN_SEQ);

CREATE INDEX IDX_APP_PAY_SIGN_REQUEST_NOTIFY_STATUS
    ON APP_PAY_SIGN_REQUEST (NOTIFY_STATUS, NOTIFY_RETRY_COUNT);

COMMENT ON TABLE APP_PAY_SIGN_REQUEST IS '免密签约请求流水表';
COMMENT ON COLUMN APP_PAY_SIGN_REQUEST.ID IS '主键ID';
COMMENT ON COLUMN APP_PAY_SIGN_REQUEST.REQUEST_SIGN_SEQ IS '签约请求流水号';
COMMENT ON COLUMN APP_PAY_SIGN_REQUEST.THIRD_USER_ID IS '第三方用户ID';
COMMENT ON COLUMN APP_PAY_SIGN_REQUEST.PAYMENT_VENDOR IS '支付类型/支付厂商编码';
COMMENT ON COLUMN APP_PAY_SIGN_REQUEST.DISPLAY_ACCOUNT IS '签约展示账号';
COMMENT ON COLUMN APP_PAY_SIGN_REQUEST.OPERATION_TYPE IS '操作类型';
COMMENT ON COLUMN APP_PAY_SIGN_REQUEST.REQUEST_BODY IS '请求报文JSON快照';
COMMENT ON COLUMN APP_PAY_SIGN_REQUEST.RESPONSE_BODY IS '响应报文JSON快照';
COMMENT ON COLUMN APP_PAY_SIGN_REQUEST.RESULT_CODE IS '业务处理结果码';
COMMENT ON COLUMN APP_PAY_SIGN_REQUEST.RESULT_MSG IS '业务处理结果描述';
COMMENT ON COLUMN APP_PAY_SIGN_REQUEST.SIGN_STATUS IS '签约状态';
COMMENT ON COLUMN APP_PAY_SIGN_REQUEST.PAY_ACCOUNT_ID IS '支付账户ID，补偿通知时使用';
COMMENT ON COLUMN APP_PAY_SIGN_REQUEST.PAY_AGREEMENT_NO IS '支付协议号，补偿通知时使用';
COMMENT ON COLUMN APP_PAY_SIGN_REQUEST.CARD_ID IS '卡ID，解约补偿通知时使用';
COMMENT ON COLUMN APP_PAY_SIGN_REQUEST.CARD_TYPE IS '卡类型，解约补偿通知时使用';
COMMENT ON COLUMN APP_PAY_SIGN_REQUEST.TERMINATION_TIME IS '解约时间，解约补偿通知时使用';
COMMENT ON COLUMN APP_PAY_SIGN_REQUEST.CREATE_TMS IS '创建时间';
COMMENT ON COLUMN APP_PAY_SIGN_REQUEST.NOTIFY_STATUS IS '通知状态: PENDING/SUCCESS/FAILED';
COMMENT ON COLUMN APP_PAY_SIGN_REQUEST.NOTIFY_RETRY_COUNT IS '通知重试次数';
COMMENT ON COLUMN APP_PAY_SIGN_REQUEST.NOTIFY_TIME IS '最后通知时间';
COMMENT ON COLUMN APP_PAY_SIGN_REQUEST.NOTIFY_RESULT IS '通知结果描述';

CREATE TABLE APP_USER_PAY_CHANNEL (
    THIRD_USER_ID VARCHAR2(64 CHAR) NOT NULL,
    CARD_ID VARCHAR2(64 CHAR) NOT NULL,
    CARD_TYPE VARCHAR2(32 CHAR) NOT NULL,
    CHANNEL VARCHAR2(16 CHAR) NOT NULL,
    THIRD_PAY_ID VARCHAR2(64 CHAR),
    REQ_CONTRACT_NO VARCHAR2(64 CHAR),
    STATUS VARCHAR2(32 CHAR) NOT NULL,
    CREATE_TMS TIMESTAMP NOT NULL,
    UPDATE_TMS TIMESTAMP NOT NULL,
    CONSTRAINT PK_APP_USER_PAY_CHANNEL PRIMARY KEY (THIRD_USER_ID)
);

COMMENT ON TABLE APP_USER_PAY_CHANNEL IS '用户默认支付通道绑定表';
COMMENT ON COLUMN APP_USER_PAY_CHANNEL.THIRD_USER_ID IS '第三方用户ID';
COMMENT ON COLUMN APP_USER_PAY_CHANNEL.CARD_ID IS '地铁会员卡号/逻辑卡号';
COMMENT ON COLUMN APP_USER_PAY_CHANNEL.CARD_TYPE IS '卡类型编码';
COMMENT ON COLUMN APP_USER_PAY_CHANNEL.CHANNEL IS '支付通道编码';
COMMENT ON COLUMN APP_USER_PAY_CHANNEL.THIRD_PAY_ID IS '第三方支付账户ID';
COMMENT ON COLUMN APP_USER_PAY_CHANNEL.REQ_CONTRACT_NO IS '第三方签约流水号，对应请求签约时的流水号';
COMMENT ON COLUMN APP_USER_PAY_CHANNEL.STATUS IS '通道状态，ACTIVE有效、INACTIVE无效、UNBOUND已解绑';
COMMENT ON COLUMN APP_USER_PAY_CHANNEL.CREATE_TMS IS '记录创建时间';
COMMENT ON COLUMN APP_USER_PAY_CHANNEL.UPDATE_TMS IS '记录最后更新时间';
