<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.chinasofti.huateng</groupId>
    <artifactId>alipay-account-server</artifactId>
    <version>1.0.4</version>
    <packaging>jar</packaging>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.6</version>
        <relativePath />
    </parent>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>21</java.version>
        <scope.compile>compile</scope.compile>
        <scope.test>test</scope.test>
        <web.version>2.0</web.version>
        <rpc.version>2.0.1</rpc.version>
        <model.version>2.0.0</model.version>
        <fastjson.version>2.0.57</fastjson.version>
        <sql-datasource.version>2.0</sql-datasource.version>
        <mybatis-adaptor.version>2.0</mybatis-adaptor.version>
        <ojdbc.version>19.18.0.0</ojdbc.version>
        <image.prefix>alipay-account</image.prefix>
        <docker.namespace>itp</docker.namespace>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.chinasofti.huateng.micro</groupId>
            <artifactId>web</artifactId>
            <version>${web.version}</version>
        </dependency>

        <dependency>
            <groupId>com.chinasofti.huateng</groupId>
            <artifactId>rpc</artifactId>
            <version>${rpc.version}</version>
        </dependency>

        <dependency>
            <groupId>com.chinasofti.huateng</groupId>
            <artifactId>model</artifactId>
            <version>${model.version}</version>
        </dependency>

        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
            <version>${fastjson.version}</version>
        </dependency>

        <dependency>
            <groupId>com.chinasofti.huateng.micro</groupId>
            <artifactId>sql-datasource</artifactId>
            <version>${sql-datasource.version}</version>
        </dependency>

        <dependency>
            <groupId>com.chinasofti.huateng.micro</groupId>
            <artifactId>mybatis-adaptor</artifactId>
            <version>${mybatis-adaptor.version}</version>
        </dependency>

        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc8</artifactId>
            <version>${ojdbc.version}</version>
        </dependency>

        <dependency>
            <groupId>com.oracle.database.nls</groupId>
            <artifactId>orai18n</artifactId>
            <version>${ojdbc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>2.5.2</version>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>remote</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.eclipse.jkube</groupId>
                        <artifactId>kubernetes-maven-plugin</artifactId>
                        <version>1.19.0</version>
                        <executions>
                            <execution>
                                <id>build-image-remote</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>build</goal>
                                    <goal>push</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <namespace>itp</namespace>
                            <dockerHost>tcp://172.20.211.21:2375</dockerHost>
                            <pushRegistry>os-harbor-svc.default.svc.cloudos:443</pushRegistry>
                            <images>
                                <image>
                                    <name>${docker.namespace}/${image.prefix}:${project.version}</name>
                                    <build>
                                        <dockerFile>${project.basedir}/../docker/Dockerfile</dockerFile>
                                        <filter>true</filter>
                                        <contextDir>${project.basedir}</contextDir>
                                        <assembly>
                                            <mode>dir</mode>
                                            <targetDir>/</targetDir>
                                            <inline>
                                                <files>
                                                    <file>
                                                        <source>${project.build.directory}/${project.build.finalName}.jar</source>
                                                        <destName>app.jar</destName>
                                                        <outputDirectory>.</outputDirectory>
                                                    </file>
                                                </files>
                                            </inline>
                                        </assembly>
                                    </build>
                                </image>
                            </images>
                            <generator>
                                <excludes>
                                    <exclude>spring-boot</exclude>
                                </excludes>
                            </generator>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>local</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.eclipse.jkube</groupId>
                        <artifactId>kubernetes-maven-plugin</artifactId>
                        <version>1.19.0</version>
                        <executions>
                            <execution>
                                <id>build-image-local</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>resource</goal>
                                    <goal>build</goal>
                                    <goal>apply</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <images>
                                <image>
                                    <name>huateng/${image.prefix}:${project.version}</name>
                                    <build>
                                        <dockerFile>${project.basedir}/../docker/Dockerfile.local</dockerFile>
                                        <filter>true</filter>
                                        <contextDir>${project.basedir}</contextDir>
                                        <assembly>
                                            <mode>dir</mode>
                                            <targetDir>/</targetDir>
                                            <inline>
                                                <files>
                                                    <file>
                                                        <source>${project.build.directory}/${project.build.finalName}.jar</source>
                                                        <destName>app.jar</destName>
                                                        <outputDirectory>.</outputDirectory>
                                                    </file>
                                                </files>
                                            </inline>
                                        </assembly>
                                    </build>
                                </image>
                            </images>
                            <generator>
                                <excludes>
                                    <exclude>spring-boot</exclude>
                                </excludes>
                            </generator>
                            <resources>
                                <services>
                                    <service>
                                        <name>alipay-account-server</name>
                                        <type>NodePort</type>
                                        <ports>
                                            <port>
                                                <port>8080</port>
                                                <targetPort>8080</targetPort>
                                                <nodePort>30081</nodePort>
                                            </port>
                                        </ports>
                                    </service>
                                </services>
                            </resources>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
