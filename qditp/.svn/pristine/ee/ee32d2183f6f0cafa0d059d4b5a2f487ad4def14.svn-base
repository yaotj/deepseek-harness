    @Override
    public com.chinasofti.huateng.common.response.AlipayCommonResponse notifyBlackListChange(com.chinasofti.huateng.model.alipaytrip.AlipayBlackListNotifyReqDTO request) {
        com.chinasofti.huateng.common.response.AlipayCommonResponse response = new com.chinasofti.huateng.common.response.AlipayCommonResponse();
        try {
            if (request == null || !StringUtils.hasText(request.getCardId())) {
                response.setRetCode(FepAppErrorCodeEnum.INVALID_PARAM.getCode());
                response.setRetMsg("卡号不能为空");
                return response;
            }
            log.info("接收到支付宝出行-黑名单状态变更通知: cardId={}, blackListType={}, reason={}",
                    request.getCardId(), request.getBlackListType(), request.getReason());

            // 组装黑名单通知 bizData（明文 JSON，不 Base64 编码）
            Map<String, Object> bizDataMap = new java.util.LinkedHashMap<>();
            Map<String, Object> record = new java.util.LinkedHashMap<>();
            record.put("thirdUserId", request.getThirdUserId());
            record.put("cardId", request.getCardId());
            record.put("cardType", request.getCardType());
            record.put("blackListType", request.getBlackListType());
            record.put("optionDate", request.getOptionDate());
            if ("1".equals(request.getBlackListType()) && StringUtils.hasText(request.getExpireTime())) {
                record.put("expireTime", request.getExpireTime());
            }
            bizDataMap.put("blackList", Collections.singletonList(record));

            // 调用支付中心黑名单变更通知接口
            com.chinasofti.huateng.alipay.paysign.model.response.PayCenterResponse payCenterResponse = payCenterClient.blacklistNotify(bizDataMap);

            if (payCenterResponse != null && Boolean.TRUE.equals(payCenterResponse.getSuccess())) {
                response.setRetCode(FepAppErrorCodeEnum.SUCCESS.getCode());
                response.setRetMsg("黑名单变更通知成功");
            } else if (payCenterResponse != null) {
                response.setRetCode(FepAppErrorCodeEnum.FAIL.getCode());
                response.setRetMsg(payCenterResponse.getMsg() != null ? payCenterResponse.getMsg() : "黑名单变更通知失败");
            } else {
                response.setRetCode(FepAppErrorCodeEnum.SYSTEM_ERROR.getCode());
                response.setRetMsg("调用支付中心黑名单通知接口失败");
            }
            log.info("支付宝出行-黑名单状态变更通知完成, cardId={}, retCode={}", request.getCardId(), response.getRetCode());
            return response;
        } catch (Exception e) {
            log.error("支付宝出行-黑名单状态变更通知异常, cardId={}", request != null ? request.getCardId() : null, e);
            response.setRetCode(FepAppErrorCodeEnum.SYSTEM_ERROR.getCode());
            response.setRetMsg("系统内部错误");
            return response;
        }
    }

    // ==================== 私有方法 ====================

    private boolean isValidAddContractRequest(AlipayTripAddContractReqDTO request) {
        return request.getThirdUserId() != null && !request.getThirdUserId().trim().isEmpty()
                && request.getChannel() != null && !request.getChannel().trim().isEmpty()
                && request.getAgreementCode() != null && !request.getAgreementCode().trim().isEmpty()
                && request.getChannelUserAccount() != null && !request.getChannelUserAccount().trim().isEmpty();
    }

    private boolean isValidTerminateContractRequest(AlipayTripTerminateContractReqDTO request) {
        return request.getAgreementCode() != null && !request.getAgreementCode().trim().isEmpty();
    }

    private boolean isValidPayRequest(AlipayTripRequestPayReqDTO request) {
        return request.getOrderNo() != null && !request.getOrderNo().trim().isEmpty()
                && request.getAmount() != null
                && request.getIndustryType() != null && !request.getIndustryType().trim().isEmpty()
                && request.getSubject() != null && !request.getSubject().trim().isEmpty()
                && request.getBody() != null && !request.getBody().trim().isEmpty()
                && request.getIndustryDetail() != null && !request.getIndustryDetail().trim().isEmpty();
    }

    private boolean isValidRefundRequest(AlipayTripRequestRefundReqDTO request) {
        return request != null && StringUtils.hasText(request.getOrderNo());
    }

    private long parseAmount(String amount) {
        if (amount == null || amount.trim().isEmpty()) {
            return 0;
        }
        try {
            return Long.parseLong(amount.trim());
        } catch (NumberFormatException e) {
            log.error("退款金额格式异常, amount={}", amount, e);
            throw new RuntimeException("退款金额格式异常: " + amount);
        }
    }

    /**
     * 补充 industryDetail 中的线路和车站中文名称。
     */
    private void enrichIndustryDetailWithNames(AlipayTripRequestPayReqDTO request) {
        if (request == null || !StringUtils.hasText(request.getIndustryDetail())) {
            return;
        }
        try {
            com.alibaba.fastjson.JSONObject detailObj = com.alibaba.fastjson.JSON.parseObject(request.getIndustryDetail());

            // 查询车站中文名
            String exitStationCode = detailObj.getString("exitStationCode");
            if (StringUtils.hasText(exitStationCode)) {
                String stationName = queryStationName(exitStationCode);
                if (StringUtils.hasText(stationName)) {
                    detailObj.put("exitStationName", stationName);
                }
            }

            String entryStationCode = detailObj.getString("entryStationCode");
            if (StringUtils.hasText(entryStationCode)) {
                String stationName = queryStationName(entryStationCode);
                if (StringUtils.hasText(stationName)) {
                    detailObj.put("entryStationName", stationName);
                }
            }

            // 查询线路中文名，线路代码只保留2位
            String exitLineCode = detailObj.getString("exitLineCode");
            if (StringUtils.hasText(exitLineCode)) {
                String shortLineCode = exitLineCode.length() > 2 ? exitLineCode.substring(0, 2) : exitLineCode;
                detailObj.put("exitLineCode", shortLineCode);
                String lineName = queryLineName(shortLineCode);
                if (StringUtils.hasText(lineName)) {
                    detailObj.put("exitLineName", lineName);
                }
            }

            String entryLineCode = detailObj.getString("entryLineCode");
            if (StringUtils.hasText(entryLineCode)) {
                String shortLineCode = entryLineCode.length() > 2 ? entryLineCode.substring(0, 2) : entryLineCode;
                detailObj.put("entryLineCode", shortLineCode);
                String lineName = queryLineName(shortLineCode);
                if (StringUtils.hasText(lineName)) {
                    detailObj.put("entryLineName", lineName);
                }
            }

            String updatedDetail = detailObj.toJSONString();
            request.setIndustryDetail(updatedDetail);
            log.info("补充中文名称后, industryDetail={}", updatedDetail);
        } catch (Exception e) {
            log.warn("补充 industryDetail 中文名称失败", e);
        }
    }

    /**
     * 补充 industryDetail 中的交易序列号和进出站编号。
     * entryId 基于进站数据生成（trxType 固定为 01），
     * exitId 基于出站数据生成（trxType 固定为 02），
     * tikcetTransSeq 固定为 09。 废弃：还是直接用trans
     */
    private void enrichIndustryDetailWithTripSeq(AlipayTripRequestPayReqDTO request) {
        if (request == null || !StringUtils.hasText(request.getIndustryDetail())) {
            return;
        }
        try {
            com.alibaba.fastjson.JSONObject detailObj = com.alibaba.fastjson.JSON.parseObject(request.getIndustryDetail());
            String cardNum = detailObj.getString("cardNum");
            String entryDate = detailObj.getString("entryDate");
            String exitDate = detailObj.getString("exitDate");

            // entryId：进站时的 cardNum + entryDateCompact + "01"
            String entryDateCompact = StringUtils.hasText(entryDate) ? entryDate.replaceAll("[^0-9]", "") : "";
            if (entryDateCompact.length() > 14) {
                entryDateCompact = entryDateCompact.substring(0, 14);
            }
            String entryId = (StringUtils.hasText(cardNum) ? cardNum : "") +
                    (StringUtils.hasText(entryDateCompact) ? entryDateCompact : "") + "01";

            // exitId：出站时的 cardNum + exitDateCompact + "02"
            String exitDateCompact = StringUtils.hasText(exitDate) ? exitDate.replaceAll("[^0-9]", "") : "";
            if (exitDateCompact.length() > 14) {
                exitDateCompact = exitDateCompact.substring(0, 14);
            }
            String exitId = (StringUtils.hasText(cardNum) ? cardNum : "") +
                    (StringUtils.hasText(exitDateCompact) ? exitDateCompact : "") + "02";

            // tikcetTransSeq：优先使用闸机传过来的二维码交易计数器
            String ticketTransSeq = detailObj.getString("tikcetTransSeq");
            if (!StringUtils.hasText(ticketTransSeq)) {
                ticketTransSeq = request.getRequestSignSeq();
            }

            // 兜底：如果生成结果为空，使用支付订单号
//            if (!StringUtils.hasText(ticketTransSeq)) {
//                ticketTransSeq = request.getOrderNo() != null ? request.getOrderNo() : String.valueOf(System.currentTimeMillis());
//            }
            if (!StringUtils.hasText(entryId)) {
                entryId = ticketTransSeq;
            }
            if (!StringUtils.hasText(exitId)) {
                exitId = ticketTransSeq;
            }

            detailObj.put("tikcetTransSeq", ticketTransSeq);
            detailObj.put("entryId", entryId);
            detailObj.put("exitId", exitId);
            String updatedDetail = detailObj.toJSONString();
            request.setIndustryDetail(updatedDetail);
            log.info("补充交易序列号后, industryDetail={}", updatedDetail);
        } catch (Exception e) {
            log.warn("补充 industryDetail 交易序列号失败", e);
        }
    }

    private void resolveEntryExitIdsFromIndustryDetail(AlipayTripRequestPayReqDTO request, AlipayPayLog payLog) {
        if (request == null || payLog == null || !StringUtils.hasText(request.getIndustryDetail())) {
            return;
        }
        try {
            com.alibaba.fastjson.JSONObject detailObj = com.alibaba.fastjson.JSON.parseObject(request.getIndustryDetail());
            payLog.setEntryId(detailObj.getString("entryId"));
            payLog.setExitId(detailObj.getString("exitId"));
        } catch (Exception e) {
            log.warn("解析 industryDetail 获取 entryId/exitId 失败", e);
        }
    }

    /**
     * 查询车站中文名称。
     */
    private String queryStationName(String stationCode) {
        try {
            com.chinasofti.huateng.model.app.RequestStationNameReqDTO req = new com.chinasofti.huateng.model.app.RequestStationNameReqDTO();
            req.setStationCode(stationCode);
            com.chinasofti.huateng.model.app.RequestStationNameResult result = paraClient.requestStationName(req);
            if (result != null && StringUtils.hasText(result.getStationName())) {
                return result.getStationName();
            }
        } catch (Exception e) {
            log.warn("查询车站名称失败, stationCode={}", stationCode, e);
        }
        return null;
    }

    /**
     * 查询线路中文名称。
     */
    private String queryLineName(String lineCode) {
        try {
            com.chinasofti.huateng.model.app.RequestLineCodeListReqDTO req = new com.chinasofti.huateng.model.app.RequestLineCodeListReqDTO();
            com.chinasofti.huateng.model.app.RequestLineCodeListResult result = paraClient.requestLineCodeList(req);
            if (result != null && result.getLineCodeRecord() != null) {
                for (com.chinasofti.huateng.model.app.LineCodeRecordDTO record : result.getLineCodeRecord()) {
                    if (lineCode.equals(record.getLineCode())) {
                        return record.getLineNameZH();
                    }
                }
            }
        } catch (Exception e) {
            log.warn("查询线路名称失败, lineCode={}", lineCode, e);
        }
        return null;
    }

    @Override
    @Transactional(rollbackFor = Exception.class)
    public AlipayCommonResponse executeTermination(String agreementCode) {
        com.chinasofti.huateng.common.response.AlipayCommonResponse response = new com.chinasofti.huateng.common.response.AlipayCommonResponse();
        try {
            log.info("支付宝出行-执行解约, agreementCode={}", agreementCode);

            // 1. 查询待处理的解约记录
            java.util.List<com.chinasofti.huateng.model.alipaytrip.AlipayTerminationRequest> pendingList;
            if (org.springframework.util.StringUtils.hasText(agreementCode)) {
                pendingList = new java.util.ArrayList<>();
                com.chinasofti.huateng.model.alipaytrip.AlipayTerminationRequest request = alipayTerminationRequestMapper.selectByAgreementCode(agreementCode);
                if (request != null && "PENDING".equals(request.getStatus())) {
                    pendingList.add(request);
                }
            } else {
                pendingList = new java.util.ArrayList<>();
                log.warn("未传入agreementCode，无法执行解约");
            }

            if (pendingList.isEmpty()) {
                response.setRetCode(com.chinasofti.huateng.common.constant.FepAppErrorCodeEnum.SUCCESS.getCode());
                response.setRetMsg("无待处理解约记录");
                return response;
            }

            int successCount = 0;
            int failCount = 0;

            // 2. 逐个执行解约
            for (com.chinasofti.huateng.model.alipaytrip.AlipayTerminationRequest terminationRequest : pendingList) {
                try {
                    // 2.1 查询签约信息
                    com.chinasofti.huateng.model.alipaytrip.AlipaySignInfo signInfo = alipaySignInfoMapper.selectByChannelAgreementCode(terminationRequest.getAgreementCode());
                    if (signInfo == null) {
                        log.warn("执行解约失败，签约信息不存在, agreementCode={}", terminationRequest.getAgreementCode());
                        failCount++;

                        continue;
                    }

                    // 2.2 更新签约状态为 TERMINATED
                    alipaySignInfoMapper.updateStatus(signInfo.getAgreementCode(), "TERMINATED", java.time.LocalDateTime.now());

                    // 2.3 通知支付宝方解约结果
                    String alipayResponse = notifyAlipayTerminationAsync(terminationRequest, signInfo);

                    // 2.4 更新解约记录状态为 COMPLETED
                    alipayTerminationRequestMapper.updateStatus(terminationRequest.getAgreementCode(), "COMPLETED", java.time.LocalDateTime.now());
                    successCount++;
                } catch (Exception e) {
                    log.error("执行解约异常, agreementCode={}", terminationRequest.getAgreementCode(), e);
                    // 更新解约记录状态为 FAIL
                    try {
                        alipayTerminationRequestMapper.updateStatus(terminationRequest.getAgreementCode(), "FAIL", java.time.LocalDateTime.now());
                    } catch (Exception ex) {
                        log.error("更新解约记录状态失败, agreementCode={}", terminationRequest.getAgreementCode(), ex);
                    }
                    failCount++;
                }
            }

            response.setRetCode(com.chinasofti.huateng.common.constant.FepAppErrorCodeEnum.SUCCESS.getCode());
            response.setRetMsg("执行完成，成功：" + successCount + "，失败：" + failCount);
        } catch (Exception e) {
            log.error("执行解约异常", e);
            response.setRetCode(com.chinasofti.huateng.common.constant.FepAppErrorCodeEnum.SYSTEM_ERROR.getCode());
            response.setRetMsg("系统内部错误");
        }
        return response;
    }

    private String notifyAlipayTerminationAsync(com.chinasofti.huateng.model.alipaytrip.AlipayTerminationRequest terminationRequest, com.chinasofti.huateng.model.alipaytrip.AlipaySignInfo signInfo) {
        try {
            com.chinasofti.huateng.common.response.AlipayCommonResponse notifyResponse = notifyCloseResult(terminationRequest.getAgreementCode(), true);
            if (notifyResponse != null && "0000".equals(notifyResponse.getRetCode())) {
                log.info("通知支付宝方解约结果成功, agreementCode={}", terminationRequest.getAgreementCode());
            } else {
                log.warn("通知支付宝方解约结果失败, agreementCode={}, retCode={}, retMsg={}",
                        terminationRequest.getAgreementCode(),
                        notifyResponse != null ? notifyResponse.getRetCode() : "null",
                        notifyResponse != null ? notifyResponse.getRetMsg() : "null");
            }
            return notifyResponse != null ? notifyResponse.getRetCode() : null;
        } catch (Exception e) {
            log.error("通知支付宝方解约结果异常, agreementCode={}", terminationRequest.getAgreementCode(), e);
            return null;
        }
    }
}
