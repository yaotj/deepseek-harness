package com.chinasofti.huateng.model.agm;

import java.util.List;

/**
 * AGM-reported key version and the corresponding synchronization decision.
 */
public class AgmKeyCurVerDTO {
    private String issueChannelCode;
    private String keyId;
    private String keyBathNumber;
    private String needUpdateYN;
    private List<AgmKeyItemDTO> keyList;

    public String getIssueChannelCode() { return issueChannelCode; }
    public void setIssueChannelCode(String issueChannelCode) { this.issueChannelCode = issueChannelCode; }
    public String getKeyId() { return keyId; }
    public void setKeyId(String keyId) { this.keyId = keyId; }
    public String getKeyBathNumber() { return keyBathNumber; }
    public void setKeyBathNumber(String keyBathNumber) { this.keyBathNumber = keyBathNumber; }
    public String getNeedUpdateYN() { return needUpdateYN; }
    public void setNeedUpdateYN(String needUpdateYN) { this.needUpdateYN = needUpdateYN; }
    public List<AgmKeyItemDTO> getKeyList() { return keyList; }
    public void setKeyList(List<AgmKeyItemDTO> keyList) { this.keyList = keyList; }
}
