package com.chinasofti.huateng.model.frs.vo;

import com.chinasofti.huateng.model.frs.RulLineInfoDTO;

public class LineInfoVO {
    String preLineCode;

    RulLineInfoDTO lineInfo;

    public RulLineInfoDTO getLineInfo() {
        return lineInfo;
    }

    public void setLineInfo(RulLineInfoDTO lineInfo) {
        this.lineInfo = lineInfo;
    }

    public String getPreLineCode() {
        return preLineCode;
    }

    public void setPreLineCode(String preLineCode) {
        this.preLineCode = preLineCode;
    }

}
