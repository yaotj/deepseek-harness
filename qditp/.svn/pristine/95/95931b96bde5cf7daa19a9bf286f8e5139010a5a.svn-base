server.port=9106
spring.application.name=gate-txn-pay
other.web.unSafeUrlChars=null
other.web.enableLogRequestInFilter=true
other.web.enableBodyCacheFilter=true
other.web.enableLogTakeTimesInInterceptor=true
knife4j.production=false

other.sql.host=${DB_HOST:172.20.222.3:1521}
other.sql.double-datasource=false
other.sql.type=oracle
other.sql.page.type=oracle
other.sql.database=${DB_NAME:AFCITPDB}
other.sql.username=${DB_USERNAME:qditp}
other.sql.password=${DB_PASSWORD:qditp}

mybatis.mapper-locations=classpath*:mapper/*.xml

service.paySign.url=http://127.0.0.1:9096
service.paySign.openLogger=true

gate.pay.scene=AGM_GATE
gate.pay.industry-type=1
gate.pay.subject=地铁乘车扣费
gate.pay.body=地铁乘车费用
gate.pay.order-timeout-seconds=60
