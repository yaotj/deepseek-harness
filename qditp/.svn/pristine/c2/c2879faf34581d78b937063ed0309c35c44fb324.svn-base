package com.chinasofti.huateng.model.security;

/**
 * 请求导出 HCE 应用子密钥（DPK）的应答。
 */
public class RequestDpkRespDTO extends SecurityBaseRespDTO {
    /**
     * 由 ACC 侧 KEK 加密的 DPK，HEX 格式。
     */
    private String dpkByKek;

    public String getDpkByKek() {
        return dpkByKek;
    }

    public void setDpkByKek(String dpkByKek) {
        this.dpkByKek = dpkByKek;
    }
}
