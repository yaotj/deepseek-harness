-- 1. TVM扫码购票订单表

CREATE TABLE TBL_TVM_ORDER_PAY (
    ORDER_NO VARCHAR2(100),
    IN_STATION_CODE VARCHAR2(100),
    OUT_STATION_CODE VARCHAR2(100),
    TICKET_PRICE VARCHAR2(100),
	TOTAL_PRICE VARCHAR2(100),
    TICKET_NUM VARCHAR2(100),
    TICKET_TYPE VARCHAR2(100),
    STATUS VARCHAR2(100),
    MSG VARCHAR2(100),
	PAY_TYPE VARCHAR2(100),
    CHANNEL VARCHAR2(100),
    PAYCENTER_ORDERNO VARCHAR2(100),
    PAYCENTER_channelOrderNo VARCHAR2(100),
    URL VARCHAR2(100),
    CREATE_TIME VARCHAR2(100),
    UPDATE_TIME VARCHAR2(100),
    DEVICE_ID VARCHAR2(100),
    RSV1 VARCHAR2(100),
    RSV2 VARCHAR2(100)
);


-- 2. TVM扫码充值订单表
CREATE TABLE TBL_TVM_ORDER_TOPUP (
    ORDER_NO VARCHAR2(100) PRIMARY KEY,
    TICKET_LOGIC_NUM VARCHAR2(100),
    TICKET_PHYSICS_NUM VARCHAR2(100),
    BEFORE_AMOUNT VARCHAR2(100),
    TRANS_AMOUNT VARCHAR2(100),
    AFTER_AMOUNT VARCHAR2(100),
    STATUS VARCHAR2(100),
	MSG VARCHAR2(100),
    CHANNEL VARCHAR2(100),
	PAY_TYPE VARCHAR2(100),
    URL VARCHAR2(100),
    CREATE_TIME VARCHAR2(100),
    UPDATE_TIME VARCHAR2(100),
    DEVICE_ID VARCHAR2(100),
    RSV1 VARCHAR2(100),
    RSV2 VARCHAR2(100)
);

-- 3. TVM扫码取票订单表
CREATE TABLE TBL_TVM_TAKE_TICKET_ORDER (
    ID VARCHAR2(100) PRIMARY KEY,
    ORDER_NO VARCHAR2(100),
    DEVICE_ID VARCHAR2(100),
    QRCODE_GEN_DATE VARCHAR2(100),
    RANDOM_FACT VARCHAR2(100),
    ACTIVE_STATUS VARCHAR2(100),
    ACTIVE_TIME VARCHAR2(100),
    CREATE_TIME VARCHAR2(100),
    UPDATE_TIME VARCHAR2(100)
);

-- 4. TVM出票主记录表
CREATE TABLE TBL_TVM_MAIN_TICKET (
    ID VARCHAR2(100) PRIMARY KEY,
    ORDER_NO VARCHAR2(100),
    ACTUAL_TAKE_TICKET_NUM VARCHAR2(100),
    TAKE_TICKE_DATE VARCHAR2(100),
    NOTIFY_TYPE VARCHAR2(100),
    FAULT_SLIP_SEQ VARCHAR2(100),
    ERROR_CODE VARCHAR2(100),
    ERROR_MESSAGE VARCHAR2(100),
    BUY_TICKET_NUM VARCHAR2(100),
    CREATE_TIME VARCHAR2(100)
);

-- 5. TVM出票明细记录表
CREATE TABLE TBL_TVM_SUB_TICKET (
    MAIN_TICKET_ID VARCHAR2(100),
    TICKET_LOGIC_NUM VARCHAR2(100),
    TRANS_DATE VARCHAR2(100),
    TRANS_AMOUNT VARCHAR2(100),
	CREATE_TIME VARCHAR2(100)
);

-- 6. 退款记录表
CREATE TABLE TBL_TVM_ORDER_REFUND
   (
    REFUND_NO VARCHAR2(100),
	MERCHANT_REFUND_NO VARCHAR2(100),
	CHANNEL_REFUND_NO VARCHAR2(100),
	BUSINESS_TYPE VARCHAR2(100),
	REFUND_AMOUNT VARCHAR2(100),
	REFUND_REASON VARCHAR2(100),
	REFUND_STATUS VARCHAR2(100),
	REFUND_MSG VARCHAR2(100),
	PAY_ORDER_NO VARCHAR2(100),
	REFUND_TIME VARCHAR2(100),
	CREATE_TIME VARCHAR2(100)
   )

-- 7. 铁运维保取票支付记录表
CREATE TABLE APP_PAY_LOGS (
    ORDER_NO VARCHAR2(100) PRIMARY KEY,
    USER_ID VARCHAR2(100),
    PAY_TYPE VARCHAR2(100),
    CHANNEL_CODE VARCHAR2(100),
    CREATE_TMS VARCHAR2(100),
    TRADE_NO VARCHAR2(100),
    PAY_CHANNEL_CODE VARCHAR2(100),
    CHANNEL_TYPE VARCHAR2(100),
    PAY_RESULT VARCHAR2(100),
    PAY_AMOUNT VARCHAR2(100)
);

-- 8.支付前置信息
CREATE TABLE TBL_TVM_ORDER_PAY_PRE (
    ORDER_NO VARCHAR2(100),
    trans_Type VARCHAR2(100),
	pay_channel VARCHAR2(100),
    trans_Amount VARCHAR2(100),
    device_Id VARCHAR2(100),
	CREATE_TIME VARCHAR2(100),
    UPDATE_TIME VARCHAR2(100)
);
create sequence tbl_tvm_main_ticket_ID_SEQ minvalue 1 maxvalue 99999999999 start with 1 increment by 1 cache 1000 cycle order;



-- 9.bom订单表
CREATE TABLE TBL_BOM_ORDER_PAY (
    ORDER_NO VARCHAR2(100) PRIMARY KEY,
    DEVICE_ID VARCHAR2(100),
    TRANS_TYPE VARCHAR2(100),
    ADMIN_TRANS_TYPE VARCHAR2(100),
    OPERATER_ID VARCHAR2(100),
    SHIFT_ID VARCHAR2(100),
    CARD_ID VARCHAR2(100),
    TRANS_AOUNT VARCHAR2(100),
    BOM_OPT_SEQ VARCHAR2(100),
    STATUS VARCHAR2(100),
    PAYMENT_CODE VARCHAR2(100),
    PAYMENT_VENDOR VARCHAR2(100),
    CHANNEL VARCHAR2(100),
    URL VARCHAR2(100),
    CREATE_TIME VARCHAR2(100),
    UPDATE_TIME VARCHAR2(100),
    RSV1 VARCHAR2(100),
    RSV2 VARCHAR2(100)
);

CREATE TABLE TBL_BOM_BUS_RESULT
   (	NOTIFY_ID VARCHAR2(100),
	ORDER_NO VARCHAR2(100),
	DEVICE_ID VARCHAR2(100),
	OPT_RESULT VARCHAR2(100),
	REFUND_ORDER_NO VARCHAR2(100),
	CREATE_TIME VARCHAR2(100),
	UPDATE_TIME VARCHAR2(100)) ;

CREATE TABLE TBL_BOM_ORDER_REFUND
   (	REFUND_NO VARCHAR2(100),
	PAY_ORDER_NO VARCHAR2(100),
	MERCHANT_REFUND_NO VARCHAR2(100),
	CHANNEL_REFUND_NO VARCHAR2(100),
	REFUND_AMOUNT VARCHAR2(100),
	REFUND_REASON VARCHAR2(100),
	REFUND_STATUS VARCHAR2(100),
	REFUND_MSG VARCHAR2(100),
	REFUND_TIME VARCHAR2(100),
	CREATE_TIME VARCHAR2(100),
	UPDATE_TIME VARCHAR2(100));

CREATE TABLE TBL_TVM_APP_ORDER (
    ORDER_NO VARCHAR2(100),
    USER_ID VARCHAR2(100),
    IN_STATION_CODE VARCHAR2(100),
    OUT_STATION_CODE VARCHAR2(100),
    TICKET_PRICE VARCHAR2(100),
	TICKET_NUM VARCHAR2(100),
	totalPrice VARCHAR2(100),
    TICKET_TYPE VARCHAR2(100),
    PAY_STATUS VARCHAR2(100),
    MSG VARCHAR2(100),
    REQUEST_PAY_FLAG VARCHAR2(100),
	ACTIVATE_FLAG VARCHAR2(100),
    PAY_CHANNEL_CODE VARCHAR2(100),
    merchantOrderNo VARCHAR2(100),
    PAY_AMOUNT VARCHAR2(100),
    PAY_TIME VARCHAR2(100),
    paymentInfo VARCHAR2(1000),
    CREATE_TIME VARCHAR2(100),
    UPDATE_TIME VARCHAR2(100),
    RSV1 VARCHAR2(100),
    RSV2 VARCHAR2(100)
);

create sequence ORDER_NO_SEQ
minvalue 1
maxvalue 99999999999
start with 1
increment by 1
cache 1000
cycle
order;
