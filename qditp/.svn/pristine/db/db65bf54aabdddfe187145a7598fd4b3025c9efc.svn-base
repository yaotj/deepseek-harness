package com.chinasofti.huateng.acc.es.server.model;

import java.time.LocalDateTime;
import java.io.Serializable;

/**
 * <p>
 * 票卡生命周期历史表
 * </p>
 *
 * @author fc
 * @since 2020-09-02
 */

public class TblTktCycleHistroy implements Serializable {

    private static final long serialVersionUID=1L;

    private String ticketId;

    private String ticketCsn;

    private Integer ticketType;

    private Integer ticketSubType;

    private String ticketPrtId;

    private String procState;

    private String procDate;

    private String batchNo;

    private String lastUpdId;

    private LocalDateTime lastUpdTms;

    public String getTicketId() {
        return ticketId;
    }

    public void setTicketId(String ticketId) {
        this.ticketId = ticketId;
    }

    public String getTicketCsn() {
        return ticketCsn;
    }

    public void setTicketCsn(String ticketCsn) {
        this.ticketCsn = ticketCsn;
    }

    public Integer getTicketType() {
        return ticketType;
    }

    public void setTicketType(Integer ticketType) {
        this.ticketType = ticketType;
    }

    public Integer getTicketSubType() {
        return ticketSubType;
    }

    public void setTicketSubType(Integer ticketSubType) {
        this.ticketSubType = ticketSubType;
    }

    public String getTicketPrtId() {
        return ticketPrtId;
    }

    public void setTicketPrtId(String ticketPrtId) {
        this.ticketPrtId = ticketPrtId;
    }

    public String getProcState() {
        return procState;
    }

    public void setProcState(String procState) {
        this.procState = procState;
    }

    public String getProcDate() {
        return procDate;
    }

    public void setProcDate(String procDate) {
        this.procDate = procDate;
    }

    public String getBatchNo() {
        return batchNo;
    }

    public void setBatchNo(String batchNo) {
        this.batchNo = batchNo;
    }

    public String getLastUpdId() {
        return lastUpdId;
    }

    public void setLastUpdId(String lastUpdId) {
        this.lastUpdId = lastUpdId;
    }

    public LocalDateTime getLastUpdTms() {
        return lastUpdTms;
    }

    public void setLastUpdTms(LocalDateTime lastUpdTms) {
        this.lastUpdTms = lastUpdTms;
    }

    @Override
    public String toString() {
        return "TblTktCycleHistroy{" +
        "ticketId=" + ticketId +
        ", ticketCsn=" + ticketCsn +
        ", ticketType=" + ticketType +
        ", ticketSubType=" + ticketSubType +
        ", ticketPrtId=" + ticketPrtId +
        ", procState=" + procState +
        ", procDate=" + procDate +
        ", batchNo=" + batchNo +
        ", lastUpdId=" + lastUpdId +
        ", lastUpdTms=" + lastUpdTms +
        "}";
    }
}
