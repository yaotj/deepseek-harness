    </update>

    <select id="sumTaskByPlanNo" resultType="int">
        SELECT SUM(TASK_NUM) FROM TBL_TKT_ES_TASK WHERE PLAN_NO = #{planNo}
    </select>

    <select id="select2" parameterType="com.chinasofti.huateng.acc.es.server.model.TblTktEsTask" resultMap="BaseResultMap">
        select
        TASK.TASK_NO,TASK.PLAN_NO,TASK.CHECKOUT_NO,TASK.TASK_TYPE,TASK.PLAN_DATE,TASK.ACT_DATE, TASK.TICKET_MAIN_TYPE,
        TASK.TICKET_TYPE, TASK.TICKET_SUB_TYPE, TASK.TEST_FLG, TASK.VER_NO, TASK.BATCH_NO, TASK.TICKET_BATCH_NO, TASK.TASK_NUM,
        TASK.BEGIN_NO, TASK.SVT_TICKET_TYPE, TASK.END_NO, TASK.DEP_AMT, TASK.INIT_AMT, TASK.REWARD_AMT, TASK.VALID_DAYS, TASK.BEGIN_DATE,
        TASK.FINISH_NUM, TASK.WASTE_NUM, TASK.TICK_USE_TIMES, TASK.IS_MONTH_CARD, TASK.RIDE_PRIMESSION, TASK.IS_NAMED_CARD,
        TASK.IS_ACTIVE, TASK.IS_PRINT_PHOTO, TASK.TASK_ASSN_STAT, TASK.TASK_EXEC_STAT, TASK.GEN_TMS, TASK.LAST_UPD_ID,
        TASK.LAST_UPD_TMS,TASK.IS_MEMORIAL,TASK.WALLET_UNIT,TASK.APPR_DATE,TASK.APPR_USER,TASK.APPR_STAT,TASK.CREATE_USER,TASK.TICKET_STATUS,
        ASSIGN.TASK_NO ATASK_NO,ASSIGN.ES_CODE AES_CODE,ASSIGN.BEGIN_NO ABEGIN_NO,ASSIGN.TASK_NUM ATASK_NUM,ASSIGN.END_NO AEND_NO,ASSIGN.TASK_STAT ATASK_STAT,ASSIGN.FILE_NM AFILE_NM,
        ASSIGN.LAST_UPD_ID ALAST_UPD_ID,ASSIGN.LAST_UPD_TMS ALAST_UPD_TMS
        from
        TBL_TKT_ES_TASK TASK
        LEFT JOIN
        TBL_TKT_ES_ASSIGN ASSIGN
        ON TASK.TASK_NO = ASSIGN.TASK_NO
        WHERE TASK_TYPE &gt; '2' AND TASK_TYPE &lt; '7'
        <if test="taskNo != null and taskNo != ''">
            AND TASK.TASK_NO = #{taskNo}
        </if>
        <if test="planNo != null and planNo != ''">
            AND TASK.PLAN_NO = #{planNo}
        </if>
        <if test="taskAssnStat != null and taskAssnStat != ''">
            AND TASK.TASK_ASSN_STAT = #{taskAssnStat}
        </if>
        <if test="taskExecStat != null and taskExecStat != ''">
            AND TASK.TASK_EXEC_STAT = #{taskExecStat}
        </if>
        <if test="taskType != null and taskType != ''">
            AND TASK.TASK_TYPE = #{taskType}
        </if>
        ORDER BY TASK.TASK_NO DESC


    </select>

    <select id="queryAllTasks" parameterType="com.chinasofti.huateng.acc.es.server.model.TblTktEsTask" resultMap="BaseResultMap">
        select
         TASK.TASK_NO,TASK.PLAN_NO,TASK.CHECKOUT_NO,TASK.TASK_TYPE,TASK.PLAN_DATE,TASK.ACT_DATE, TASK.TICKET_MAIN_TYPE,
    TASK.TICKET_TYPE, TASK.TICKET_SUB_TYPE, TASK.TEST_FLG, TASK.VER_NO, TASK.BATCH_NO, TASK.TICKET_BATCH_NO, TASK.TASK_NUM,
    TASK.BEGIN_NO, TASK.SVT_TICKET_TYPE, TASK.END_NO, TASK.DEP_AMT, TASK.INIT_AMT, TASK.REWARD_AMT, TASK.VALID_DAYS, TASK.BEGIN_DATE,
    TASK.FINISH_NUM, TASK.WASTE_NUM, TASK.TICK_USE_TIMES, TASK.IS_MONTH_CARD, TASK.RIDE_PRIMESSION, TASK.IS_NAMED_CARD,
    TASK.IS_ACTIVE, TASK.IS_PRINT_PHOTO, TASK.TASK_ASSN_STAT, TASK.TASK_EXEC_STAT, TASK.GEN_TMS, TASK.LAST_UPD_ID,
    TASK.LAST_UPD_TMS,TASK.IS_MEMORIAL,TASK.WALLET_UNIT,TASK.APPR_DATE,TASK.APPR_USER,TASK.APPR_STAT,TASK.TICKET_STATUS,
    ASSIGN.TASK_NO ATASK_NO,ASSIGN.ES_CODE AES_CODE,ASSIGN.BEGIN_NO ABEGIN_NO,ASSIGN.TASK_NUM ATASK_NUM,ASSIGN.END_NO AEND_NO,ASSIGN.TASK_STAT ATASK_STAT,ASSIGN.FILE_NM AFILE_NM,
    ASSIGN.LAST_UPD_ID ALAST_UPD_ID,ASSIGN.LAST_UPD_TMS ALAST_UPD_TMS
         from
         TBL_TKT_ES_TASK TASK
         LEFT JOIN
         TBL_TKT_ES_ASSIGN ASSIGN
         ON TASK.TASK_NO = ASSIGN.TASK_NO
         WHERE TASK_TYPE BETWEEN '1' AND '2'
         <if test="taskNo != null and taskNo != ''">
             AND TASK.TASK_NO = #{taskNo}
         </if>
         <if test="planNo != null and planNo != ''">
             AND TASK.PLAN_NO = #{planNo}
         </if>
         <if test="taskAssnStat != null and taskAssnStat != ''">
             AND TASK.TASK_ASSN_STAT = #{taskAssnStat}
         </if>
         <if test="taskExecStat != null and taskExecStat != ''">
             AND TASK.TASK_EXEC_STAT = #{taskExecStat}
         </if>
        <if test="taskType != null and taskType != ''">
            AND TASK.TASK_TYPE = #{taskType}
        </if>
        <if test="ticketType != null and ticketType != ''">
            AND TASK.TICKET_TYPE = #{ticketType}
        </if>
        ORDER BY TASK.TASK_NO DESC


    </select>
    <select id="tasksByDateAndEsNodeId"
            resultMap="BaseResultMap">
        select
        TASK.TASK_NO,TASK.PLAN_NO,TASK.CHECKOUT_NO,TASK.TASK_TYPE,TASK.PLAN_DATE,TASK.ACT_DATE, TASK.TICKET_MAIN_TYPE,
    TASK.TICKET_TYPE, TASK.TICKET_SUB_TYPE, TASK.TEST_FLG, TASK.VER_NO, TASK.BATCH_NO, TASK.TICKET_BATCH_NO, TASK.TASK_NUM,
    TASK.BEGIN_NO, TASK.SVT_TICKET_TYPE, TASK.END_NO, TASK.DEP_AMT, TASK.INIT_AMT, TASK.REWARD_AMT, TASK.VALID_DAYS, TASK.BEGIN_DATE,
    TASK.FINISH_NUM, TASK.WASTE_NUM, TASK.TICK_USE_TIMES, TASK.IS_MONTH_CARD, TASK.RIDE_PRIMESSION, TASK.IS_NAMED_CARD,
    TASK.IS_ACTIVE, TASK.IS_PRINT_PHOTO, TASK.TASK_ASSN_STAT, TASK.TASK_EXEC_STAT, TASK.GEN_TMS, TASK.LAST_UPD_ID,
    TASK.LAST_UPD_TMS,TASK.IS_MEMORIAL,TASK.WALLET_UNIT,TASK.APPR_DATE,TASK.APPR_USER,TASK.APPR_STAT,TASK.TICKET_STATUS
        from
        TBL_TKT_ES_TASK TASK
         LEFT JOIN
         TBL_TKT_ES_ASSIGN ASSIGN
         ON TASK.TASK_NO = ASSIGN.TASK_NO
         where
         task.TASK_ASSN_STAT = '1'
         and TASK.TASK_EXEC_STAT = '0'
         and TASK.PLAN_DATE = #{date}
         AND ASSIGN.ES_CODE = #{esCode}
    </select>
    <select id="getTaskTypeByTaskNo" resultType="java.lang.String">
        SELECT TASK_TYPE FROM TBL_TKT_ES_TASK WHERE TASK_NO = #{value}
    </select>

    <select id="selectByPrimaryKey" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List" />
        from TBL_TKT_ES_TASK
        where TASK_NO = #{taskNo,jdbcType=VARCHAR}
    </select>
    <select id="selectThePlanNoTasks"
            resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM
        TBL_TKT_ES_TASK
        WHERE
        PLAN_NO = #{planNo}
        order by GEN_TMS
    </select>
    <select id="allCustomTask" parameterType="com.chinasofti.huateng.acc.es.server.model.TblTktEsTask" resultMap="BaseResultMap">
        SELECT
        TASK.TASK_NO,TASK.PLAN_NO,TASK.CHECKOUT_NO,TASK.TASK_TYPE,TASK.PLAN_DATE,TASK.ACT_DATE, TASK.TICKET_MAIN_TYPE,
        TASK.TICKET_TYPE, TASK.TICKET_SUB_TYPE, TASK.TEST_FLG, TASK.VER_NO, TASK.BATCH_NO, TASK.TICKET_BATCH_NO, TASK.TASK_NUM,
        TASK.BEGIN_NO, TASK.SVT_TICKET_TYPE, TASK.END_NO, TASK.DEP_AMT, TASK.INIT_AMT, TASK.REWARD_AMT, TASK.VALID_DAYS, TASK.BEGIN_DATE,
        TASK.FINISH_NUM, TASK.WASTE_NUM, TASK.TICK_USE_TIMES, TASK.IS_MONTH_CARD, TASK.RIDE_PRIMESSION, TASK.IS_NAMED_CARD,
        TASK.IS_ACTIVE, TASK.IS_PRINT_PHOTO, TASK.TASK_ASSN_STAT, TASK.TASK_EXEC_STAT, TASK.GEN_TMS, TASK.LAST_UPD_ID,
        TASK.LAST_UPD_TMS,TASK.IS_MEMORIAL,TASK.WALLET_UNIT,TASK.APPR_DATE,TASK.APPR_USER,TASK.APPR_STAT,
        TASK.FILE_NAME,TASK.RIDE_NUM_TYPE,TASK.SPECIFY_STATIONS,TASK.SPECIFY_AREAS,TASK.SPECIFY_LINES,TASK.CREATE_USER,
        ASSIGN.TASK_NO ATASK_NO,ASSIGN.ES_CODE AES_CODE,ASSIGN.BEGIN_NO ABEGIN_NO,ASSIGN.TASK_NUM ATASK_NUM,ASSIGN.END_NO AEND_NO,ASSIGN.TASK_STAT ATASK_STAT,ASSIGN.FILE_NM FILE_NM,
        ASSIGN.LAST_UPD_ID ALAST_UPD_ID,ASSIGN.LAST_UPD_TMS ALAST_UPD_TMS
        from
        TBL_TKT_ES_TASK TASK
        LEFT JOIN
        TBL_TKT_ES_ASSIGN ASSIGN
        ON TASK.TASK_NO = ASSIGN.TASK_NO

        <trim prefix="WHERE" prefixOverrides="AND |OR ">
            <if test="taskNo != null and taskNo != ''">
                AND TASK.TASK_NO = #{taskNo,jdbcType=VARCHAR}
            </if>
            <if test="apprStat != null and apprStat != ''">
                AND TASK.APPR_STAT = #{apprStat,jdbcType=CHAR}
            </if>
            <if test="taskAssnStat != null and taskAssnStat != ''">
                AND TASK.TASK_ASSN_STAT = #{taskAssnStat,jdbcType=CHAR}
            </if>
            <if test="taskExecStat != null and taskExecStat != ''">
                AND TASK.TASK_EXEC_STAT = #{taskExecStat,jdbcType=CHAR}
            </if>
            AND TASK.TASK_TYPE = #{taskType,jdbcType=CHAR}
        </trim>
        ORDER BY TASK.TASK_NO DESC

</select>
    <delete id="deleteByPrimaryKey" parameterType="java.lang.Integer">
    delete from TBL_TKT_ES_TASK
    where TASK_NO = #{taskNo,jdbcType=VARCHAR}
  </delete>
    <delete id="deleteByPlanNo" parameterType="java.lang.Integer">
    delete from TBL_TKT_ES_TASK
    where PLAN_NO = #{planNo,jdbcType=VARCHAR}
  </delete>
    <insert id="insert" keyColumn="TASK_NO" keyProperty="taskNo" parameterType="com.chinasofti.huateng.acc.es.server.model.TblTktEsTask">
    <selectKey order="BEFORE" resultType="java.lang.Integer" keyProperty="taskNo">
        SELECT ES_TASK_SEQ.NEXTVAL AS taskNo FROM DUAL
    </selectKey>
    insert into TBL_TKT_ES_TASK (TASK_NO,PLAN_NO, CHECKOUT_NO, TASK_TYPE,
      PLAN_DATE, ACT_DATE, TICKET_MAIN_TYPE,
      TICKET_TYPE, TICKET_SUB_TYPE, TEST_FLG,
      VER_NO, BATCH_NO, TICKET_BATCH_NO,
      TASK_NUM, BEGIN_NO, SVT_TICKET_TYPE,
      END_NO, DEP_AMT, INIT_AMT,
      REWARD_AMT, VALID_DAYS, BEGIN_DATE,
      FINISH_NUM, WASTE_NUM, TICK_USE_TIMES,
      IS_MONTH_CARD, RIDE_PRIMESSION, IS_NAMED_CARD,
      IS_ACTIVE, IS_PRINT_PHOTO, TASK_ASSN_STAT,
      TASK_EXEC_STAT, GEN_TMS, LAST_UPD_ID,
      LAST_UPD_TMS,IS_MEMORIAL,WALLET_UNIT,APPR_DATE,APPR_USER,APPR_STAT,FILE_NAME,RIDE_NUM_TYPE,SPECIFY_STATIONS,SPECIFY_AREAS,SPECIFY_LINES,CREATE_USER,TICKET_STATUS)
    values (#{taskNo,jdbcType=NUMERIC},#{planNo,jdbcType=CHAR}, #{checkoutNo,jdbcType=CHAR}, #{taskType,jdbcType=CHAR},
      #{planDate,jdbcType=CHAR}, #{actDate,jdbcType=CHAR}, #{ticketMainType,jdbcType=DECIMAL},
      #{ticketType,jdbcType=DECIMAL}, #{ticketSubType,jdbcType=DECIMAL}, #{testFlg,jdbcType=CHAR},
      #{verNo,jdbcType=CHAR}, #{batchNo,jdbcType=CHAR}, #{ticketBatchNo,jdbcType=CHAR},
      #{taskNum,jdbcType=DECIMAL}, #{beginNo,jdbcType=DECIMAL}, #{svtTicketType,jdbcType=DECIMAL},
      #{endNo,jdbcType=DECIMAL}, #{depAmt,jdbcType=DECIMAL}, #{initAmt,jdbcType=DECIMAL},
      #{rewardAmt,jdbcType=DECIMAL}, #{validDays,jdbcType=DECIMAL}, #{beginDate,jdbcType=CHAR},
      #{finishNum,jdbcType=DECIMAL}, #{wasteNum,jdbcType=DECIMAL}, #{tickUseTimes,jdbcType=DECIMAL},
      #{isMonthCard,jdbcType=CHAR}, #{ridePrimession,jdbcType=CHAR}, #{isNamedCard,jdbcType=CHAR},
      #{isActive,jdbcType=CHAR}, #{isPrintPhoto,jdbcType=CHAR}, #{taskAssnStat,jdbcType=CHAR},
      #{taskExecStat,jdbcType=CHAR}, SYSDATE, #{lastUpdId,jdbcType=VARCHAR},
      SYSDATE,#{isMemorial,jdbcType=CHAR},#{walletUnit,jdbcType=CHAR},#{apprDate,jdbcType=CHAR},#{apprUser,jdbcType=VARCHAR},#{apprStat,jdbcType=CHAR},#{fileName,jdbcType=CHAR},#{rideNumType,jdbcType=CHAR},
            #{specifyStations,jdbcType=VARCHAR},#{specifyAreas,jdbcType=VARCHAR},#{specifyLines,jdbcType=VARCHAR},#{createUser,jdbcType=VARCHAR},#{ticketStatus,jdbcType=VARCHAR})

  </insert>
    <insert id="insertSelective" keyColumn="TASK_NO" keyProperty="taskNo" parameterType="com.chinasofti.huateng.acc.es.server.model.TblTktEsTask" useGeneratedKeys="true">
        insert into TBL_TKT_ES_TASK
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="planNo != null">
                PLAN_NO,
            </if>
            <if test="checkoutNo != null">
                CHECKOUT_NO,
            </if>
            <if test="taskType != null">
                TASK_TYPE,
            </if>
            <if test="planDate != null">
                PLAN_DATE,
            </if>
            <if test="actDate != null">
                ACT_DATE,
            </if>
            <if test="ticketMainType != null">
                TICKET_MAIN_TYPE,
            </if>
            <if test="ticketType != null">
                TICKET_TYPE,
            </if>
            <if test="ticketSubType != null">
                TICKET_SUB_TYPE,
            </if>
            <if test="testFlg != null">
                TEST_FLG,
            </if>
            <if test="verNo != null">
                VER_NO,
            </if>
            <if test="batchNo != null">
                BATCH_NO,
            </if>
            <if test="ticketBatchNo != null">
                TICKET_BATCH_NO,
            </if>
            <if test="taskNum != null">
                TASK_NUM,
            </if>
            <if test="beginNo != null">
                BEGIN_NO,
            </if>
            <if test="svtTicketType != null">
                SVT_TICKET_TYPE,
            </if>
            <if test="endNo != null">
                END_NO,
            </if>
            <if test="depAmt != null">
                DEP_AMT,
            </if>
            <if test="initAmt != null">
                INIT_AMT,
            </if>
            <if test="rewardAmt != null">
                REWARD_AMT,
            </if>
            <if test="validDays != null">
                VALID_DAYS,
            </if>
            <if test="beginDate != null">
                BEGIN_DATE,
            </if>
            <if test="finishNum != null">
