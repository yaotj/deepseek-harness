        WHERE TASK_NO = #{taskNo}

    </update>
    <update id="reportCancelTaskReport" parameterType="com.chinasofti.huateng.acc.es.server.netty.data.CancelTaskReport">
        UPDATE TBL_TKT_ES_TASK
            SET LAST_UPD_ID = #{operator},
             LAST_UPD_TMS = SYSDATE,
             FINISH_NUM = #{completedNum},
             WASTE_NUM = #{errorNum},
             TASK_EXEC_STAT = '3',
             ACT_DATE =  TO_CHAR(sysdate,'yyyymmdd')
        WHERE TASK_NO = #{taskNo}
    </update>
    <update id="reportRecodeTaskReport" parameterType="com.chinasofti.huateng.acc.es.server.netty.data.RecodeTaskReport">
        UPDATE TBL_TKT_ES_TASK
            SET LAST_UPD_ID = #{operator},
             LAST_UPD_TMS = SYSDATE,
             FINISH_NUM = #{completeNum},
             WASTE_NUM = #{wastedNum},
