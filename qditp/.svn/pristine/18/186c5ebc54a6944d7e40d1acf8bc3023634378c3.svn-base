    BEGIN_NO, SVT_TICKET_TYPE, END_NO, DEP_AMT, INIT_AMT, REWARD_AMT, VALID_DAYS, BEGIN_DATE,
    FINISH_NUM, WASTE_NUM, TICK_USE_TIMES, IS_MONTH_CARD, RIDE_PRIMESSION, IS_NAMED_CARD,
    IS_ACTIVE, IS_PRINT_PHOTO, TASK_ASSN_STAT, TASK_EXEC_STAT, GEN_TMS, LAST_UPD_ID,LAST_UPD_TMS,
    IS_MEMORIAL,WALLET_UNIT,APPR_DATE,APPR_USER,APPR_STAT,FILE_NAME,RIDE_NUM_TYPE,SPECIFY_STATIONS,SPECIFY_AREAS,SPECIFY_LINES,CREATE_USER,TICKET_STATUS
  </sql>

    <update id="updateTaskAssignStat">
        UPDATE TBL_TKT_ES_TASK SET TASK_ASSN_STAT = #{assigen} WHERE TASK_NO = #{taskNo}
    </update>
    <update id="reportPublishTaskReport" parameterType="com.chinasofti.huateng.acc.es.server.netty.data.PublishTaskReport">
        UPDATE TBL_TKT_ES_TASK
            SET LAST_UPD_ID = #{operator},
             LAST_UPD_TMS = SYSDATE,
             FINISH_NUM = #{completedNum},
             WASTE_NUM = #{wastedNum},
             TASK_EXEC_STAT = '3',
             ACT_DATE = TO_CHAR(sysdate,'yyyymmdd')
        WHERE TASK_NO = #{taskNo}
    </update>
    <update id="reportPreAssignTaskReport" parameterType="com.chinasofti.huateng.acc.es.server.netty.data.PreAssignTaskReport">
        UPDATE TBL_TKT_ES_TASK
            SET LAST_UPD_ID = #{operator},
             LAST_UPD_TMS = SYSDATE,
             FINISH_NUM = #{completedNum},
             WASTE_NUM = #{errorNum},
             TASK_EXEC_STAT = '3',
             ACT_DATE = TO_CHAR(sysdate,'yyyymmdd')
        WHERE TASK_NO = #{taskNo}
    </update>
    <update id="reportHandCancelTaskReport" parameterType="com.chinasofti.huateng.acc.es.server.netty.data.HandCancelTaskReport">
        UPDATE TBL_TKT_ES_TASK
            SET LAST_UPD_ID = #{operator},
             LAST_UPD_TMS = SYSDATE,
             FINISH_NUM = #{completedNum},
             WASTE_NUM = #{errorNum},
             TASK_EXEC_STAT = '3',
