        <association property="esAssign" javaType="com.chinasofti.huateng.acc.es.server.model.TblTktEsAssign" column="TASK_NO">
            <id column="ATASK_NO" jdbcType="VARCHAR" property="taskNo"/>
            <result column="AES_CODE" property="esCode" jdbcType="VARCHAR"/>
            <result column="ABEGIN_NO" property="beginNo" jdbcType="NUMERIC"/>
            <result column="ATASK_NUM" property="taskNum" jdbcType="NUMERIC"/>
            <result column="AEND_NO" property="endNo" jdbcType="NUMERIC"/>
