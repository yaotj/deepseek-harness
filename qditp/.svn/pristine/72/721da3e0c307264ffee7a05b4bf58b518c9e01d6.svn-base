package com.chinasofti.huateng.acc.es.server.enumns;

import lombok.Getter;

@Getter
public enum TaskApplyStat {

    APPLYING("0","申请中"),
    AGREED("1","审批通过"),
    REFUSED("2","拒绝通过");

    private final String code;

    private final String label;

    private TaskApplyStat(String code,String label) {
        this.code = code;
        this.label = label;
    }
}
