package com.chinasofti.huateng.model.front.response;

import com.fasterxml.jackson.annotation.JsonInclude;

@JsonInclude(JsonInclude.Include.NON_NULL)
public class ResponseHead {
    private String reqId;
    private String respCode;
    private String respMsg;
    private String respTime;
    private String cryptType;
    private String cryptIndex;

    public ResponseHead() {
        this.cryptType = "00";
    }
    public String getReqId() {
        return reqId;
    }

    public void setReqId(String reqId) {
        this.reqId = reqId;
    }

    public String getRespCode() {
        return respCode;
    }

    public void setRespCode(String respCode) {
        this.respCode = respCode;
    }

    public String getRespMsg() {
        return respMsg;
    }

    public void setRespMsg(String respMsg) {
        this.respMsg = respMsg;
    }

    public String getRespTime() {
        return respTime;
    }

    public void setRespTime(String respTime) {
        this.respTime = respTime;
    }

    public String getCryptType() {
        return cryptType;
    }

    public void setCryptType(String cryptType) {
        this.cryptType = cryptType;
    }

    public String getCryptIndex() {
        return cryptIndex;
    }

    public void setCryptIndex(String cryptIndex) {
        this.cryptIndex = cryptIndex;
    }
}
