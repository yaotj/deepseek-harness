package com.chinasofti.huateng.model.frs.vo;


import com.chinasofti.huateng.model.frs.RulLineAreaDTO;

public class LineAreaVO {
    String preLineAreaNo;

    RulLineAreaDTO lineArea;

    public String getPreLineAreaNo() {
        return preLineAreaNo;
    }

    public void setPreLineAreaNo(String preLineAreaNo) {
        this.preLineAreaNo = preLineAreaNo;
    }

    public RulLineAreaDTO getLineArea() {
        return lineArea;
    }

    public void setLineArea(RulLineAreaDTO lineArea) {
        this.lineArea = lineArea;
    }

}
