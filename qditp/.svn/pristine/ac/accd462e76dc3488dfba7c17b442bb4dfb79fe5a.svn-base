package com.chinasofti.huateng.model.autoclear;


import java.io.Serializable;

public class TblTxnSum implements Serializable {
    private static final long serialVersionUID = -4492646596004096756L;

    private Integer normalCount;

    private Long normalTxnAmt;

    private Integer dubCount;

    private Long dubTxnAmt;

    private Integer adjCount;

    private Long adjTxnAmt;

    public Integer getNormalCount() {
        return normalCount;
    }

    public void setNormalCount(Integer normalCount) {
        this.normalCount = normalCount;
    }

    public Long getNormalTxnAmt() {
        return normalTxnAmt;
    }

    public void setNormalTxnAmt(Long normalTxnAmt) {
        this.normalTxnAmt = normalTxnAmt;
    }

    public Integer getDubCount() {
        return dubCount;
    }

    public void setDubCount(Integer dubCount) {
        this.dubCount = dubCount;
    }

    public Long getDubTxnAmt() {
        return dubTxnAmt;
    }

    public void setDubTxnAmt(Long dubTxnAmt) {
        this.dubTxnAmt = dubTxnAmt;
    }

    public Integer getAdjCount() {
        return adjCount;
    }

    public void setAdjCount(Integer adjCount) {
        this.adjCount = adjCount;
    }

    public Long getAdjTxnAmt() {
        return adjTxnAmt;
    }

    public void setAdjTxnAmt(Long adjTxnAmt) {
        this.adjTxnAmt = adjTxnAmt;
    }
}
