<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinasofti.huateng.collectpay.mapper.TvmAppOrderMapper">
    <resultMap id="BaseResultMap" type="com.chinasofti.huateng.collectpay.entity.TvmAppOrder">
        <id column="ORDER_NO" jdbcType="VARCHAR" property="orderNo"/>
        <result column="USER_ID" jdbcType="VARCHAR" property="userId"/>
        <result column="IN_STATION_CODE" jdbcType="VARCHAR" property="inStationCode"/>
        <result column="OUT_STATION_CODE" jdbcType="VARCHAR" property="outStationCode"/>
        <result column="TICKET_PRICE" jdbcType="VARCHAR" property="ticketPrice"/>
        <result column="TICKET_NUM" jdbcType="VARCHAR" property="ticketNum"/>
        <result column="totalPrice" jdbcType="VARCHAR" property="totalPrice"/>
        <result column="TICKET_TYPE" jdbcType="VARCHAR" property="ticketType"/>
        <result column="PAY_STATUS" jdbcType="VARCHAR" property="payStatus"/>
        <result column="MSG" jdbcType="VARCHAR" property="msg"/>
        <result column="REQUEST_PAY_FLAG" jdbcType="VARCHAR" property="requestPayFlag"/>
        <result column="PAY_CHANNEL_CODE" jdbcType="VARCHAR" property="payChannelCode"/>
        <result column="merchantOrderNo" jdbcType="VARCHAR" property="merchantOrderNo"/>
        <result column="PAYCENTER_ORDERNO" jdbcType="VARCHAR" property="payCenterOrderNo"/>
        <result column="PAYCENTER_CHANNEL_ORDERNO" jdbcType="VARCHAR" property="payCenterChannelOrderNo"/>
        <result column="PAY_AMOUNT" jdbcType="VARCHAR" property="payAmount"/>
        <result column="PAY_TIME" jdbcType="VARCHAR" property="payTime"/>
        <result column="PAYMENTINFO" jdbcType="VARCHAR" property="paymentInfo"/>
        <result column="ACTIVATE_FLAG" jdbcType="VARCHAR" property="activateFlag"/>
        <result column="DEVICE_ID" jdbcType="VARCHAR" property="deviceId"/>
        <result column="QRCODE_GEN_DATE" jdbcType="VARCHAR" property="qrcodeGenDate"/>
        <result column="RANDOM_FACT" jdbcType="VARCHAR" property="randomFact"/>
        <result column="ACTIVE_TIME" jdbcType="VARCHAR" property="activeTime"/>
        <result column="CREATE_TIME" jdbcType="VARCHAR" property="createTime"/>
        <result column="UPDATE_TIME" jdbcType="VARCHAR" property="updateTime"/>
        <result column="RSV1" jdbcType="VARCHAR" property="rsv1"/>
        <result column="RSV2" jdbcType="VARCHAR" property="rsv2"/>
    </resultMap>

    <sql id="Base_Column_List">
        ORDER_NO, USER_ID, IN_STATION_CODE, OUT_STATION_CODE, TICKET_PRICE,
        TICKET_NUM,totalPrice, TICKET_TYPE, PAY_STATUS, MSG,REQUEST_PAY_FLAG, PAY_CHANNEL_CODE,merchantOrderNo,
        PAYCENTER_ORDERNO, PAYCENTER_CHANNEL_ORDERNO,PAY_AMOUNT, PAY_TIME,paymentInfo,ACTIVATE_FLAG,DEVICE_ID,QRCODE_GEN_DATE,RANDOM_FACT,ACTIVE_TIME,
        CREATE_TIME, UPDATE_TIME, RSV1, RSV2
    </sql>

    <select id="selectByOrderNo" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from TBL_TVM_APP_ORDER
        where ORDER_NO = #{orderNo,jdbcType=VARCHAR}
    </select>

    <select id="selectByOrderNoAndUserId" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from TBL_TVM_APP_ORDER
        where ORDER_NO = #{orderNo,jdbcType=VARCHAR} and USER_ID = #{userId,jdbcType=VARCHAR}
    </select>

    <insert id="insert" parameterType="com.chinasofti.huateng.collectpay.entity.TvmAppOrder">
        insert into TBL_TVM_APP_ORDER (
            ORDER_NO, USER_ID, IN_STATION_CODE, OUT_STATION_CODE, TICKET_PRICE,
            TICKET_NUM, totalPrice,TICKET_TYPE, PAY_STATUS, MSG,REQUEST_PAY_FLAG,ACTIVATE_FLAG, PAY_CHANNEL_CODE,merchantOrderNo,
        PAYCENTER_ORDERNO, PAYCENTER_CHANNEL_ORDERNO, PAY_AMOUNT, PAY_TIME,paymentInfo,
            CREATE_TIME, UPDATE_TIME, RSV1, RSV2
        ) values (
            #{orderNo,jdbcType=VARCHAR},
            #{userId,jdbcType=VARCHAR},
            #{inStationCode,jdbcType=VARCHAR},
            #{outStationCode,jdbcType=VARCHAR},
            #{ticketPrice,jdbcType=VARCHAR},
            #{ticketNum,jdbcType=VARCHAR},
            #{totalPrice,jdbcType=VARCHAR},
            #{ticketType,jdbcType=VARCHAR},
            #{payStatus,jdbcType=VARCHAR},
            #{msg,jdbcType=VARCHAR},
            #{requestPayFlag,jdbcType=VARCHAR},
            #{activateFlag,jdbcType=VARCHAR},
            #{payChannelCode,jdbcType=VARCHAR},
            #{merchantOrderNo,jdbcType=VARCHAR},
            #{payCenterOrderNo,jdbcType=VARCHAR},
            #{payCenterChannelOrderNo,jdbcType=VARCHAR},
            #{payAmount,jdbcType=VARCHAR},
            #{payTime,jdbcType=VARCHAR},
            #{paymentInfo,jdbcType=VARCHAR},
            #{createTime,jdbcType=VARCHAR},
            #{updateTime,jdbcType=VARCHAR},
            #{rsv1,jdbcType=VARCHAR},
            #{rsv2,jdbcType=VARCHAR}
        )
    </insert>

    <update id="updateByOrderNo" parameterType="java.util.Map">
        update TBL_TVM_APP_ORDER
        <set>
            <if test="userId != null">USER_ID = #{userId,jdbcType=VARCHAR},</if>
            <if test="inStationCode != null">IN_STATION_CODE = #{inStationCode,jdbcType=VARCHAR},</if>
            <if test="outStationCode != null">OUT_STATION_CODE = #{outStationCode,jdbcType=VARCHAR},</if>
            <if test="ticketPrice != null">TICKET_PRICE = #{ticketPrice,jdbcType=VARCHAR},</if>
            <if test="ticketNum != null">TICKET_NUM = #{ticketNum,jdbcType=VARCHAR},</if>
            <if test="totalPrice != null">totalPrice = #{totalPrice,jdbcType=VARCHAR},</if>
            <if test="ticketType != null">TICKET_TYPE = #{ticketType,jdbcType=VARCHAR},</if>
            <if test="payStatus != null">PAY_STATUS = #{payStatus,jdbcType=VARCHAR},</if>
            <if test="msg != null">msg = #{msg,jdbcType=VARCHAR},</if>
            <if test="requestPayFlag != null">REQUEST_PAY_FLAG = #{requestPayFlag,jdbcType=VARCHAR},</if>
            <if test="payChannelCode != null">PAY_CHANNEL_CODE = #{payChannelCode,jdbcType=VARCHAR},</if>
            <if test="merchantOrderNo != null">merchantOrderNo = #{merchantOrderNo,jdbcType=VARCHAR},</if>
            <if test="payCenterOrderNo != null">PAYCENTER_ORDERNO = #{payCenterOrderNo,jdbcType=VARCHAR},</if>
            <if test="payCenterChannelOrderNo != null">PAYCENTER_CHANNEL_ORDERNO = #{payCenterChannelOrderNo,jdbcType=VARCHAR},</if>
            <if test="payAmount != null">PAY_AMOUNT = #{payAmount,jdbcType=VARCHAR},</if>
            <if test="payTime != null">PAY_TIME = #{payTime,jdbcType=VARCHAR},</if>
            <if test="paymentInfo != null">paymentInfo = #{paymentInfo,jdbcType=VARCHAR},</if>
            <if test="activateFlag != null">ACTIVATE_FLAG = #{activateFlag,jdbcType=VARCHAR},</if>
            <if test="deviceId != null">DEVICE_ID = #{deviceId,jdbcType=VARCHAR},</if>
            <if test="qrcodeGenDate != null">QRCODE_GEN_DATE = #{qrcodeGenDate,jdbcType=VARCHAR},</if>
            <if test="randomFact != null">RANDOM_FACT = #{randomFact,jdbcType=VARCHAR},</if>
            <if test="activeTime != null">ACTIVE_TIME = #{activeTime,jdbcType=VARCHAR},</if>
            <if test="updateTime != null">UPDATE_TIME = #{updateTime,jdbcType=VARCHAR},</if>
            <if test="rsv1 != null">RSV1 = #{rsv1,jdbcType=VARCHAR},</if>
            <if test="rsv2 != null">RSV2 = #{rsv2,jdbcType=VARCHAR},</if>
        </set>
        where ORDER_NO = #{orderNo,jdbcType=VARCHAR}
    </update>

    <select id="selectByDeviceAndQrcode" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from TBL_TVM_APP_ORDER
        where DEVICE_ID = #{deviceId,jdbcType=VARCHAR}
        and QRCODE_GEN_DATE = #{qrcodeGenDate,jdbcType=VARCHAR}
        and RANDOM_FACT = #{randomFact,jdbcType=VARCHAR}
    </select>

    <select id="selectOrderLsByUserId" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from TBL_TVM_APP_ORDER
        where USER_ID = #{userId,jdbcType=VARCHAR}
        and ACTIVATE_FLAG = #{activeFlag,jdbcType=VARCHAR}
    </select>


</mapper>