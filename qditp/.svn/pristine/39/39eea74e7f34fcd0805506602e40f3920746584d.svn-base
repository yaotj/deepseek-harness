package com.chinasofti.huateng.alipay.paysign.service.impl;

import com.alibaba.fastjson2.JSON;
import com.alibaba.fastjson2.JSONObject;
import com.chinasofti.huateng.model.app.LineCodeRecordDTO;
import com.chinasofti.huateng.model.app.RequestLineCodeListReqDTO;
import com.chinasofti.huateng.model.app.RequestLineCodeListResult;
import com.chinasofti.huateng.model.app.RequestStationNameReqDTO;
import com.chinasofti.huateng.model.app.RequestStationNameResult;
import com.chinasofti.huateng.rpc.para.ParaClient;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Component;
import org.springframework.util.StringUtils;

@Component
public class IndustryDetailEnricher {
    private final ParaClient paraClient;

    public IndustryDetailEnricher(ParaClient paraClient) {
        this.paraClient = paraClient;
    }

    private static final Logger log = LoggerFactory.getLogger(IndustryDetailEnricher.class);

    public String enrich(String industryDetail, String cardNum) {
        if (!StringUtils.hasText(industryDetail)) {
            return industryDetail;
        }
        try {
            JSONObject detailObj = JSON.parseObject(industryDetail);
            enrichStationNames(detailObj);
            enrichLineCodes(detailObj);
            enrichTripSeq(detailObj, cardNum);
            return detailObj.toJSONString();
        } catch (Exception e) {
            log.warn("industryDetail  enrichment failed", e);
            return industryDetail;
        }
    }

    private void enrichStationNames(JSONObject detailObj) {
        String exitStationCode = detailObj.getString("exitStationCode");
        if (StringUtils.hasText(exitStationCode)) {
            String stationName = queryStationName(exitStationCode);
            if (StringUtils.hasText(stationName)) {
                detailObj.put("exitStationName", stationName);
            }
        }
        String entryStationCode = detailObj.getString("entryStationCode");
        if (StringUtils.hasText(entryStationCode)) {
            String stationName = queryStationName(entryStationCode);
            if (StringUtils.hasText(stationName)) {
                detailObj.put("entryStationName", stationName);
            }
        }
    }

    private void enrichLineCodes(JSONObject detailObj) {
        String exitLineCode = detailObj.getString("exitLineCode");
        if (StringUtils.hasText(exitLineCode)) {
            String shortLineCode = exitLineCode.length() > 2 ? exitLineCode.substring(0, 2) : exitLineCode;
            detailObj.put("exitLineCode", shortLineCode);
            String lineName = queryLineName(shortLineCode);
            if (StringUtils.hasText(lineName)) {
                detailObj.put("exitLineName", lineName);
            }
        }
        String entryLineCode = detailObj.getString("entryLineCode");
        if (StringUtils.hasText(entryLineCode)) {
            String shortLineCode = entryLineCode.length() > 2 ? entryLineCode.substring(0, 2) : entryLineCode;
            detailObj.put("entryLineCode", shortLineCode);
            String lineName = queryLineName(shortLineCode);
            if (StringUtils.hasText(lineName)) {
                detailObj.put("entryLineName", lineName);
            }
        }
    }

    private void enrichTripSeq(JSONObject detailObj, String cardNum) {
        String cardNumInDetail = StringUtils.hasText(cardNum) ? cardNum : detailObj.getString("cardNum");
        String entryDate = detailObj.getString("entryDate");
        String exitDate = detailObj.getString("exitDate");

        String entryDateCompact = compactDate(entryDate);
        String exitDateCompact = compactDate(exitDate);

        String entryId = buildId(cardNumInDetail, entryDateCompact, "01");
        String exitId = buildId(cardNumInDetail, exitDateCompact, "02");

        String ticketTransSeq = detailObj.getString("tikcetTransSeq");
        if (!StringUtils.hasText(ticketTransSeq)) {
            ticketTransSeq = entryId;
        }
        if (!StringUtils.hasText(entryId)) {
            entryId = ticketTransSeq;
        }
        if (!StringUtils.hasText(exitId)) {
            exitId = ticketTransSeq;
        }

        detailObj.put("tikcetTransSeq", ticketTransSeq);
        detailObj.put("entryId", entryId);
        detailObj.put("exitId", exitId);
    }

    private String compactDate(String date) {
        if (!StringUtils.hasText(date)) {
            return "";
        }
        String compact = date.replaceAll("[^0-9]", "");
        return compact.length() > 14 ? compact.substring(0, 14) : compact;
    }

    private String buildId(String cardNum, String dateCompact, String suffix) {
        return (StringUtils.hasText(cardNum) ? cardNum : "") +
               (StringUtils.hasText(dateCompact) ? dateCompact : "") + suffix;
    }

    private String queryStationName(String stationCode) {
        try {
            RequestStationNameReqDTO req = new RequestStationNameReqDTO();
            req.setStationCode(stationCode);
            RequestStationNameResult result = this.paraClient.requestStationName(req);
            if (result != null && StringUtils.hasText(result.getStationName())) {
                return result.getStationName();
            }
        } catch (Exception e) {
            log.warn("queryStationName failed, stationCode={}", stationCode, e);
        }
        return null;
    }

    private String queryLineName(String lineCode) {
        try {
            RequestLineCodeListReqDTO req = new RequestLineCodeListReqDTO();
            RequestLineCodeListResult result = this.paraClient.requestLineCodeList(req);
            if (result != null && result.getLineCodeRecord() != null) {
                for (LineCodeRecordDTO record : result.getLineCodeRecord()) {
                    if (lineCode.equals(record.getLineCode())) {
                        return record.getLineNameZH();
                    }
                }
            }
        } catch (Exception e) {
            log.warn("queryLineName failed, lineCode={}", lineCode, e);
        }
        return null;
    }
}
