    </sql>

    <!-- 首次创建支付订单。ID 取序列，业务唯一键是 (ORDER_NO, TXN_DATE) 上的 UK_APTD_ORDER。
         并发下第二条 INSERT 撞唯一索引即「重推」，调用方 MUST 沿 getCause 链判完整性冲突后
         短路成功，NEVER 只 catch 最外层 DuplicateKeyException（本模块已开 tracing，
         观测切面会换异常类型，裸 catch 会静默落空）。 -->
    <insert id="insert" parameterType="com.chinasofti.huateng.alipay.paysign.entity.AlipayPayTxnDetail">
        INSERT INTO ALIPAY_PAY_TXN_DETAIL (
            <include refid="Base_Column_List"/>
        ) VALUES (
            SEQ_ALIPAY_PAY_TXN_DETAIL.NEXTVAL,
            #{orderNo,jdbcType=VARCHAR},
            #{payType,jdbcType=VARCHAR},
            #{payStatus,jdbcType=VARCHAR},
            #{thirdUserId,jdbcType=VARCHAR},
            #{cardId,jdbcType=VARCHAR},
            #{cardType,jdbcType=VARCHAR},
            #{paymentVendor,jdbcType=VARCHAR},
            #{payChannelCode,jdbcType=VARCHAR},
            #{requestSignSeq,jdbcType=VARCHAR},
            #{channelAgreementNo,jdbcType=VARCHAR},
            #{amount,jdbcType=NUMERIC},
            #{totalAmount,jdbcType=NUMERIC},
            #{cashAmount,jdbcType=NUMERIC},
            #{couponAmount,jdbcType=NUMERIC},
            #{refundStatus,jdbcType=VARCHAR},
            #{refundAmount,jdbcType=NUMERIC},
            #{lastRefundTime,jdbcType=TIMESTAMP},
            #{merchantOrderNo,jdbcType=VARCHAR},
            #{payCenterOrderNo,jdbcType=VARCHAR},
            #{channelOrderNo,jdbcType=VARCHAR},
            #{payUserId,jdbcType=VARCHAR},
            #{requestCount,jdbcType=NUMERIC},
            #{nextRequestTime,jdbcType=TIMESTAMP},
            #{lastRequestTime,jdbcType=TIMESTAMP},
            #{firstRequestTime,jdbcType=TIMESTAMP},
            #{responseTime,jdbcType=TIMESTAMP},
            #{payTime,jdbcType=VARCHAR},
            #{txnDate,jdbcType=VARCHAR},
            #{scene,jdbcType=VARCHAR},
            #{industryType,jdbcType=VARCHAR},
            #{subject,jdbcType=VARCHAR},
            #{body,jdbcType=VARCHAR},
            #{authCode,jdbcType=VARCHAR},
            #{notifyUrl,jdbcType=VARCHAR},
            #{returnUrl,jdbcType=VARCHAR},
            #{ipAddress,jdbcType=VARCHAR},
            #{orderTimeOut,jdbcType=NUMERIC},
            #{industryDetail,jdbcType=CLOB},
            #{entryId,jdbcType=VARCHAR},
            #{exitId,jdbcType=VARCHAR},
            #{invoice,jdbcType=VARCHAR},
            #{discountInfo,jdbcType=VARCHAR},
            #{debitRequestResult,jdbcType=VARCHAR},
            #{discountFee,jdbcType=NUMERIC},
            #{resultCode,jdbcType=VARCHAR},
            #{resultMsg,jdbcType=VARCHAR},
            #{remark,jdbcType=VARCHAR},
