    <sql id="Base_Column_List">
        ID, ORDER_NO, PAY_TYPE, PAY_STATUS, THIRD_USER_ID, CARD_ID, CARD_TYPE,
        PAYMENT_VENDOR, PAY_CHANNEL_CODE, REQUEST_SIGN_SEQ, CHANNEL_AGREEMENT_NO,
