<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinasofti.huateng.facepay.mapper.F2fRefundMapper">

    <!--
      注意：本文件内所有 SQL 正文 NEVER 出现 - - 行注释或 /* */ 块注释。
      Druid WallFilter 的 commentAllow=false 会把带注释的语句判定为注入并静默失效
      （只在 Oracle 生产暴露，达梦环境关了 WallFilter 测不出来）。
      说明一律写在 XML 注释里，见 AGENTS.md §5.1。
    -->

    <resultMap id="BaseResultMap" type="com.chinasofti.huateng.facepay.entity.F2fRefund">
        <id column="ID" jdbcType="BIGINT" property="id"/>
        <result column="REFUND_NO" jdbcType="VARCHAR" property="refundNo"/>
        <result column="ORIG_ORDER_NO" jdbcType="VARCHAR" property="origOrderNo"/>
        <result column="TICKET_LOGIC_NUM" jdbcType="VARCHAR" property="ticketLogicNum"/>
        <result column="REFUND_SOURCE" jdbcType="VARCHAR" property="refundSource"/>
        <result column="REFUND_STATUS" jdbcType="VARCHAR" property="refundStatus"/>
        <result column="REFUND_NUM" jdbcType="INTEGER" property="refundNum"/>
        <result column="REFUND_AMOUNT" jdbcType="BIGINT" property="refundAmount"/>
        <result column="REFUND_REASON" jdbcType="VARCHAR" property="refundReason"/>
        <result column="OPERATOR_ID" jdbcType="VARCHAR" property="operatorId"/>
        <result column="DEVICE_ID" jdbcType="VARCHAR" property="deviceId"/>
        <result column="TRANS_TYPE" jdbcType="VARCHAR" property="transType"/>
        <result column="ORIG_TRANS_DATE" jdbcType="VARCHAR" property="origTransDate"/>
        <result column="PAY_CENTER_REFUND_NO" jdbcType="VARCHAR" property="payCenterRefundNo"/>
        <result column="RETRY_TIMES" jdbcType="INTEGER" property="retryTimes"/>
        <result column="FAIL_REASON" jdbcType="VARCHAR" property="failReason"/>
        <result column="REQUEST_TMS" jdbcType="TIMESTAMP" property="requestTms"/>
        <result column="NEXT_QUERY_TMS" jdbcType="TIMESTAMP" property="nextQueryTms"/>
        <result column="FINISH_TMS" jdbcType="TIMESTAMP" property="finishTms"/>
        <result column="CREATE_TMS" jdbcType="TIMESTAMP" property="createTms"/>
        <result column="UPDATE_TMS" jdbcType="TIMESTAMP" property="updateTms"/>
    </resultMap>

    <sql id="Base_Column_List">
        ID, REFUND_NO, ORIG_ORDER_NO, TICKET_LOGIC_NUM, REFUND_SOURCE, REFUND_STATUS,
        REFUND_NUM, REFUND_AMOUNT, REFUND_REASON, OPERATOR_ID, DEVICE_ID, TRANS_TYPE,
        ORIG_TRANS_DATE, PAY_CENTER_REFUND_NO, RETRY_TIMES, FAIL_REASON,
        REQUEST_TMS, NEXT_QUERY_TMS, FINISH_TMS, CREATE_TMS, UPDATE_TMS
    </sql>

    <!--
      ID 由 GENERATED BY DEFAULT AS IDENTITY 生成，不在插入列里。
      REQUEST_TMS / CREATE_TMS / UPDATE_TMS 有 DEFAULT SYSTIMESTAMP，此处显式传值以便单测可控。
      RETRY_TIMES 有 DEFAULT 0，为空时传 0 保持 NOT NULL。

      本语句直接 INSERT，NEVER 先 SELECT 判断是否已退过：
      并发下先查后插无效，两个线程都查不到就都插入，等于重复退款（旧实现的最高优先级缺陷）。
      重复的「原订单 + 票 + 来源」由 UK_F2F_REFUND_IDEM 拦下，
      索引形态是 (ORIG_ORDER_NO, NVL(TICKET_LOGIC_NUM,'#WHOLE#'), REFUND_SOURCE)，
      整单退 TICKET_LOGIC_NUM 为空时用 #WHOLE# 占位，多笔整单退同样撞索引；
      重复 REFUND_NO 由 UK_F2F_REFUND_NO 拦下。
      两者都抛 DuplicateKeyException，由 application 层捕获后按「已退过」处理。
    -->
    <insert id="insert" parameterType="com.chinasofti.huateng.facepay.entity.F2fRefund">
        INSERT INTO F2F_REFUND (
            REFUND_NO, ORIG_ORDER_NO, TICKET_LOGIC_NUM, REFUND_SOURCE, REFUND_STATUS,
            REFUND_NUM, REFUND_AMOUNT, REFUND_REASON, OPERATOR_ID, DEVICE_ID, TRANS_TYPE,
            ORIG_TRANS_DATE, PAY_CENTER_REFUND_NO, RETRY_TIMES, FAIL_REASON,
            REQUEST_TMS, NEXT_QUERY_TMS, FINISH_TMS, CREATE_TMS, UPDATE_TMS
        ) VALUES (
            #{refundNo,jdbcType=VARCHAR},
            #{origOrderNo,jdbcType=VARCHAR},
            #{ticketLogicNum,jdbcType=VARCHAR},
            #{refundSource,jdbcType=VARCHAR},
            #{refundStatus,jdbcType=VARCHAR},
            #{refundNum,jdbcType=INTEGER},
            #{refundAmount,jdbcType=BIGINT},
            #{refundReason,jdbcType=VARCHAR},
            #{operatorId,jdbcType=VARCHAR},
            #{deviceId,jdbcType=VARCHAR},
            #{transType,jdbcType=VARCHAR},
            #{origTransDate,jdbcType=VARCHAR},
            #{payCenterRefundNo,jdbcType=VARCHAR},
            NVL(#{retryTimes,jdbcType=INTEGER}, 0),
            #{failReason,jdbcType=VARCHAR},
            NVL(#{requestTms,jdbcType=TIMESTAMP}, SYSTIMESTAMP),
            NVL(#{nextQueryTms,jdbcType=TIMESTAMP}, SYSTIMESTAMP),
            #{finishTms,jdbcType=TIMESTAMP},
            NVL(#{createTms,jdbcType=TIMESTAMP}, SYSTIMESTAMP),
            NVL(#{updateTms,jdbcType=TIMESTAMP}, SYSTIMESTAMP)
        )
    </insert>

    <!-- 命中 UK_F2F_REFUND_NO。 -->
    <select id="selectByRefundNo" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM F2F_REFUND
        WHERE REFUND_NO = #{refundNo,jdbcType=VARCHAR}
    </select>

    <!-- 一个原订单可能有多条退款单（按票退 + 不同来源），命中 IDX_F2F_REFUND_ORIG。 -->
    <select id="selectByOrigOrderNo" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM F2F_REFUND
        WHERE ORIG_ORDER_NO = #{origOrderNo,jdbcType=VARCHAR}
        ORDER BY REQUEST_TMS, ID
    </select>

    <!-- 退款回调按支付中心单号反查本地单，命中 IDX_F2F_REFUND_CENTER。 -->
    <select id="selectByPayCenterRefundNo" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM F2F_REFUND
        WHERE PAY_CENTER_REFUND_NO = #{payCenterRefundNo,jdbcType=VARCHAR}
    </select>

    <!--
      状态推进白名单。fromStatuses 为空时 foreach 会生成 IN ()，Oracle 直接报语法错误，
      这是有意的——比静默放行所有状态安全。调用方 MUST 传非空集合。
      PAY_CENTER_REFUND_NO 与 FINISH_TMS 传 null 时用 NVL 保留原值，避免回调补号后被后续
      状态推进擦掉。
    -->
    <update id="updateStatus">
        UPDATE F2F_REFUND
        SET REFUND_STATUS = #{toStatus,jdbcType=VARCHAR},
            PAY_CENTER_REFUND_NO = NVL(#{payCenterRefundNo,jdbcType=VARCHAR}, PAY_CENTER_REFUND_NO),
            FINISH_TMS = NVL(#{finishTms,jdbcType=TIMESTAMP}, FINISH_TMS),
            UPDATE_TMS = SYSTIMESTAMP
        WHERE REFUND_NO = #{refundNo,jdbcType=VARCHAR}
          AND REFUND_STATUS IN
        <foreach collection="fromStatuses" item="st" open="(" separator="," close=")">
            #{st,jdbcType=VARCHAR}
        </foreach>
    </update>

    <!--
      扫出到点该查的退款单，命中 IDX_F2F_REFUND_SCAN (REFUND_STATUS, NEXT_QUERY_TMS)：
      WHERE 的前导列是 REFUND_STATUS，范围条件落在 NEXT_QUERY_TMS，与索引列序一致。
      显式 ORDER BY NEXT_QUERY_TMS 是 FETCH FIRST 的前提，到点早的先查。
      statuses 为空时生成 IN () 并报错，有意为之。

      谓词里 NEVER 再加 RETRY_TIMES 上限：次数上限确实存在，但它在 application 层判定
      并显式把单置成 MANUAL。搬进 SQL 就变成「次数一到直接从扫描结果里消失」，
      状态停在 INIT / PROCESSING、无告警无人工入口，那正是原实现的缺陷。
    -->
    <select id="selectRetryCandidates" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM F2F_REFUND
        WHERE REFUND_STATUS IN
        <foreach collection="statuses" item="st" open="(" separator="," close=")">
            #{st,jdbcType=VARCHAR}
        </foreach>
          AND NEXT_QUERY_TMS &lt;= #{now,jdbcType=TIMESTAMP}
        ORDER BY NEXT_QUERY_TMS, ID
        FETCH FIRST #{limit,jdbcType=INTEGER} ROWS ONLY
    </select>

    <!--
      累加重试次数、记失败原因、排下次查询时刻，三件事在同一条 UPDATE 里完成。
      拆成两条会出现「次数加了但没排下次」的中间态，那笔单下一轮立刻被再查一次，退避失效。
      不动 REFUND_STATUS：状态推进只走 updateStatus，避免重试计数顺带把状态改成非法值。
    -->
    <update id="increaseRetryTimes">
        UPDATE F2F_REFUND
        SET RETRY_TIMES = RETRY_TIMES + 1,
            FAIL_REASON = #{failReason,jdbcType=VARCHAR},
            NEXT_QUERY_TMS = #{nextQueryTms,jdbcType=TIMESTAMP},
            UPDATE_TMS = SYSTIMESTAMP
        WHERE REFUND_NO = #{refundNo,jdbcType=VARCHAR}
    </update>

</mapper>
