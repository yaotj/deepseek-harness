<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinasofti.huateng.web.mapper.export.AsyncExportTaskMapper">

    <resultMap type="AsyncExportTask" id="AsyncExportTaskResult">
        <id     property="id"           column="id"             />
        <result property="taskCode"     column="task_code"      />
        <result property="taskName"     column="task_name"      />
        <result property="status"       column="status"         />
        <result property="paramJson"    column="param_json"     />
        <result property="filePath"     column="file_path"      />
        <result property="fileSize"     column="file_size"      />
        <result property="rowCount"     column="row_count"      />
        <result property="errorMsg"     column="error_msg"      />
        <result property="executeTime"  column="execute_time"   />
        <result property="finishTime"   column="finish_time"    />
        <result property="retryCount"   column="retry_count"    />
        <result property="createBy"     column="create_by"      />
        <result property="createTime"   column="create_time"    />
        <result property="updateBy"     column="update_by"      />
        <result property="updateTime"   column="update_time"    />
        <result property="remark"       column="remark"         />
    </resultMap>

    <sql id="selectAsyncExportTaskVo">
        select id, task_code, task_name, status, param_json, file_path, file_size, row_count,
               error_msg, execute_time, finish_time, retry_count,
               create_by, create_time, update_by, update_time, remark
        from async_export_task
    </sql>

    <select id="selectAsyncExportTaskList" parameterType="AsyncExportTask" resultMap="AsyncExportTaskResult">
        <include refid="selectAsyncExportTaskVo"/>
        <where>
            <if test="taskCode != null and taskCode != ''">and task_code = #{taskCode}</if>
            <if test="taskName != null and taskName != ''">and task_name like concat('%', #{taskName}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
            <if test="createBy != null and createBy != ''">and create_by = #{createBy}</if>
            <if test="params.beginTime != null and params.beginTime != ''">
                and create_time &gt;= to_date(#{params.beginTime}, 'yyyy-mm-dd hh24:mi:ss')
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                and create_time &lt;= to_date(#{params.endTime}, 'yyyy-mm-dd hh24:mi:ss')
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="selectAsyncExportTaskById" parameterType="Long" resultMap="AsyncExportTaskResult">
        <include refid="selectAsyncExportTaskVo"/>
        where id = #{id}
    </select>

    <select id="selectPendingTasks" resultMap="AsyncExportTaskResult">
        <include refid="selectAsyncExportTaskVo"/>
        where status = 'PENDING'
        order by create_time asc
    </select>

    <select id="selectPendingTaskByUniqueKey" parameterType="AsyncExportTask" resultMap="AsyncExportTaskResult">
        <include refid="selectAsyncExportTaskVo"/>
        where create_by = #{createBy}
          and task_code = #{taskCode}
          and status = 'PENDING'
          and dbms_lob.compare(param_json, #{paramJson,jdbcType=CLOB}) = 0
          and rownum = 1
    </select>

    <insert id="insertAsyncExportTask" parameterType="AsyncExportTask">
        <selectKey keyProperty="id" resultType="java.lang.Long" order="BEFORE">
            SELECT seq_async_export_task.NEXTVAL FROM DUAL
        </selectKey>
        insert into async_export_task
        <trim prefix="(" suffix=")" suffixOverrides=",">
            id,
            <if test="taskCode != null and taskCode != ''">task_code,</if>
            <if test="taskName != null and taskName != ''">task_name,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="paramJson != null">param_json,</if>
            <if test="filePath != null">file_path,</if>
            <if test="fileSize != null">file_size,</if>
            <if test="rowCount != null">row_count,</if>
            <if test="errorMsg != null">error_msg,</if>
            <if test="executeTime != null">execute_time,</if>
            <if test="finishTime != null">finish_time,</if>
            <if test="retryCount != null">retry_count,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            #{id},
            <if test="taskCode != null and taskCode != ''">#{taskCode},</if>
            <if test="taskName != null and taskName != ''">#{taskName},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="paramJson != null">#{paramJson,jdbcType=CLOB},</if>
            <if test="filePath != null">#{filePath},</if>
            <if test="fileSize != null">#{fileSize},</if>
            <if test="rowCount != null">#{rowCount},</if>
            <if test="errorMsg != null">#{errorMsg,jdbcType=VARCHAR},</if>
            <if test="executeTime != null">#{executeTime},</if>
            <if test="finishTime != null">#{finishTime},</if>
            <if test="retryCount != null">#{retryCount},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateAsyncExportTask" parameterType="AsyncExportTask">
        update async_export_task
        <trim prefix="SET" suffixOverrides=",">
            <if test="taskCode != null and taskCode != ''">task_code = #{taskCode},</if>
            <if test="taskName != null and taskName != ''">task_name = #{taskName},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="paramJson != null">param_json = #{paramJson,jdbcType=CLOB},</if>
            <if test="filePath != null">file_path = #{filePath},</if>
            <if test="fileSize != null">file_size = #{fileSize},</if>
            <if test="rowCount != null">row_count = #{rowCount},</if>
            <if test="errorMsg != null">error_msg = #{errorMsg,jdbcType=VARCHAR},</if>
            <if test="executeTime != null">execute_time = #{executeTime},</if>
            <if test="finishTime != null">finish_time = #{finishTime},</if>
            <if test="retryCount != null">retry_count = #{retryCount},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

</mapper>
