<?xml version="1.0" encoding="UTF-8"?>
<!-- 全服务共用的 Linux 日志配置。由 CustomLoggingConfiguration 在 ApplicationReadyEvent 用 Configurator.initialize 重载，${sys:xxx} 加载时已被赋值；模块自带 logging.config 时本文件完全不参与（当前只有 pay-sign）。详见 docs/ops/生产环境清单.md 附.三 -->
<Configuration monitorInterval="30" status="off" packages="com.chinasofti.huateng.log4j2">

    <Properties>
        <Property name="webLoggerLevel">${sys:webLoggerLevel}</Property>
        <Property name="logPath">${sys:logPath}</Property>
        <Property name="logBakDays">${sys:logBakDays}</Property>
        <Property name="logBakGzCnt">${sys:logBakGzCnt}</Property>
        <Property name="appName">${sys:appName}</Property>
    </Properties>

    <Appenders>
        <RollingFile name="RollingFile" fileName="${logPath}/${appName}.log"
            filePattern="${logPath}/bak/%d{yyyy-MM-dd}-${appName}-%i.log.gz">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %X{traceId} [%t] %-5level %l [] %msg%n" />
            <ErrorInterceptorFilter>
                <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %l [] %msg%n" />
            </ErrorInterceptorFilter>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true" />
                <SizeBasedTriggeringPolicy size="200 MB" />
            </Policies>
            <DefaultRolloverStrategy max="${logBakGzCnt}">
                <Delete basePath="${logPath}/bak/" maxDepth="1">
                    <IfFileName glob="*-${appName}-[0-9]*.log.gz">
                        <IfLastModified age="${logBakDays}" />
                    </IfFileName>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <RollingFile name="tempFile" fileName="${logPath}/check-${appName}.log"
            filePattern="${logPath}/bak/%d{yyyy-MM-dd}-${appName}-check-%i.log.gz">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %X{traceId} [%t] %-5level %l [] %msg%n" />
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true" />
                <SizeBasedTriggeringPolicy size="200 MB" />
            </Policies>
            <DefaultRolloverStrategy max="${logBakGzCnt}">
                <Delete basePath="${logPath}/bak/" maxDepth="1">
                    <IfFileName glob="*-${appName}-check-[0-9]*.log.gz">
                        <IfLastModified age="3" />
                    </IfFileName>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>

        <!-- VictoriaLogs 上报：url 为空即自动禁用（不起线程、不丢日志）；VLOGS_URL 端口 MUST 是 30032 而不是默认 9428；app 取 ${appName}，NEVER 写死服务名；stream 只放低基数字段、traceId 走正文；MDC 白名单只有 traceId/spanId，NEVER 改成全量输出（FirstFilter 会把 authorization 塞进 MDC）。详见 docs/ops/生产环境清单.md 附.三.3 -->
        <VictoriaLogs name="VictoriaLogs" url="${env:VLOGS_URL:-}"
            queueCapacity="8192" batchSize="512" flushIntervalMillis="2000"
            connectTimeoutMillis="2000" requestTimeoutMillis="5000">
            <!-- 两级过滤：MDC 有 x-vlogs-capture=1 即 ACCEPT 全量上报（键 MUST 小写，NEVER 写驼峰），未命中落到 ThresholdFilter、只上报 WARN 及以上 -->
            <Filters>
                <ThreadContextMapFilter onMatch="ACCEPT" onMismatch="NEUTRAL">
                    <KeyValuePair key="x-vlogs-capture" value="1" />
                </ThreadContextMapFilter>
                <ThresholdFilter level="WARN" onMatch="ACCEPT" onMismatch="DENY" />
            </Filters>
            <JsonTemplateLayout eventTemplateUri="classpath:victorialogs-event-template.json">
                <EventTemplateAdditionalField key="app" value="${appName}" />
                <EventTemplateAdditionalField key="host" value="${env:HOSTNAME:-unknown}" />
            </JsonTemplateLayout>
        </VictoriaLogs>

    </Appenders>


    <Loggers>
        <Logger name="org.springframework.web.servlet.DispatcherServlet" level="${webLoggerLevel}" additivity="false">
            <AppenderRef ref="RollingFile" />
        </Logger>

        <Logger name="org.springframework.web.servlet.mvc.method.annotation.RequestMappingHandlerMapping"
            level="${webLoggerLevel}" additivity="false">
            <AppenderRef ref="RollingFile" />
        </Logger>

        <Logger name="org.springframework.web.servlet.mvc.method.annotation.RequestResponseBodyMethodProcessor"
            level="${webLoggerLevel}" additivity="false">
            <AppenderRef ref="RollingFile" />
        </Logger>

        <Logger name="com.chinasofti.huateng.log4j2.CheckLoggerHealth" level="${webLoggerLevel}" additivity="false">
            <AppenderRef ref="tempFile" />
        </Logger>

        <!-- 关键链路埋点专用 logger：LoggerFactory.getLogger("VLOGS")，全量进 VictoriaLogs 不受 Root 阈值限制，additivity=false 防重复推送 -->
        <Logger name="VLOGS" level="INFO" additivity="false">
            <AppenderRef ref="RollingFile" />
            <AppenderRef ref="Console" />
            <AppenderRef ref="VictoriaLogs" />
        </Logger>

        <!-- NEVER 删这个 logger，也 NEVER 给它的 VictoriaLogs 引用加 level 属性：AppenderRef 的 level 是「引用层过滤器」、先于 appender 的 Filters 求值，加了会让业务 INFO 在引用层就被 DENY、永远走不到 ThreadContextMapFilter；也 NEVER 在这里写死 DEBUG（本文件 RollingFile 无 ThresholdFilter 兜底）。详见 docs/ops/生产环境清单.md 附.三.3 -->
        <Logger name="com.chinasofti.huateng" level="${webLoggerLevel}" additivity="false">
            <AppenderRef ref="RollingFile" />
            <AppenderRef ref="Console" />
            <AppenderRef ref="VictoriaLogs" />
        </Logger>

        <Root level="${webLoggerLevel}">
            <AppenderRef ref="RollingFile" />
            <AppenderRef ref="Console" />
            <!-- Root 只把 WARN 及以上推给 VictoriaLogs，NEVER 放到 INFO：各服务报文日志的量与敏感面都不可控 -->
            <AppenderRef ref="VictoriaLogs" level="WARN" />
        </Root>
    </Loggers>
</Configuration>
