<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinasofti.huateng.blacklist.mapper.GraylistMapper">

    <resultMap id="BaseResultMap" type="com.chinasofti.huateng.blacklist.entity.Graylist">
        <id column="ID" jdbcType="NUMERIC" property="id"/>
        <result column="CARD_ID" jdbcType="VARCHAR" property="cardId"/>
        <result column="THIRD_USER_ID" jdbcType="VARCHAR" property="thirdUserId"/>
        <result column="CARD_TYPE" jdbcType="VARCHAR" property="cardType"/>
        <result column="GRAY_SOURCE" jdbcType="VARCHAR" property="graySource"/>
        <result column="BIZ_NO" jdbcType="VARCHAR" property="bizNo"/>
        <result column="REASON" jdbcType="VARCHAR" property="reason"/>
        <result column="CREATE_BY" jdbcType="VARCHAR" property="createBy"/>
        <result column="CREATE_TIME" jdbcType="TIMESTAMP" property="createTime"/>
    </resultMap>

    <sql id="BaseColumnList">
        ID, CARD_ID, THIRD_USER_ID, CARD_TYPE, GRAY_SOURCE, BIZ_NO, REASON, CREATE_BY, CREATE_TIME
    </sql>

    <!-- 全条件可选：用 where 标签而不是恒真条件打头，全部缺省时不产出 WHERE（Druid WallFilter 口径同黑名单页）。 -->
    <select id="selectPage" resultMap="BaseResultMap">
        select
        <include refid="BaseColumnList"/>
        from GRAYLIST
        <where>
            <if test="cardId != null and cardId != ''">
                and CARD_ID = #{cardId,jdbcType=VARCHAR}
            </if>
            <if test="thirdUserId != null and thirdUserId != ''">
                and THIRD_USER_ID = #{thirdUserId,jdbcType=VARCHAR}
            </if>
            <if test="createTimeBegin != null and createTimeBegin != ''">
                and CREATE_TIME &gt;= TO_TIMESTAMP(#{createTimeBegin,jdbcType=VARCHAR}, 'YYYY-MM-DD HH24:MI:SS')
            </if>
            <if test="createTimeEnd != null and createTimeEnd != ''">
                and CREATE_TIME &lt;= TO_TIMESTAMP(#{createTimeEnd,jdbcType=VARCHAR}, 'YYYY-MM-DD HH24:MI:SS')
            </if>
        </where>
        order by CREATE_TIME desc, ID desc
    </select>

    <select id="selectByCardId" resultMap="BaseResultMap">
        select
        <include refid="BaseColumnList"/>
        from GRAYLIST
        where CARD_ID = #{cardId,jdbcType=VARCHAR}
    </select>

    <insert id="insert" parameterType="com.chinasofti.huateng.blacklist.entity.Graylist"
            useGeneratedKeys="true" keyProperty="id" keyColumn="ID">
        insert into GRAYLIST (
            CARD_ID, THIRD_USER_ID, CARD_TYPE, GRAY_SOURCE, BIZ_NO, REASON, CREATE_BY
        ) values (
            #{cardId,jdbcType=VARCHAR},
            #{thirdUserId,jdbcType=VARCHAR},
            #{cardType,jdbcType=VARCHAR},
            #{graySource,jdbcType=VARCHAR},
            #{bizNo,jdbcType=VARCHAR},
            #{reason,jdbcType=VARCHAR},
            #{createBy,jdbcType=VARCHAR}
        )
    </insert>

    <delete id="deleteByCardId">
        delete from GRAYLIST
        where CARD_ID = #{cardId,jdbcType=VARCHAR}
    </delete>

</mapper>
