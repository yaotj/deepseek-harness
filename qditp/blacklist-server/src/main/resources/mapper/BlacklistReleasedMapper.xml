<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinasofti.huateng.blacklist.mapper.BlacklistReleasedMapper">
    <resultMap id="BaseResultMap" type="com.chinasofti.huateng.blacklist.entity.BlacklistReleased">
        <id column="ID" jdbcType="NUMERIC" property="id"/>
        <result column="ORIGIN_ID" jdbcType="NUMERIC" property="originId"/>
        <result column="CARD_ID" jdbcType="VARCHAR" property="cardId"/>
        <result column="THIRD_USER_ID" jdbcType="VARCHAR" property="thirdUserId"/>
        <result column="CARD_TYPE" jdbcType="VARCHAR" property="cardType"/>
        <result column="CHANNEL_CODE" jdbcType="VARCHAR" property="channelCode"/>
        <result column="BLACK_SOURCE" jdbcType="VARCHAR" property="blackSource"/>
        <result column="BLACK_CAUSE" jdbcType="VARCHAR" property="blackCause"/>
        <result column="BIZ_NO" jdbcType="VARCHAR" property="bizNo"/>
        <result column="REASON" jdbcType="VARCHAR" property="reason"/>
        <result column="CREATE_BY" jdbcType="VARCHAR" property="createBy"/>
        <result column="CREATE_TIME" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="RELEASE_TIME" jdbcType="TIMESTAMP" property="releaseTime"/>
        <result column="RELEASE_REASON" jdbcType="VARCHAR" property="releaseReason"/>
        <result column="RELEASE_BY" jdbcType="VARCHAR" property="releaseBy"/>
        <result column="CHANNEL_SYNC_STATUS" jdbcType="VARCHAR" property="channelSyncStatus"/>
        <result column="CHANNEL_SYNC_TIME" jdbcType="TIMESTAMP" property="channelSyncTime"/>
        <result column="CHANNEL_SYNC_RETRY" jdbcType="NUMERIC" property="channelSyncRetry"/>
        <result column="CHANNEL_SYNC_FAIL_REASON" jdbcType="VARCHAR" property="channelSyncFailReason"/>
    </resultMap>

    <sql id="BaseColumnList">
        ID, ORIGIN_ID, CARD_ID, THIRD_USER_ID, CARD_TYPE, CHANNEL_CODE, BLACK_SOURCE, BLACK_CAUSE,
        BIZ_NO, REASON, CREATE_BY, CREATE_TIME, RELEASE_TIME, RELEASE_REASON, RELEASE_BY,
        CHANNEL_SYNC_STATUS, CHANNEL_SYNC_TIME, CHANNEL_SYNC_RETRY, CHANNEL_SYNC_FAIL_REASON
    </sql>

    <!-- 写入解除快照：与主表 DELETE 必须在同一个本地事务内。 -->
    <!-- useGeneratedKeys 取回 IDENTITY 主键：解黑通知的 outbox 要按 ID 回写状态，而本表 CARD_ID -->
    <!-- 没有唯一约束（同一张卡可反复拉黑又解除），拿不到 ID 就定位不到该回写哪一行。 -->
    <!-- ID 是 Oracle IDENTITY 列、库里没有对应序列，NEVER 改成 selectKey 取 nextval。 -->
    <insert id="insert" parameterType="com.chinasofti.huateng.blacklist.entity.BlacklistReleased"
            useGeneratedKeys="true" keyProperty="id" keyColumn="ID">
        insert into BLACKLIST_RELEASED (
            ORIGIN_ID, CARD_ID, THIRD_USER_ID, CARD_TYPE, CHANNEL_CODE, BLACK_SOURCE, BLACK_CAUSE,
            BIZ_NO, REASON, CREATE_BY, CREATE_TIME,
            RELEASE_TIME, RELEASE_REASON, RELEASE_BY, CHANNEL_SYNC_STATUS
        ) values (
            #{originId,jdbcType=NUMERIC},
            #{cardId,jdbcType=VARCHAR},
            #{thirdUserId,jdbcType=VARCHAR},
            #{cardType,jdbcType=VARCHAR},
            #{channelCode,jdbcType=VARCHAR},
            #{blackSource,jdbcType=VARCHAR},
            #{blackCause,jdbcType=VARCHAR},
            #{bizNo,jdbcType=VARCHAR},
            #{reason,jdbcType=VARCHAR},
            #{createBy,jdbcType=VARCHAR},
            #{createTime,jdbcType=TIMESTAMP},
            SYSTIMESTAMP,
            #{releaseReason,jdbcType=VARCHAR},
            #{releaseBy,jdbcType=VARCHAR},
            #{channelSyncStatus,jdbcType=VARCHAR}
        )
    </insert>

    <select id="selectByCardId" resultMap="BaseResultMap">
        select
        <include refid="BaseColumnList"/>
        from BLACKLIST_RELEASED
        where CARD_ID = #{cardId,jdbcType=VARCHAR}
        order by RELEASE_TIME desc, ID desc
    </select>

    <!-- 以下三个 outbox 语句自 2026-09-18 起不再使用：解除通知的载体已回到主表（STATUS='RELEASING'）， -->
    <!-- 补偿扫表走的是 BlacklistMapper.selectPendingReleaseSync，这张表的 CHANNEL_SYNC_* 四列 -->
    <!-- 降级为历史审计字段。保留 XML 片段会让 mapper 接口与 XML 不对齐（接口侧已删方法）。 -->
    <!-- NEVER 再据这三条做补偿扫表。 -->
</mapper>
