<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinasofti.huateng.blacklist.mapper.GraylistOperateLogMapper">

    <resultMap id="BaseResultMap" type="com.chinasofti.huateng.blacklist.entity.GraylistOperateLog">
        <id column="ID" jdbcType="NUMERIC" property="id"/>
        <result column="CARD_ID" jdbcType="VARCHAR" property="cardId"/>
        <result column="THIRD_USER_ID" jdbcType="VARCHAR" property="thirdUserId"/>
        <result column="OPERATE_TYPE" jdbcType="VARCHAR" property="operateType"/>
        <result column="OPERATOR" jdbcType="VARCHAR" property="operator"/>
        <result column="REASON" jdbcType="VARCHAR" property="reason"/>
        <result column="OPERATE_TIME" jdbcType="TIMESTAMP" property="operateTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.chinasofti.huateng.blacklist.entity.GraylistOperateLog">
        insert into GRAYLIST_OPERATE_LOG (
            CARD_ID, THIRD_USER_ID, OPERATE_TYPE, OPERATOR, REASON
        ) values (
            #{cardId,jdbcType=VARCHAR},
            #{thirdUserId,jdbcType=VARCHAR},
            #{operateType,jdbcType=VARCHAR},
            #{operator,jdbcType=VARCHAR},
            #{reason,jdbcType=VARCHAR}
        )
    </insert>

    <!-- 流水查询条件全部可选：where 标签打头（Druid WallFilter 口径同黑名单）。 -->
    <select id="selectPage" resultMap="BaseResultMap">
        select
        ID, CARD_ID, THIRD_USER_ID, OPERATE_TYPE, OPERATOR, REASON, OPERATE_TIME
        from GRAYLIST_OPERATE_LOG
        <where>
            <if test="cardId != null and cardId != ''">
                and CARD_ID = #{cardId,jdbcType=VARCHAR}
            </if>
            <if test="operateType != null and operateType != ''">
                and OPERATE_TYPE = #{operateType,jdbcType=VARCHAR}
            </if>
        </where>
        order by OPERATE_TIME desc, ID desc
    </select>

</mapper>
