<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinasofti.huateng.account.mapper.TerminationTimeSummaryMapper">
    <!-- SQL 正文禁写注释（行注释与块注释都不行）：Druid WallFilter 判为注入、语句静默失效；说明只放本 XML 注释里。 -->
    <resultMap id="BaseResultMap" type="com.chinasofti.huateng.account.page.TerminationTimeSummary">
        <result column="CARD_ID" jdbcType="VARCHAR" property="cardId"/>
        <result column="THIRD_USER_ID" jdbcType="VARCHAR" property="thirdUserId"/>
        <result column="REQUEST_TIME" jdbcType="TIMESTAMP" property="requestTime"/>
        <result column="COMPLETE_TIME" jdbcType="TIMESTAMP" property="completeTime"/>
    </resultMap>

    <select id="selectByCardIds" resultMap="BaseResultMap">
        select CARD_ID,
               THIRD_USER_ID,
               MAX(REQUEST_TIME) as REQUEST_TIME,
               MAX(case when TERMINATION_STATUS = 'SUCCESS' then COMPLETE_TIME else null end) as COMPLETE_TIME
        from APP_TERMINATION_REQUEST
        where CARD_ID in
        <foreach collection="cardIds" item="cardId" open="(" separator="," close=")">
            #{cardId,jdbcType=VARCHAR}
        </foreach>
        group by CARD_ID, THIRD_USER_ID
    </select>
</mapper>
