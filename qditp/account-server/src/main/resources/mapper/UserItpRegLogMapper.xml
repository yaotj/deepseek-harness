<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinasofti.huateng.account.mapper.UserItpRegLogMapper">
    <!-- SQL 正文禁写注释（行注释与块注释都不行）：Druid WallFilter 判为注入、语句静默失效；说明只放本 XML 注释里。 -->
    <resultMap id="BaseResultMap" type="com.chinasofti.huateng.account.entity.UserItpRegLog">
        <id column="ID" jdbcType="INTEGER" property="id"/>
        <result column="CARD_ID" jdbcType="VARCHAR" property="cardId"/>
        <result column="CARD_TYPE" jdbcType="VARCHAR" property="cardType"/>
        <result column="THIRD_USER_ID" jdbcType="VARCHAR" property="thirdUserId"/>
        <result column="MSISDN" jdbcType="VARCHAR" property="msisdn"/>
        <result column="OPER_DATE_TIME" jdbcType="TIMESTAMP" property="operDateTime"/>
        <result column="OPER_TYPE" jdbcType="INTEGER" property="operType"/>
    </resultMap>

    <insert id="insert" parameterType="com.chinasofti.huateng.account.entity.UserItpRegLog">
        insert into User_ITP_Reg_log (
            CARD_ID, CARD_TYPE, THIRD_USER_ID, MSISDN, OPER_DATE_TIME, OPER_TYPE
        ) values (
            #{cardId,jdbcType=VARCHAR},
            #{cardType,jdbcType=VARCHAR},
            #{thirdUserId,jdbcType=VARCHAR},
            #{msisdn,jdbcType=VARCHAR},
            #{operDateTime,jdbcType=TIMESTAMP},
            #{operType,jdbcType=INTEGER}
        )
    </insert>

    <!-- 综管台已注销用户查询：并列输入框 AND 组合。用 where 标签、OPER_TYPE 恒参与，
         避免「筛选条件全空时只剩恒真谓词」被 Druid 判为 select alway true condition。
         本表无签约流水号列，故没有 reqContractNo 谓词。 -->
    <select id="selectCancelLogByFilters" resultMap="BaseResultMap">
        select ID, CARD_ID, CARD_TYPE, THIRD_USER_ID, MSISDN, OPER_DATE_TIME, OPER_TYPE
        from User_ITP_Reg_log
        <where>
            <if test="msisdn != null">and MSISDN = #{msisdn,jdbcType=VARCHAR}</if>
            <if test="cardId != null">and CARD_ID = #{cardId,jdbcType=VARCHAR}</if>
            <if test="thirdUserId != null">and THIRD_USER_ID = #{thirdUserId,jdbcType=VARCHAR}</if>
            and OPER_TYPE = 2
        </where>
        order by OPER_DATE_TIME desc
    </select>
</mapper>
