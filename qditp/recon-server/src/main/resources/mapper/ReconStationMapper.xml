<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinasofti.huateng.recon.mapper.ReconStationMapper">
    <!-- SQL 正文禁写注释（Druid WallFilter）；本注释内 NEVER 出现两个连续减号 -->

    <!-- 全量取车站到线路的映射（维表基数几百行，全量拉回内存做 Map） -->
    <select id="selectStationLineCodes" resultType="java.util.Map">
        SELECT DISTINCT
            S.STATION_CODE AS STATION_CODE,
            S.LINE_CODE AS LINE_CODE
        FROM STATION_INFO S
        WHERE S.STATION_CODE IS NOT NULL
          AND S.LINE_CODE IS NOT NULL
    </select>
</mapper>
